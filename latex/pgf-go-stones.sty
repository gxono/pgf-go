%CON goban/captures (SOLO kernel = lua) EL KERNEL LLEVA LAS PIEDRAS DEL TABLERO. COMO PGF NO PUEDE
%BORRAR, LAS PIEDRAS NEGRAS Y BLANCAS Y LAS JUGADAS SE GUARDAN POR INTERSECCION Y SE DIBUJAN AL
%CERRAR EL goban (LAS CAPAS CONSERVAN EL ORDEN). UNA CAPTURA BORRA LA PIEDRA GUARDADA O, CON fade,
%LA MARCA PARA DIBUJARLA COMO PRISIONERO. LAS PIEDRAS NEUTRALES Y LOS PRISIONEROS NO CUENTAN.
\bool_new:N \l_pgfgo_goban_captures_bool
\bool_new:N \l_pgfgo_goban_captures_fade_bool
\bool_new:N \l__pgfgo_captures_fade_bool
\bool_new:N \l__pgfgo_stone_prisoner_bool

%"x,y" -> CODIGO QUE DIBUJA LO QUE HAY EN LA INTERSECCION.
\prop_new:N \g__pgfgo_captures_pending_prop
%"x,y" DE LAS PIEDRAS CAPTURADAS QUE SE DIBUJAN ATENUADAS.
\prop_new:N \g__pgfgo_captures_faded_prop
\tl_new:N \l__pgfgo_captures_key_tl
\cs_generate_variant:Nn \prop_gput:Nnn {NVn}
\cs_generate_variant:Nn \prop_gremove:Nn {NV}
\cs_generate_variant:Nn \prop_if_in:NnT {NVT}

\cs_new_protected:Npn \__pgfgo_captures_key:nn #1#2 {
	\tl_set:Ne \l__pgfgo_captures_key_tl {\int_eval:n {#1} , \int_eval:n {#2}}
}

\cs_new_protected:Npn \pgfgo_captures_begin: {
	\pgfgo_kernel_board_clear:
	\prop_gclear:N \g__pgfgo_captures_pending_prop
	\prop_gclear:N \g__pgfgo_captures_faded_prop
}

%GUARDA EL CODIGO #3 PARA LA INTERSECCION (#1,#2). REEMPLAZA LO QUE HABIA.
\cs_new_protected:Npn \__pgfgo_captures_defer:nnn #1#2#3 {
	\__pgfgo_captures_key:nn {#1} {#2}
	\prop_gput:NVn \g__pgfgo_captures_pending_prop \l__pgfgo_captures_key_tl {#3}
	\prop_gremove:NV \g__pgfgo_captures_faded_prop \l__pgfgo_captures_key_tl
}
\cs_generate_variant:Nn \__pgfgo_captures_defer:nnn {nne}

%APLICA LAS CAPTURAS DE LA ULTIMA JUGADA (\l_pgfgo_kernel_captured_seq).
\cs_new_protected:Npn \__pgfgo_captures_apply: {
	\seq_map_inline:Nn \l_pgfgo_kernel_captured_seq {
		\__pgfgo_captures_key:nn ##1
		\bool_if:NTF \l_pgfgo_goban_captures_fade_bool
			{
				\prop_if_in:NVT \g__pgfgo_captures_pending_prop \l__pgfgo_captures_key_tl
					{\prop_gput:NVn \g__pgfgo_captures_faded_prop \l__pgfgo_captures_key_tl {}}
			}
			{\prop_gremove:NV \g__pgfgo_captures_pending_prop \l__pgfgo_captures_key_tl}
	}
}

\cs_new_protected:Npn \__pgfgo_captures_stone:nnn #1#2#3 {
	\group_begin:
		\keys_set:nn { pgfgo / stone } {black}
		\keys_set_groups:nnn { pgfgo / stone } {player-id, captures-id} {#1}
		\bool_if:nTF {! \l_pgfgo_players_neutral_bool && ! \l__pgfgo_stone_prisoner_bool}
			{
				\exp_args:Ne \pgfgo_kernel_board_put:nnn
					{\bool_if:NTF \l_pgfgo_players_black_bool {black} {white}} {#2} {#3}
				\pgfgo_kernel_if_visible:nnT {#2} {#3}
					{\__pgfgo_captures_defer:nnn {#2} {#3} {\__pgfgo_stone_draw:nnn {#1} {#2} {#3}}}
			}
			{\pgfgo_kernel_if_visible:nnT {#2} {#3} {\__pgfgo_stone_draw:nnn {#1} {#2} {#3}}}
	\group_end:
}

%QUITA LA PIEDRA DE (#1,#2): DEL TABLERO DEL KERNEL Y DE LO QUE SE VA A DIBUJAR.
\cs_new_protected:Npn \pgfgo_captures_remove:nn #1#2 {
	\pgfgo_kernel_board_put:nnn {empty} {#1} {#2}
	\__pgfgo_captures_key:nn {#1} {#2}
	\prop_gremove:NV \g__pgfgo_captures_pending_prop \l__pgfgo_captures_key_tl
	\prop_gremove:NV \g__pgfgo_captures_faded_prop \l__pgfgo_captures_key_tl
}

%CON CAPTURAS, UNA JUGADA EN UN PUNTO OCUPADO ES UN ERROR DE LA PARTIDA (SIN CAPTURAS PUEDE SER BUSCADO).
\msg_new:nnn {pgfgo} {occupied-point}
	{Move~#1~is~played~on~#2,~which~is~not~empty.}
\cs_generate_variant:Nn \msg_warning:nnnn {nnee}

\cs_new_protected:Npn \__pgfgo_captures_move:nnnn #1#2#3#4 {
	\pgfgo_kernel_board_if_occupied:nnT {#3} {#4} {
		\msg_warning:nnee {pgfgo} {occupied-point}
			{\pgfgo_kernel_move_number:} {\pgfgo_kernel_column_name:n {#3} \int_eval:n {#4}}
	}
	\bool_if:NF \l__pgfgo_notes_noted_bool {
		\pgfgo_kernel_if_visible:nnT {#3} {#4} {
			\__pgfgo_captures_defer:nne {#3} {#4} {
				\exp_not:N \__pgfgo_move_draw:nnnnnn
					{\exp_not:n {#1}} {\exp_not:n {#2}} {\exp_not:n {#3}} {\exp_not:n {#4}}
					{\pgfgo_kernel_move_number:} {\pgfgo_kernel_move_if_black:TF {black} {white}}
			}
		}
	}
	\pgfgo_kernel_move_play:nn {#3} {#4}
	\__pgfgo_captures_apply:
	%UNA JUGADA ANOTADA ("N at M") DEJA VER LA PIEDRA M, AUNQUE HAYA SIDO CAPTURADA.
	\bool_if:NT \l__pgfgo_notes_noted_bool {\__pgfgo_notes_show_first:nn {#3} {#4}}
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%------------------------------------NOTAS "N at M"---------------------------------------------%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%CON goban/notes, UNA JUGADA NUMERADA N EN UN PUNTO DONDE YA HUBO UNA JUGADA NUMERADA M DEL MISMO goban
%NO SE DIBUJA: EL PUNTO SIGUE MOSTRANDO M Y SE ANOTA "N at M" (COMO EN LOS LIBROS: "7 at 3").
%\pgfgomovenotes IMPRIME LAS NOTAS DEL ULTIMO goban. SOLO CUENTAN LAS JUGADAS NUMERADAS Y VISIBLES.
\bool_new:N \l_pgfgo_goban_notes_bool
\bool_new:N \l__pgfgo_notes_noted_bool
%NOTAS DEL ULTIMO goban, {N}{M}.
\seq_new:N \g_pgfgo_move_notes_seq
%"x,y" -> NUMERO Y CODIGO DE LA PRIMERA JUGADA NUMERADA EN ESE PUNTO.
\prop_new:N \g__pgfgo_notes_number_prop
\prop_new:N \g__pgfgo_notes_code_prop
\tl_new:N \l__pgfgo_notes_tl
\tl_new:N \l_pgfgo_notes_at_tl
\tl_new:N \l_pgfgo_notes_separator_tl
\cs_generate_variant:Nn \prop_get:NnNTF {NV}
\cs_generate_variant:Nn \prop_get:NnNT {NV}
\cs_generate_variant:Nn \prop_gput:Nnn {NVe, NVV}

\cs_new_protected:Npn \pgfgo_notes_begin: {
	\seq_gclear:N \g_pgfgo_move_notes_seq
	\prop_gclear:N \g__pgfgo_notes_number_prop
	\prop_gclear:N \g__pgfgo_notes_code_prop
}

%(#1,#2) ESTA EN LA PARTE VISIBLE (SIN AVISAR SI ESTA FUERA DEL TABLERO).
\prg_new_conditional:Npnn \__pgfgo_notes_if_visible:nn #1#2 {p} {
	\bool_if:nTF {
		\int_compare_p:n {\l_pgfgo_goban_from_x_int <= #1 <= \l_pgfgo_goban_to_x_int} &&
		\int_compare_p:n {\l_pgfgo_goban_from_y_int <= #2 <= \l_pgfgo_goban_to_y_int}
	} {\prg_return_true:} {\prg_return_false:}
}

%ANTES DE JUGAR: DECIDE SI LA JUGADA (#1: NUMERADA, #2: OPCIONES, #3,#4: PUNTO) SE ANOTA EN VEZ DE
%DIBUJARSE (\l__pgfgo_notes_noted_bool), O LA REGISTRA COMO LA PRIMERA JUGADA NUMERADA DEL PUNTO.
\cs_new_protected:Npn \__pgfgo_notes_check:nnnn #1#2#3#4 {
	\bool_set_false:N \l__pgfgo_notes_noted_bool
	\bool_lazy_and:nnT {\l_pgfgo_goban_notes_bool} {\__pgfgo_notes_if_visible_p:nn {#3} {#4}} {
		\IfBooleanT {#1} {
			\__pgfgo_captures_key:nn {#3} {#4}
			\prop_get:NVNTF \g__pgfgo_notes_number_prop \l__pgfgo_captures_key_tl \l__pgfgo_notes_tl {
				\bool_set_true:N \l__pgfgo_notes_noted_bool
				\seq_gput_right:Ne \g_pgfgo_move_notes_seq
					{{\pgfgo_kernel_move_number:} {\exp_not:V \l__pgfgo_notes_tl}}
			}{
				\prop_gput:NVe \g__pgfgo_notes_number_prop \l__pgfgo_captures_key_tl
					{\pgfgo_kernel_move_number:}
				\prop_gput:NVe \g__pgfgo_notes_code_prop \l__pgfgo_captures_key_tl {
					\exp_not:N \__pgfgo_move_draw:nnnnnn
						{\exp_not:n {#1}} {\exp_not:n {#2}} {\exp_not:n {#3}} {\exp_not:n {#4}}
						{\pgfgo_kernel_move_number:} {\pgfgo_kernel_move_if_black:TF {black} {white}}
				}
			}
		}
	}
}

%CON CAPTURAS: VUELVE A DIBUJAR LA PRIMERA JUGADA NUMERADA DEL PUNTO.
\cs_new_protected:Npn \__pgfgo_notes_show_first:nn #1#2 {
	\__pgfgo_captures_key:nn {#1} {#2}
	\prop_get:NVNT \g__pgfgo_notes_code_prop \l__pgfgo_captures_key_tl \l__pgfgo_notes_tl {
		\prop_gput:NVV \g__pgfgo_captures_pending_prop \l__pgfgo_captures_key_tl \l__pgfgo_notes_tl
		\prop_gremove:NV \g__pgfgo_captures_faded_prop \l__pgfgo_captures_key_tl
	}
}

\keys_define:nn {pgfgo / notes} {
	at					.tl_set:N		= \l_pgfgo_notes_at_tl,
	at					.initial:n	= {at},
	separator		.tl_set:N		= \l_pgfgo_notes_separator_tl,
	separator		.initial:n	= {,~},
}
\keys_define:nn {pgfgo} {
	notes				.code:n			= {\keys_set:nn {pgfgo / notes} {#1}}
}

\NewDocumentCommand \pgfgomovenotes {O{}} {
	\group_begin:
		\keys_set:nn {pgfgo / notes} {#1}
		\seq_clear:N \l_tmpa_seq
		\seq_map_inline:Nn \g_pgfgo_move_notes_seq {
			\seq_put_right:Nn \l_tmpa_seq {\use_i:nn ##1 \nobreakspace \l_pgfgo_notes_at_tl \nobreakspace \use_ii:nn ##1}
		}
		\seq_use:Nn \l_tmpa_seq {\l_pgfgo_notes_separator_tl}
	\group_end:
}

%DIBUJA LO QUE QUEDO, AL CERRAR EL goban.
\cs_new_protected:Npn \pgfgo_captures_end: {
	\prop_map_inline:Nn \g__pgfgo_captures_pending_prop {
		\group_begin:
			\prop_if_in:NnT \g__pgfgo_captures_faded_prop {##1}
				{\bool_set_true:N \l__pgfgo_captures_fade_bool}
			##2
		\group_end:
	}
}

\cs_new:Nn \pgfgo_stone:nn {\pgfgo_stone:nnn{#1}#2}
\cs_generate_variant:Nn\pgfgo_stone:nn {nV}
\cs_generate_variant:Nn\pgfgo_stone:nn {nf}



\DeclareDocumentCommand{\stone}{O{}m}{
	\group_begin:
	\keys_set_groups:nnn{ pgfgo / stone }{ preset }{#1}
	\pgfgo_kernel_point:nTF {#2} { %Devuelve \l_pgfgo_kernel_point_tl
		%\stone SIN JUGADOR DIBUJA UNA PIEDRA NEUTRAL (\stones, EN CAMBIO, UNA NEGRA).
		%RECORDAR LAS PIEDAS
		\bool_if:NT \l_pgfgo_goban_remember_stone_bool {
			\pgfgo_kernel_remember_push:n {
				\exp_not:N\pgfgo_stone:nn{neutral, \exp_not:n{#1}}{\exp_not:V \l_pgfgo_kernel_point_tl}}
		}

		\pgfgo_stone:nV{neutral, #1}\l_pgfgo_kernel_point_tl
	}{
		\msg_warning:nnn {pgfgo} {unknown-coordinate} {#2}
	}
	\group_end:
}

