%-------------------------------------------MOVES-----------------------------------------------%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%



%VUELVE A DIBUJAR JUGADAS RECORDADAS. #2 TRAE LAS OPCIONES ORIGINALES MAS from Y EL COLOR CON QUE EMPEZARON.
\cs_new_protected:Nn \pgfgo_move_parsed:nnn {
	\group_begin:
	\keys_set_groups:nnn { pgfgo / move} {player-id, first stone} {#2}
	\keys_set_groups:nnn { pgfgo / players / neutral / move} { label } {#2}
	\clist_map_inline:nn {#3} {\pgfgo_move:nnn{#1}{#2}{##1}}
	\group_end:
}





\NewDocumentCommand{\moves}{sO{}m}{
	\group_begin:
	\pgfgo_coordinate_parser_from_pgfgonce_to_items:n{#3} %Devuelve \l_pgfgo_coordinate_parser_items_from_group_seq

	\keys_set_groups:nnn { pgfgo / move} {preset, player-id, first stone} {#2}
	\keys_set_groups:nnn { pgfgo / players / neutral / move} { label } {#2}
	%RECORDAR LAS PIEDAS (CON EL NUMERO Y EL COLOR DE LA PRIMERA JUGADA)
	\clist_set_from_seq:NN \l_tmpa_clist\l_pgfgo_coordinate_parser_items_from_pgfgonce_seq
	\bool_if:NT \l_pgfgo_goban_remember_move_bool {
		\pgfgo_goban_remember_push:n {
			\exp_not:N\pgfgo_move_parsed:nnn
				{\bool_if:NTF \l_pgfgo_goban_remember_move_label_bool {\exp_not:N \BooleanTrue} {\exp_not:N \BooleanFalse}}
				{
					\exp_not:n{#2},
					from = \int_use:N\g_pgfgo_move_current_int,
					\bool_if:NTF \g_pgfgo_move_black_turn_bool {black} {white}
				}
				{\exp_not:V\l_tmpa_clist}
		}
	}

	%-------------------------------------------------------------------------


	\seq_map_variable:NNn \l_pgfgo_coordinate_parser_items_from_pgfgonce_seq\l__pgfgo_item_tl{
		%PIEDRAS RESTANTES
		\pgfgo_move:nnV {#1}{#2}\l__pgfgo_item_tl
	}
	\group_end:
}

\let\move\moves

\ExplSyntaxOff
