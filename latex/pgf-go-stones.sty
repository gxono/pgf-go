	}

	\seq_map_variable:NNn \l_pgfgo_kernel_points_seq\l__pgfgo_item_tl {
		%DIBUJAR LAS PIEDRAS
		\pgfgo_stone:nV{#1}\l__pgfgo_item_tl
	}
	\group_end:
}

