%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%-------------------------------------------MOVE------------------------------------------------%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


\tl_new:N \l_pgfgo_move_x_tl
\tl_new:N \l_pgfgo_move_y_tl

%FUERA DE LA PARTE VISIBLE NO SE DIBUJA, PERO LA JUGADA CUENTA (NUMERO Y TURNO).
\cs_set_protected:Npn\pgfgo_move:nnnn #1#2#3#4 {
	\__pgfgo_notes_check:nnnn {#1} {#2} {#3} {#4}
	\bool_if:NTF \l_pgfgo_goban_captures_bool {
		\__pgfgo_captures_move:nnnn {#1} {#2} {#3} {#4}
	}{
		%UNA JUGADA ANOTADA ("N at M") NO SE DIBUJA.
		\bool_if:NF \l__pgfgo_notes_noted_bool {
			\pgfgo_kernel_if_visible:nnT {#3} {#4} {
				\__pgfgo_move_draw:nnnnee {#1} {#2} {#3} {#4}
					{\pgfgo_kernel_move_number:} {\pgfgo_kernel_move_if_black:TF {black} {white}}
			}
		}
		\pgfgo_kernel_move_play:nn {#3} {#4}
	}
}

%DIBUJA LA JUGADA NUMERO #5 DE #6 (black O white) EN (#3,#4). #1: MOSTRAR EL NUMERO. #2: OPCIONES.
\cs_new_protected:Npn\__pgfgo_move_draw:nnnnnn #1#2#3#4#5#6 {
	\group_begin:
	\tl_set:Nn\l_pgfgo_move_x_tl{#3}
	\tl_set:Nn\l_pgfgo_move_y_tl{#4}

	\keys_set:nn { pgfgo / stone }{#6}
	\keys_set_exclude_groups:nnn {pgfgo / players / #6 / move} {external} {#2}
	\pgfgo_get_variables_from_current_player:
	\__pgfgo_stone_draw:nnn{#6}{#3}{#4}

	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
	%----------------------LABEL-----------------------%
	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


	\tl_set:Ne \l_tmpb_tl {\pgfgo_players_move_label_format:n{#5}}
	\tl_set:Nn\l_tmpa_tl{0.45em}
	%Ajustar el tamano de acuerdo a la cantidad de caracteres <--------
	\regex_count:nVN{[a-zA-Z\d]}\l_tmpb_tl\l_tmpa_int
	\int_case:nn{\l_tmpa_int}{
		{1}{\tl_set:Nn\l_tmpa_tl{1em}}
		{2}{\tl_set:Nn\l_tmpa_tl{0.65em}}
		{3}{\tl_set:Nn\l_tmpa_tl{0.45em}}
	}
	%------------------------------------------------------------------

	%label/font size FIJA EL TAMANO
	\tl_if_empty:NF \l_pgfgo_players_move_label_font_size_tl
		{\tl_set_eq:NN \l_tmpa_tl \l_pgfgo_players_move_label_font_size_tl}

	\IfBooleanT{#1}{
		\pgfscope
		%TOMA EL COLOR CALCULADO ARRIBA
		\pgfsetcolor{\l_pgfgo_players_move_label_color_tl}
		\pgftext[at=\pgfpointxy{\l_pgfgo_move_x_tl}{\l_pgfgo_move_y_tl}]{
			\bfseries\fontsize{ \l_tmpa_tl }{0pt}\selectfont
			\pgfgo_players_move_label_format:n{#5}
		}
		\pgfusepath{stroke}
		\endpgfscope
	}

	\group_end:
}
\cs_generate_variant:Nn \__pgfgo_move_draw:nnnnnn {nnnnee}


\cs_new:Nn\pgfgo_move:nnn{\pgfgo_move:nnnn{#1}{#2}#3}
