\cs_new_protected:Nn \pgfgo_stones_parsed:nn {
	\clist_map_inline:nn {#2} {\pgfgo_stone:nn{#1}{##1}}
}








\cs_set_protected:Npn\pgfgo_stones:nn #1#2 {
	\group_begin:

	\pgfgo_coordinate_parser_from_pgfgonce_to_items:n{#2} %Devuelve \l_pgfgo_coordinate_parser_items_from_pgfgonce_seq

	\keys_set_groups:nnn{ pgfgo / stone }{ preset }{#1}
	%RECORDAR LAS PIEDAS
	\clist_set_from_seq:NN \l_tmpa_clist\l_pgfgo_coordinate_parser_items_from_pgfgonce_seq
	\bool_if:NT \l_pgfgo_goban_remember_stone_bool {
		\pgfgo_goban_remember_push:n {\exp_not:N\pgfgo_stones_parsed:nn{\exp_not:n{#1}}{\exp_not:V\l_tmpa_clist}}
	}

	\seq_map_variable:NNn \l_pgfgo_coordinate_parser_items_from_pgfgonce_seq\l__pgfgo_item_tl {
		%DIBUJAR LAS PIEDRAS
		\pgfgo_stone:nV{#1}\l__pgfgo_item_tl
	}
	\group_end:
}

