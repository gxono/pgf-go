\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{pgf-go}[2026/10/13 v0.2026.10.13 Go diagrams with PGF]

\RequirePackage{tikz}
\usetikzlibrary{patterns, arrows.meta}
\RequirePackage{xparse}

\definecolor{pgfgo}{RGB}{220,179,92}

\ExplSyntaxOn

\cs_new_protected:Npn \pgfgo_set:n #1 {\keys_set:nn {pgfgo} {#1}}
\cs_generate_variant:Nn \pgfgo_set:n {e}
\let\pgfgoset\pgfgo_set:n

\NewDocumentCommand{\pgfgosetallplayers}{m}{\keys_set:nn {pgfgo / players}{all = {#1}}}

%LOS MODULOS SE BUSCAN EN LA MISMA CARPETA QUE pgf-go.sty (POR EJ. \usepackage{../../latex/pgf-go}).
%SI NO ESTAN AHI, SE BUSCAN EN EL PATH DE TEX.
\tl_const:Ne \c__pgfgo_path_tl {\CurrentFilePath}

\cs_new_protected:Npn \__pgfgo_load_module:n #1 {
	\tl_if_empty:NTF \c__pgfgo_path_tl
		{\file_input:n {#1 .sty}}
		{
			\file_if_exist:nTF {\c__pgfgo_path_tl / #1 .sty}
				{\file_input:n {\c__pgfgo_path_tl / #1 .sty}}
				{\file_input:n {#1 .sty}}
		}
	\ExplSyntaxOn
}
\cs_generate_variant:Nn \__pgfgo_load_module:n {e}

%EJECUTA #2 SI EL MODULO #1 NO ESTA NI JUNTO A pgf-go.sty NI EN EL PATH DE TEX.
\cs_new_protected:Npn \__pgfgo_module_if_exist:nF #1#2 {
	\file_if_exist:nF {#1 .sty} {
		\tl_if_empty:NTF \c__pgfgo_path_tl
			{#2}
			{\file_if_exist:nF {\c__pgfgo_path_tl / #1 .sty} {#2}}
	}
}

%KERNEL DE CALCULO: \usepackage[kernel = expl3 | lua]{pgf-go}. VER pgf-go-kernel.sty.
%POR DEFECTO, lua CON LuaLaTeX Y expl3 CON LOS DEMAS MOTORES.
\tl_new:N \g_pgfgo_kernel_tl
%IDIOMA DE LOS TEXTOS: \usepackage[lang = es]{pgf-go}. VER pgf-go-lang.sty.
\tl_new:N \g__pgfgo_lang_option_tl
\keys_define:nn {pgfgo / package} {
	kernel		.choices:nn = {expl3, lua} {\tl_gset_eq:NN \g_pgfgo_kernel_tl \l_keys_choice_tl},
	lang			.tl_gset:N	= \g__pgfgo_lang_option_tl,
}
\sys_if_engine_luatex:TF
	{\tl_gset:Nn \g_pgfgo_kernel_tl {lua}}
	{\tl_gset:Nn \g_pgfgo_kernel_tl {expl3}}
\IfFormatAtLeastTF {2022-06-01}
	{\ProcessKeyOptions [pgfgo / package]}
	{\RequirePackage{l3keys2e}\ProcessKeysOptions{pgfgo / package}}

%VARIABLES DE LOS RECORRIDOS (MAP/STEP) QUE USAN LOS MODULOS.
\tl_new:N \l__pgfgo_item_tl
\tl_new:N \l__pgfgo_letter_tl
\tl_new:N \l__pgfgo_number_tl
\tl_new:N \l__pgfgo_element_tl
\tl_new:N \l__pgfgo_subset_tl

%VARIANTE QUE USAN LOS MODULOS (LOS l3kernel RECIENTES YA LA TIENEN).
\prg_generate_conditional_variant:Nnn \regex_match:nn {nV} {T, F, TF}

\clist_map_inline:nn {
	pgf-go-kernel, pgf-go-lang, pgf-go-remember, pgf-go-images, pgf-go-profiles, pgf-go-players, pgf-go-stones,
	pgf-go-goban, pgf-go-marks, pgf-go-lines, pgf-go-territory, pgf-go-layout, pgf-go-sgf
} {\__pgfgo_load_module:n {#1}}

\keys_define:nn {pgfgo}{
	goban				.code:n			= {\keys_set:nn {pgfgo / goban} {#1}},
	stone				.code:n			= {\keys_set:nn {pgfgo / players} {all = {stone = {#1}}}},
	move				.code:n			= {\keys_set:nn {pgfgo / players} {all = {move = {#1}}}},
	mark				.code:n			= {\keys_set:nn {pgfgo / mark} {#1}},
	territory		.code:n			= {\keys_set:nn {pgfgo / territory} {#1}},
	players			.code:n			= {\keys_set:nn {pgfgo / players} {#1}},
	use~i				.bool_set:N	= \l_pgfgo_use_i_bool,
	use~i				.default:n	= {true},
}

\ExplSyntaxOff

\pgfgouseprofile{default}
