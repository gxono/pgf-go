	%EL TEXTO DE LA COORDENADA DE LA COLUMNA O LA FILA #1.
	\cs_new:Npn \__pgfgo_goban_column_label:n #1 {
		\__pgfgo_goban_label_text:Vn \l_pgfgo_goban_label_columns_tl {
			\str_if_eq:VnTF \l_pgfgo_goban_label_columns_from_tl {right}
