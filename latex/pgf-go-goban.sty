				{\l_pgfgo_goban_size_y_int - (#1) + 1} {#1}
		}
	}
	\cs_new:Npn \__pgfgo_goban_label_text:nn #1#2 {
		\str_case:nn {#1} {
			{letters}	{\pgfgo_kernel_column_name:n {#2}}
			{numbers}	{\int_eval:n {#2}}
			{kanji}		{\__pgfgo_goban_kanji:e {\int_eval:n {#2}}}
		}
	}
	\cs_generate_variant:Nn \__pgfgo_goban_label_text:nn {V}

	%NUMEROS EN KANJI: 1 A 9, Y DESPUES 十 (10), 十一 (11), 二十 (20), ... NECESITAN UNA FUENTE QUE LOS TENGA.
	\tl_const:Nn \c__pgfgo_goban_kanji_tl {{一}{二}{三}{四}{五}{六}{七}{八}{九}{十}}
	\cs_new:Npn \__pgfgo_goban_kanji:n #1 {
		\int_compare:nNnT {\int_div_truncate:nn {#1} {10}} > {1}
			{\tl_item:Nn \c__pgfgo_goban_kanji_tl {\int_div_truncate:nn {#1} {10}}}
		\int_compare:nNnT {\int_div_truncate:nn {#1} {10}} > {0}
			{\tl_item:Nn \c__pgfgo_goban_kanji_tl {10}}
		\int_compare:nNnT {\int_mod:nn {#1} {10}} > {0}
			{\tl_item:Nn \c__pgfgo_goban_kanji_tl {\int_mod:nn {#1} {10}}}
	}
	\cs_generate_variant:Nn \__pgfgo_goban_kanji:n {e}

