	\keys_define:nn {pgfgo / goban}{
		%EMPIEZA UNA MEMORIA NUEVA Y RECUERDA TODO LO QUE SE DIBUJE.
		new~remember					.code:n			= {
																			\pgfgo_kernel_remember_clear:
																			\bool_set_true:N\l_pgfgo_goban_remember_new_bool
																			\bool_set_true:N\l_pgfgo_goban_remember_add_bool
																			\pgfgo_goban_remember_all:
																		},

		%AGREGA A LA MEMORIA EXISTENTE.
		remember				.code:n			= {
																			\bool_set_false:N\l_pgfgo_goban_remember_new_bool
																			\bool_set_true:N\l_pgfgo_goban_remember_add_bool
																			\pgfgo_goban_remember_all:
																		},

		add~to~remember	.code:n			= {\keys_set:nn {pgfgo / goban} {remember}},

		%BORRA LA MEMORIA Y NO RECUERDA NADA (SALVO LO MARCADO CON remember).
		forget								.code:n			= {
																			\pgfgo_kernel_remember_clear:
																			\bool_set_false:N\l_pgfgo_goban_remember_new_bool
																			\bool_set_false:N\l_pgfgo_goban_remember_add_bool
																			\pgfgo_goban_remember_nothing:
																		},

		resume						.code:n			= {\bool_set_true:N\l_pgfgo_goban_resume_bool},

		%LAS PIEDRAS CAPTURADAS DESAPARECEN (remove) O QUEDAN COMO PRISIONEROS (fade). SOLO CON kernel = lua.
		captures					.choices:nn = {true, remove, fade, false} {
																			\str_if_eq:VnTF \l_keys_choice_tl {false}
																				{\bool_set_false:N \l_pgfgo_goban_captures_bool}
																				{
																					\pgfgo_kernel_if_feature:nTF {captures} {
																						\bool_set_true:N \l_pgfgo_goban_captures_bool
																						\bool_set:Nn \l_pgfgo_goban_captures_fade_bool
																							{\str_if_eq_p:Vn \l_keys_choice_tl {fade}}
																					}{
																						\pgfgo_kernel_require:n {captures}
																					}
																				}
																			},
		captures					.default:n	= {remove},

		grid							.code:n 		= {\keys_set:nx{pgfgo / goban / grid}		{#1}},

		border						.code:n 		= {\keys_set:nx{pgfgo / goban / border} {#1}}, %DEPRECATED
		
		background						.code:n 		= {\keys_set:nx{pgfgo / goban / background} {#1}},

		label							.code:n 		= {\keys_set:nn{pgfgo / goban / label} {#1}},

		partial						.code:n 		= {	\bool_set_true:N\l_pgfgo_goban_partial_bool
																			\keys_set:nx{pgfgo / goban / partial} {#1}},

		scale							.tl_set:N		= \l_pgfgo_goban_scale_tl,
		scale							.initial:n	= {1},

		size							.code:n			= {\pgfgo_kernel_board_size:n{#1}},

		use~i					.bool_set:N = \l_pgfgo_use_i_bool,

		use~i					.default:n	= {true},

		unknown						.code:n			= {\pgfgo_kernel_board_size:V\l_keys_key_str},%INTERNTA PARSEAR EL SIZE
		}

