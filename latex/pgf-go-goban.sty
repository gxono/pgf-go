	\cs_generate_variant:Nn \__pgfgo_goban:nnn {nVV}

	%LA VISTA DE LAS JUGADAS \l_pgfgo_goban_sgf_view_from_int A \l_pgfgo_goban_sgf_view_to_int (LAS DOS 0
	%SI NO SE DICE OTRA COSA) DE LA LINEA \l_pgfgo_goban_sgf_view_variation_tl (\sgfdiagrams Y \sgfanimation
	%LAS FIJAN). SI UNA VISTA ANTERIOR DEL MISMO goban LIMITO EL TABLERO Y ESTA NO, SE VUELVE A VER TODO.
	\tl_new:N \l__pgfgo_goban_sgf_view_file_tl
	\int_new:N \l_pgfgo_goban_sgf_view_from_int
	\int_new:N \l_pgfgo_goban_sgf_view_to_int
	\tl_new:N \l_pgfgo_goban_sgf_view_variation_tl
	\bool_new:N \l__pgfgo_goban_sgf_view_bool
	\cs_new_protected:Npn \__pgfgo_goban_sgf_view: {
		\pgfgo_kernel_if_feature:nTF {sgf} {
			\exp_args:NVV \pgfgo_kernel_sgf_read:nn
				\l__pgfgo_goban_sgf_view_file_tl \l_pgfgo_goban_sgf_view_variation_tl
			\int_set_eq:NN \l_pgfgo_goban_size_x_int \l_pgfgo_kernel_sgf_size_x_int
			\int_set_eq:NN \l_pgfgo_goban_size_y_int \l_pgfgo_kernel_sgf_size_y_int
			\pgfgo_kernel_sgf_view:nn {\l_pgfgo_goban_sgf_view_from_int} {\l_pgfgo_goban_sgf_view_to_int}
			\tl_if_empty:NTF \l_pgfgo_kernel_sgf_view_tl {
				\bool_if:NT \l__pgfgo_goban_sgf_view_bool {
					\bool_set_false:N \l_pgfgo_goban_partial_bool
					\bool_set_false:N \l__pgfgo_goban_sgf_view_bool
				}
			}{
				\bool_set_true:N \l_pgfgo_goban_partial_bool
				\bool_set_true:N \l__pgfgo_goban_sgf_view_bool
				\exp_after:wN \__pgfgo_goban_sgf_view:nnnn \l_pgfgo_kernel_sgf_view_tl
			}
		}{
			\pgfgo_kernel_require:n {sgf}
		}
	}

	\cs_new_protected:Npn \__pgfgo_goban_sgf_view:nnnn #1#2#3#4 {
		\pgfgo_kernel_board_window:e
			{\pgfgo_kernel_column_name:n {#1} #2 ~ to ~ \pgfgo_kernel_column_name:n {#3} #4}
	}
	\cs_generate_variant:Nn \pgfgo_kernel_board_window:n {e}
	\cs_generate_variant:Nn \pgfgo_kernel_points:n {V}

	\cs_new_protected:Npn \__pgfgo_goban_hoshi_image:nn #1#2 {
		\bool_lazy_and:nnT
			{\int_compare_p:n {\l_pgfgo_goban_from_x_int <= #1 <= \l_pgfgo_goban_to_x_int}}
			{\int_compare_p:n {\l_pgfgo_goban_from_y_int <= #2 <= \l_pgfgo_goban_to_y_int}}
			{\pgfgo_image_draw:n {\pgfpointxy{#1}{#2}}}
	}

	\cs_new_protected:Npn \__pgfgo_goban_hoshi:nn #1#2 {
		\bool_lazy_and:nnT
			{\int_compare_p:n {\l_pgfgo_goban_from_x_int <= #1 <= \l_pgfgo_goban_to_x_int}}
			{\int_compare_p:n {\l_pgfgo_goban_from_y_int <= #2 <= \l_pgfgo_goban_to_y_int}}
			{\pgfpathcircle {\pgfpointxy{#1}{#2}} {\l_pgfgo_goban_hoshi_radius_dim}}
	}



	%PARA LAS ANIMACIONES POR CAPAS (VER pgf-go-sgf.sty): \l_pgfgo_goban_layers_clist ELIGE LAS CAPAS QUE
	%SE DIBUJAN (VACIA: TODAS), Y \l_pgfgo_goban_bbox_tl FIJA EL TAMANO ({minx}{miny}{maxx}{maxy}). AL
	%TERMINAR, EL TAMANO DEL ULTIMO goban QUEDA EN \g_pgfgo_goban_bbox_tl.
	\clist_new:N \l_pgfgo_goban_layers_clist
	\clist_const:Nn \c__pgfgo_goban_layers_clist {
		pgfgo_layer_goban_border, pgfgo_layer_goban_grid, pgfgo_layer_goban_labels, pgfgo_layer_territory,
		pgfgo_layer_mark_shadow, pgfgo_layer_stone, pgfgo_layer_stone_mark, pgfgo_layer_mark
	}
	\tl_new:N \l_pgfgo_goban_bbox_tl
	\tl_new:N \g_pgfgo_goban_bbox_tl

	\cs_new_protected:Npn \__pgfgo_goban_set_bbox:nnnn #1#2#3#4 {
		\dim_gset:cn {pgf@picminx} {#1}
		\dim_gset:cn {pgf@picminy} {#2}
		\dim_gset:cn {pgf@picmaxx} {#3}
		\dim_gset:cn {pgf@picmaxy} {#4}
	}

	\cs_new:Npn\__end_pgfgo_goban: {
		\bool_if:NT \l_pgfgo_goban_captures_bool {\pgfgo_captures_end:}
		\pgfgo_territory_end:
		\tl_if_empty:NF \l_pgfgo_goban_bbox_tl
			{\exp_after:wN \__pgfgo_goban_set_bbox:nnnn \l_pgfgo_goban_bbox_tl}
		\tl_gset:Ne \g_pgfgo_goban_bbox_tl {
			{\dim_use:c {pgf@picminx}} {\dim_use:c {pgf@picminy}}
			{\dim_use:c {pgf@picmaxx}} {\dim_use:c {pgf@picmaxy}}
		}
		%PGF NO VACIA LAS CAPAS QUE NO DIBUJA: LO QUE TIENEN PASARIA AL PROXIMO DIBUJO.
		\clist_if_empty:NF \l_pgfgo_goban_layers_clist {
			\tl_set:ce {pgf@layerlist} {\clist_use:Nn \l_pgfgo_goban_layers_clist {,}}
			\clist_map_inline:Nn \c__pgfgo_goban_layers_clist {
				\clist_if_in:NnF \l_pgfgo_goban_layers_clist {##1}
					{\box_gclear:c {pgf@layerbox@##1}}
			}
		}
		\endtikzpicture
		\group_end:
	}



