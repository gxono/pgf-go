	}

	%LO QUE TRAE resume SE COPIA A UNA MEMORIA NUEVA ANTES DE QUE name VACIE LA SUYA (name Y resume PUEDEN
	%SER EL MISMO goban), Y NO CAMBIA AUNQUE OTRO goban VUELVA A USAR ESE NOMBRE.
	\tl_new:N \l__pgfgo_goban_resume_memory_tl
	\tl_new:N \l__pgfgo_goban_resume_captures_tl
	\int_new:N \g__pgfgo_goban_resume_int
	\cs_new_protected:Npn \__pgfgo_goban_resume: {
		\prop_get:NVNTF \g__pgfgo_goban_names_captures_prop \l_pgfgo_goban_resume_tl \l__pgfgo_goban_resume_captures_tl {
			\int_gincr:N \g__pgfgo_goban_resume_int
			\tl_set:Ne \l__pgfgo_goban_resume_memory_tl {pgfgo/resume/\int_use:N \g__pgfgo_goban_resume_int}
			\pgfgo_kernel_remember_clear:V \l__pgfgo_goban_resume_memory_tl
			\pgfgo_kernel_remember_append:VV \l__pgfgo_goban_resume_memory_tl \l_pgfgo_goban_resume_tl
			\bool_if:NF \l_pgfgo_goban_captures_bool
				{\keys_set:nV {pgfgo / goban} \l__pgfgo_goban_resume_captures_tl}
		}{
			\msg_error:nnV {pgfgo} {unknown-view} \l_pgfgo_goban_resume_tl
		}
	}
	%EL CODIGO QUE DIBUJA LO QUE TRAE resume. PARA UNA EXPANSION e.
	\cs_new:Npn \__pgfgo_goban_resume_code: {
		\exp_not:N \pgfgo_remember_resume:NNNn
			\__pgfgo_goban_resume_bool:N \l__pgfgo_goban_resume_marks_bool
			\__pgfgo_goban_resume_bool:N \l__pgfgo_goban_resume_territory_bool
			\__pgfgo_goban_resume_bool:N \l__pgfgo_goban_resume_numbers_bool
			{\exp_not:V \l__pgfgo_goban_resume_memory_tl}
	}
	\cs_new:Npn \__pgfgo_goban_resume_bool:N #1 {\bool_if:NTF #1 {\exp_not:N \c_true_bool} {\exp_not:N \c_false_bool}}

	%/pgfgo/view: QUE SE DEJA DE DIBUJAR (marks, numbers, territory = false), SI SE DIBUJA LO OLVIDADO
	%(forgotten), A QUE ALTURA (raise) Y LAS OPCIONES DE goban DE LAS VISTAS, QUE VAN DESPUES DE LAS DEL
	%goban CON NOMBRE.
	\bool_new:N \l__pgfgo_view_marks_bool
	\bool_new:N \l__pgfgo_view_numbers_bool
	\bool_new:N \l__pgfgo_view_territory_bool
	\bool_new:N \l__pgfgo_view_forgotten_bool
	\tl_new:N \l_pgfgo_goban_view_raise_tl
	\dim_new:N \l__pgfgo_goban_view_raise_dim
	\tl_new:N \l__pgfgo_view_goban_tl
	\tl_new:N \l__pgfgo_view_profile_tl
	\keys_define:nn {pgfgo / view} {
		marks							.bool_set:N	= \l__pgfgo_view_marks_bool,
		marks							.default:n	= {true},
		marks							.initial:n	= {true},
		numbers						.bool_set:N	= \l__pgfgo_view_numbers_bool,
		numbers						.default:n	= {true},
		numbers						.initial:n	= {true},
		territory					.bool_set:N	= \l__pgfgo_view_territory_bool,
		territory					.default:n	= {true},
		territory					.initial:n	= {true},
		forgotten					.bool_set:N	= \l__pgfgo_view_forgotten_bool,
		forgotten					.default:n	= {true},
		forgotten					.initial:n	= {false},
		raise							.tl_set:N		= \l_pgfgo_goban_view_raise_tl,
		raise							.initial:n	= {0.5ex},
		%EL PERFIL DE LAS VISTAS (false: EL ESTILO DEL ORIGINAL). VA ANTES DE LAS DEMAS OPCIONES DE LA VISTA.
		profile						.code:n			= {
																			\str_if_eq:nnTF {#1} {false}
																				{\tl_clear:N \l__pgfgo_view_profile_tl}
																				{\tl_set:Nn \l__pgfgo_view_profile_tl {#1}}
																		},
		unknown						.code:n			= {
																			\tl_put_right:Ne \l__pgfgo_view_goban_tl
																				{, \l_keys_key_str \tl_if_empty:nF {#1} {= {\exp_not:n {#1}}}}
																		},
	}
	\keys_set:nn {pgfgo / view} {scale = 0.8}

	%LA PARTE DEL TABLERO DE LA VISTA: UN PUNTO (B3) O UN RECTANGULO, COMO EN partial.
	\str_new:N \l__pgfgo_view_range_str
	\cs_new_protected:Npn \__pgfgo_view_range:n #1 {
