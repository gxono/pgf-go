	\NewDocumentEnvironment{goban}{O{}}{
		%\mark Y \marks SOLO EXISTEN DENTRO DEL TABLERO (AFUERA SON LAS PRIMITIVAS DE TEX).
		\cs_set_eq:NN \mark \__pgfgo_marks_command
		\cs_set_eq:NN \marks \__pgfgo_marks_command
		\cs_set_eq:NN \arrow \__pgfgo_arrow_command
		\cs_set_eq:NN \line \__pgfgo_line_command
		\cs_set_eq:NN \sgf \__pgfgo_sgf_command
		%CADA TABLERO EMPIEZA EN LA JUGADA 1 CON NEGRAS (resume RESTAURA LAS JUGADAS RECORDADAS).
		\pgfgo_kernel_move_reset:
		\pgfgo_notes_begin:
		\pgfgo_points_begin:
		\pgfgo_territory_begin:
