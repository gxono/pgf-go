	}

	\keys_define:nn {pgfgo / goban / background}{
		false										.code:n = {\bool_set_false:N \l_pgfgo_goban_border_bool},
		true										.code:n = {\bool_set_true:N \l_pgfgo_goban_border_bool},

		sep											.dim_set:N 	= \l_pgfgo_goban_border_sep_dim,
