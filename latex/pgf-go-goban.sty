%IMAGEN DE FONDO, SOBRE EL COLOR. SE UBICA SEGUN EL TABLERO COMPLETO (CON partial SE VE LA PARTE QUE
%CORRESPONDE). stretch: OCUPA TODO EL FONDO; cover: MANTIENE LA PROPORCION Y CUBRE EL FONDO, CENTRADA;
%tile: BALDOSAS DE ANCHO width (SIN width, EL NATURAL) DESDE LA ESQUINA O EL BORDE anchor (O EL CENTRO).
%rotate: COMO EN grid/image.
\tl_new:N \l_pgfgo_goban_background_image_tl
\tl_new:N \l_pgfgo_goban_background_image_fit_tl
\tl_new:N \l_pgfgo_goban_background_image_width_tl
\tl_new:N \l_pgfgo_goban_background_image_anchor_tl
\tl_new:N \l_pgfgo_goban_background_image_tiles_tl
\tl_new:N \l_pgfgo_goban_background_image_rotate_tl
\keys_define:nn {pgfgo / goban / background / fill / image}{
	file				.tl_set:N		= \l_pgfgo_goban_background_image_tl,
	fit					.choices:nn	= {stretch, cover, tile}
		{\tl_set_eq:NN \l_pgfgo_goban_background_image_fit_tl \l_keys_choice_tl},
	fit					.initial:n	= {cover},
	width				.tl_set:N		= \l_pgfgo_goban_background_image_width_tl,
	anchor			.choices:nn	= {south~west, south, south~east, west, center, east, north~west, north, north~east}
		{\tl_set_eq:NN \l_pgfgo_goban_background_image_anchor_tl \l_keys_choice_tl},
	anchor			.initial:n	= {south~west},
	tiles				.tl_set:N		= \l_pgfgo_goban_background_image_tiles_tl,
	rotate			.tl_set:N		= \l_pgfgo_goban_background_image_rotate_tl,
	false				.code:n			= {\tl_clear:N \l_pgfgo_goban_background_image_tl},
}

	\keys_define:nn {pgfgo / goban / label} {
		false				.code:n 		= {\keys_set:nn {pgfgo / goban / label / at} {none}},
		%LETRAS ABAJO Y NUMEROS A LA IZQUIERDA: "A1" SE LEE DESDE LA ESQUINA INFERIOR IZQUIERDA.
		true				.code:n 		= {\keys_set:nn {pgfgo / goban / label / at} {none, south, west}},

		color				.tl_set:N 	= \l_pgfgo_goban_labels_color_tl,

		sep					.dim_set:N 	= \l_pgfgo_goban_labels_sep_dim,

		font				.tl_set:N 	= \l_pgfgo_goban_label_font_tl,
		font				.initial:n	= {\sffamily},

		%VACIO: TAMANO DEL TEXTO ACTUAL.
		font~size		.tl_set:N 	= \l_pgfgo_goban_label_font_size_tl,

		at					.code:n 		= {\keys_set:nx{pgfgo / goban / label / at} {#1}},

		columns			.choices:nn	= {letters, numbers, kanji}
			{\tl_set_eq:NN \l_pgfgo_goban_label_columns_tl \l_keys_choice_tl},
		columns			.initial:n	= {letters},
		rows				.choices:nn	= {letters, numbers, kanji}
			{\tl_set_eq:NN \l_pgfgo_goban_label_rows_tl \l_keys_choice_tl},
		rows				.initial:n	= {numbers},
		columns~direction	.choices:nn	= {left~to~right, right~to~left}
			{\tl_set_eq:NN \l_pgfgo_goban_label_columns_direction_tl \l_keys_choice_tl},
		columns~direction	.initial:n	= {left~to~right},
		rows~direction		.choices:nn	= {bottom~to~top, top~to~bottom}
			{\tl_set_eq:NN \l_pgfgo_goban_label_rows_direction_tl \l_keys_choice_tl},
		rows~direction		.initial:n	= {bottom~to~top},

		%ESTILOS COMPLETOS. japanese: NUMEROS DESDE LA DERECHA ARRIBA Y KANJI DESDE ARRIBA AL COSTADO.
		%chinese: IGUAL, PERO LOS NUMEROS DESDE LA IZQUIERDA.
		style				.choice:,
		style / western		.code:n	= {\keys_set:nn {pgfgo / goban / label}
			{columns = letters, rows = numbers, columns~direction = left~to~right, rows~direction = bottom~to~top}},
		style / japanese	.code:n	= {\keys_set:nn {pgfgo / goban / label}
			{columns = numbers, rows = kanji, columns~direction = right~to~left, rows~direction = top~to~bottom}},
		style / chinese		.code:n	= {\keys_set:nn {pgfgo / goban / label}
			{columns = numbers, rows = kanji, columns~direction = left~to~right, rows~direction = top~to~bottom}},
	}

	%EL TEXTO DE LA COORDENADA DE LA COLUMNA O LA FILA #1.
	\cs_new:Npn \__pgfgo_goban_column_label:n #1 {
		\__pgfgo_goban_label_text:Vn \l_pgfgo_goban_label_columns_tl {
			\str_if_eq:VnTF \l_pgfgo_goban_label_columns_direction_tl {right~to~left}
				{\l_pgfgo_goban_size_x_int - (#1) + 1} {#1}
		}
	}
	\cs_new:Npn \__pgfgo_goban_row_label:n #1 {
		\__pgfgo_goban_label_text:Vn \l_pgfgo_goban_label_rows_tl {
			\str_if_eq:VnTF \l_pgfgo_goban_label_rows_direction_tl {top~to~bottom}
				{\l_pgfgo_goban_size_y_int - (#1) + 1} {#1}
		}
	}
	\cs_new:Npn \__pgfgo_goban_label_text:nn #1#2 {
		\str_case:nn {#1} {
			{letters}	{\pgfgo_kernel_column_name:n {#2}}
			{numbers}	{\int_eval:n {#2}}
			{kanji}		{\__pgfgo_goban_kanji:e {\int_eval:n {#2}}}
		}
	}
	\cs_generate_variant:Nn \__pgfgo_goban_label_text:nn {V}

	%NUMEROS EN KANJI: 1 A 9, Y DESPUES 十 (10), 十一 (11), 二十 (20), ... NECESITAN UNA FUENTE QUE LOS TENGA.
	\tl_const:Nn \c__pgfgo_goban_kanji_tl {{一}{二}{三}{四}{五}{六}{七}{八}{九}{十}}
	\cs_new:Npn \__pgfgo_goban_kanji:n #1 {
