		\pgfgo_kernel_if_feature:nT {captures} {\pgfgo_kernel_board_clear:}
		\keys_set:nn {pgfgo / goban} {#1}
		\pgfgo_kernel_board_init:
		\bool_if:NT \l_pgfgo_goban_captures_bool {\pgfgo_captures_begin:}

		\__pgfgo_goban:nVV{}{\l_pgfgo_goban_size_x_int}{\l_pgfgo_goban_size_y_int}
		}{\__end_pgfgo_goban:}



