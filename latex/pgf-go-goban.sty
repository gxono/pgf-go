		\pgfonlayer{pgfgo_layer_goban_grid}
		\pgfscope
		\bool_if:NT\l_pgfgo_goban_partial_bool{
			\pgfpathrectanglecorners
				{\pgfpointxy{\int_use:N\l_pgfgo_goban_from_x_int-0.5}{\int_use:N\l_pgfgo_goban_from_y_int-0.5}}
				{\pgfpointxy{\int_use:N\l_pgfgo_goban_to_x_int+0.5}{\int_use:N\l_pgfgo_goban_to_y_int+0.5}}
		
			\pgfusepath{clip}
		}

		\bool_if:NT\l_pgfgo_goban_grid_bool{
			\tl_if_empty:NTF \l_pgfgo_goban_grid_image_tl {
				\pgfscope
				\pgfsetstrokecolor{\l_pgfgo_goban_grid_color_tl}
				\pgfsetstrokeopacity{\l_pgfgo_goban_grid_opacity_tl}
				\pgfsetlinewidth{\l_pgfgo_goban_grid_line_width_dim}
				\pgfsetroundcap

				\pgfpathgrid[step = \pgfpointxy{1}{1}] {\pgfpointxy{1}{1}}{\pgfpointxy{#2}{#3}}

				\pgfusepath{stroke}
				\endpgfscope
			}{
				\bool_lazy_and:nnT {\int_compare_p:nNn {#2} > {1}} {\int_compare_p:nNn {#3} > {1}} {
					\pgfscope
					\pgfsetfillopacity{\l_pgfgo_goban_grid_opacity_tl}
					\str_if_eq:VnTF \l_pgfgo_goban_grid_image_fit_tl {tile} {
						\tl_if_empty:NTF \l_pgfgo_goban_grid_image_tiles_tl
							{
								\int_set:Nn \l__pgfgo_goban_tiles_x_int {#2 - 1}
								\int_set:Nn \l__pgfgo_goban_tiles_y_int {#3 - 1}
							}
							{
								\__pgfgo_goban_tiles:VNN \l_pgfgo_goban_grid_image_tiles_tl
									\l__pgfgo_goban_tiles_x_int \l__pgfgo_goban_tiles_y_int
							}
						\pgfgo_image_load:Ve \l_pgfgo_goban_grid_image_tl {
							width = \fp_to_dim:n {\l_pgfgo_goban_grid_x_sep_dim * (#2 - 1) / \l__pgfgo_goban_tiles_x_int},
							height = \fp_to_dim:n {\l_pgfgo_goban_grid_y_sep_dim * (#3 - 1) / \l__pgfgo_goban_tiles_y_int}
						}
						\__pgfgo_goban_mesh:nnnn {\l_pgfgo_goban_grid_x_sep_dim} {\l_pgfgo_goban_grid_y_sep_dim}
							{\l__pgfgo_goban_tiles_x_int} {\l__pgfgo_goban_tiles_y_int}
					}{
						\pgfgo_image_load:Ve \l_pgfgo_goban_grid_image_tl {
							width = \dim_eval:n {\l_pgfgo_goban_grid_x_sep_dim * (#2 - 1)},
							height = \dim_eval:n {\l_pgfgo_goban_grid_y_sep_dim * (#3 - 1)}
						}
						\pgfgo_image_draw:n {\pgfpointxy {\fp_eval:n {(#2 + 1) / 2}} {\fp_eval:n {(#3 + 1) / 2}}}
					}
					\endpgfscope
				}
			}

			%PUNTOS DE ESTRELLA, SOLO LOS DE LA PARTE VISIBLE.
			\bool_if:NT \l_pgfgo_goban_hoshi_bool {
				\tl_if_empty:NTF \l_pgfgo_goban_hoshi_at_tl
					{\pgfgo_kernel_hoshi:}
					{\pgfgo_kernel_points:V \l_pgfgo_goban_hoshi_at_tl}
				\pgfscope
				\pgfsetfillopacity{\l_pgfgo_goban_grid_opacity_tl}
				\tl_if_empty:NTF \l_pgfgo_goban_hoshi_image_tl {
					\pgfsetfillcolor{\tl_if_empty:NTF \l_pgfgo_goban_hoshi_color_tl
						{\l_pgfgo_goban_grid_color_tl} {\l_pgfgo_goban_hoshi_color_tl}}
					\seq_map_inline:Nn \l_pgfgo_kernel_points_seq {\__pgfgo_goban_hoshi:nn ##1}
					\pgfusepath{fill}
				}{
					\pgfgo_image_load:Ve \l_pgfgo_goban_hoshi_image_tl
						{width = \dim_eval:n {2 \l_pgfgo_goban_hoshi_radius_dim}}
					\seq_map_inline:Nn \l_pgfgo_kernel_points_seq {\__pgfgo_goban_hoshi_image:nn ##1}
				}
				\endpgfscope
			}
		}
		\endpgfscope
		\endpgfonlayer

