	%KERNEL): UNA VISTA NO LO CAMBIA, PARA QUE \pgfgoscore, \pgfgonotes, ... SIGAN HABLANDO DE ESE goban.
	\prop_new:N \l__pgfgo_view_points_prop
	\prop_new:N \l__pgfgo_view_territory_prop
	\seq_new:N \l__pgfgo_view_notes_seq
	\tl_new:N \l__pgfgo_view_bbox_tl
	\cs_new_protected:Npn \__pgfgo_view_save: {
		\prop_set_eq:NN \l__pgfgo_view_points_prop \g_pgfgo_points_prop
		\prop_set_eq:NN \l__pgfgo_view_territory_prop \g_pgfgo_territory_prop
		\seq_set_eq:NN \l__pgfgo_view_notes_seq \g_pgfgo_move_notes_seq
		\tl_set_eq:NN \l__pgfgo_view_bbox_tl \g_pgfgo_goban_bbox_tl
		\pgfgo_kernel_if_feature:nT {captures} {\pgfgo_kernel_board_save:n {pgfgo-view}}
	}
	\cs_new_protected:Npn \__pgfgo_view_restore: {
		\prop_gset_eq:NN \g_pgfgo_points_prop \l__pgfgo_view_points_prop
		\prop_gset_eq:NN \g_pgfgo_territory_prop \l__pgfgo_view_territory_prop
		\seq_gset_eq:NN \g_pgfgo_move_notes_seq \l__pgfgo_view_notes_seq
		\tl_gset_eq:NN \g_pgfgo_goban_bbox_tl \l__pgfgo_view_bbox_tl
		\pgfgo_kernel_if_feature:nT {captures} {\pgfgo_kernel_board_restore:n {pgfgo-view}}
	}

	\msg_new:nnn {pgfgo} {unknown-view} {There~is~no~goban~with~name~=~'#1'.}

	%\pgfgoview[OPCIONES]{NOMBRE}{PARTE}: EL goban CON ESE NOMBRE COMO QUEDO AL TERMINAR (CON LAS CAPTURAS),
	%SOLO EN ESA PARTE, PARA USAR EN EL TEXTO.
	\cs_new_protected:Npn \pgfgo_view:nnn #1#2#3 {
		\prop_get:NnNTF \g__pgfgo_goban_names_prop {#2} \l__pgfgo_view_options_tl {
			\group_begin:
				%EL ESTILO DEL goban CON NOMBRE; \pgfgoset{view} Y LAS OPCIONES DE LA VISTA VAN ENCIMA.
				\prop_get:NnN \g__pgfgo_goban_names_style_prop {#2} \l__pgfgo_view_style_tl
				\tl_use:N \l__pgfgo_view_style_tl
				\keys_set:nn {pgfgo / view} {#1}
				\bool_set:Nn \l_pgfgo_remember_hide_mark_bool {! \l__pgfgo_view_marks_bool}
				\bool_set:Nn \l_pgfgo_remember_hide_numbers_bool {! \l__pgfgo_view_numbers_bool}
				\bool_set:Nn \l_pgfgo_remember_hide_territory_bool {! \l__pgfgo_view_territory_bool}
				\bool_set:Nn \l_pgfgo_remember_hide_forgotten_bool {! \l__pgfgo_view_forgotten_bool}
				\tl_set:Nn \l_pgfgo_goban_view_tl {#2}
				\tl_clear:N \l_pgfgo_goban_name_tl
				\tl_clear:N \l_pgfgo_goban_resume_tl
				\__pgfgo_view_range:n {#3}
				\__pgfgo_view_save:
				\use:e {
					\exp_not:N \begin {goban} [
						\exp_not:V \l__pgfgo_view_options_tl
						\tl_if_empty:NF \l__pgfgo_view_profile_tl
							{, profile = {\exp_not:V \l__pgfgo_view_profile_tl}}
						\exp_not:V \l__pgfgo_view_goban_tl,
						partial = {\l__pgfgo_view_range_str}
					]
				}
				\end{goban}
				\__pgfgo_view_restore:
			\group_end:
		}{
			\msg_error:nnn {pgfgo} {unknown-view} {#2}
		}
	}
	\tl_new:N \l__pgfgo_view_options_tl
	\NewDocumentCommand \pgfgoview {O{} m m} {\pgfgo_view:nnn {#1} {#2} {#3}}

