		at								.tl_set:N		= \l_pgfgo_goban_hoshi_at_tl,
		image							.code:n			= {\keys_set:nn {pgfgo / goban / hoshi / image} {#1}},
	}
	%UNA IMAGEN EN CADA PUNTO EN LUGAR DEL CIRCULO. SIN width, DE ANCHO 2 radius. rotate: COMO EN
	%stone/image (UN ANGULO, random O <MIN>:<MAX>, SIEMPRE EL MISMO EN CADA PUNTO).
	\tl_new:N \l_pgfgo_goban_hoshi_image_tl
	\tl_new:N \l_pgfgo_goban_hoshi_image_width_tl
	\tl_new:N \l_pgfgo_goban_hoshi_image_rotate_tl
	\keys_define:nn {pgfgo / goban / hoshi / image}{
		file							.tl_set:N		= \l_pgfgo_goban_hoshi_image_tl,
		width							.tl_set:N		= \l_pgfgo_goban_hoshi_image_width_tl,
		rotate						.tl_set:N		= \l_pgfgo_goban_hoshi_image_rotate_tl,
		false							.code:n			= {\tl_clear:N \l_pgfgo_goban_hoshi_image_tl},
	}
	\bool_set_true:N \l_pgfgo_goban_hoshi_bool

	%false: SIN LAS LINEAS (LOS HOSHI Y LA IMAGEN DE LA CUADRICULA QUEDAN).
	\bool_new:N \l_pgfgo_goban_grid_line_bool
	\bool_set_true:N \l_pgfgo_goban_grid_line_bool
	\keys_define:nn {pgfgo / goban / grid / line} {
