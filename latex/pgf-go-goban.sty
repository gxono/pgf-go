	%DIBUJA LA IMAGEN DE FONDO DEL TABLERO COMPLETO (EL RECORTE LO HACE QUIEN LLAMA). LAS MARCAS LA
	%VUELVEN A DIBUJAR DEBAJO DE ELLAS, EN LUGAR DEL COLOR DEL FONDO.
	\dim_new:N \l__pgfgo_goban_image_x_dim
	\dim_new:N \l__pgfgo_goban_image_y_dim
	\dim_new:N \l__pgfgo_goban_image_w_dim
	\dim_new:N \l__pgfgo_goban_image_h_dim
	\fp_new:N \l__pgfgo_goban_image_fp
	\cs_new_protected:Npn \pgfgo_goban_background_image: {
		%ESQUINA INFERIOR IZQUIERDA Y TAMANO DEL FONDO DEL TABLERO COMPLETO.
		\dim_set:Nn \l__pgfgo_goban_image_x_dim {\l_pgfgo_goban_grid_x_sep_dim - \l_pgfgo_goban_border_sep_dim}
		\dim_set:Nn \l__pgfgo_goban_image_y_dim {\l_pgfgo_goban_grid_y_sep_dim - \l_pgfgo_goban_border_sep_dim}
		\dim_set:Nn \l__pgfgo_goban_image_w_dim
			{\l_pgfgo_goban_grid_x_sep_dim * (\l_pgfgo_goban_size_x_int - 1) + 2 \l_pgfgo_goban_border_sep_dim}
		\dim_set:Nn \l__pgfgo_goban_image_h_dim
			{\l_pgfgo_goban_grid_y_sep_dim * (\l_pgfgo_goban_size_y_int - 1) + 2 \l_pgfgo_goban_border_sep_dim}
		\str_case:Vn \l_pgfgo_goban_background_image_fit_tl {
			{stretch} {
				\pgfgo_image_load:Ve \l_pgfgo_goban_background_image_tl {
					width = \dim_use:N \l__pgfgo_goban_image_w_dim,
					height = \dim_use:N \l__pgfgo_goban_image_h_dim
				}
				\__pgfgo_goban_background_image_center:
			}
			{cover} {
				\pgfgo_image_measure:V \l_pgfgo_goban_background_image_tl
				\fp_set:Nn \l__pgfgo_goban_image_fp {
					max(\dim_to_fp:n {\l__pgfgo_goban_image_w_dim} / \dim_to_fp:n {\l_pgfgo_image_width_dim},
						\dim_to_fp:n {\l__pgfgo_goban_image_h_dim} / \dim_to_fp:n {\l_pgfgo_image_height_dim})
				}
				\pgfgo_image_load:Ve \l_pgfgo_goban_background_image_tl {
					width = \fp_to_dim:n {ceil(\l__pgfgo_goban_image_fp * \l_pgfgo_image_width_dim, 2)}
				}
				\__pgfgo_goban_background_image_center:
			}
			{tile} {
				\tl_if_empty:NTF \l_pgfgo_goban_background_image_tiles_tl
					{\__pgfgo_goban_background_image_tile:}
					{
						\__pgfgo_goban_tiles:VNN \l_pgfgo_goban_background_image_tiles_tl
							\l__pgfgo_goban_tiles_x_int \l__pgfgo_goban_tiles_y_int
						\pgfgo_image_load:Ve \l_pgfgo_goban_background_image_tl {
							width = \fp_to_dim:n {\l__pgfgo_goban_image_w_dim / \l__pgfgo_goban_tiles_x_int},
							height = \fp_to_dim:n {\l__pgfgo_goban_image_h_dim / \l__pgfgo_goban_tiles_y_int}
						}
						\__pgfgo_goban_mesh:nnnn {\l__pgfgo_goban_image_x_dim} {\l__pgfgo_goban_image_y_dim}
							{\l__pgfgo_goban_tiles_x_int} {\l__pgfgo_goban_tiles_y_int}
					}
			}
		}
	}

	\cs_new_protected:Npn \__pgfgo_goban_background_image_center: {
		\pgfgo_image_draw:n {
			\pgfpoint
				{\l__pgfgo_goban_image_x_dim + 0.5 \l__pgfgo_goban_image_w_dim}
				{\l__pgfgo_goban_image_y_dim + 0.5 \l__pgfgo_goban_image_h_dim}
		}
	}

	%SOLO LAS BALDOSAS QUE TOCAN EL FONDO DE LA PARTE VISIBLE. LAS BALDOSAS SE ALINEAN CON LA ESQUINA from
	%O EL BORDE from DEL FONDO DEL TABLERO COMPLETO (CENTRADAS EN EL BORDE); CON center, EN EL CENTRO.
	\dim_new:N \l__pgfgo_goban_tile_x_dim
	\dim_new:N \l__pgfgo_goban_tile_y_dim
	\cs_new_protected:Npn \__pgfgo_goban_background_image_tile: {
		\tl_if_empty:NTF \l_pgfgo_goban_background_image_width_tl
			{\pgfgo_image_load:Ve \l_pgfgo_goban_background_image_tl {}}
			{
				\pgfgo_image_load:Ve \l_pgfgo_goban_background_image_tl
					{width = \dim_eval:n {\l_pgfgo_goban_background_image_width_tl}}
			}
		%LA ESQUINA INFERIOR IZQUIERDA DE UNA BALDOSA, DESDE LA DEL FONDO COMPLETO: CONTRA EL BORDE QUE
		%NOMBRA from O, EN LA OTRA DIRECCION, CENTRADA.
		\__pgfgo_goban_tile_start:Nnnnn \l__pgfgo_goban_tile_x_dim
			{west} {east} {\l__pgfgo_goban_image_w_dim} {\l_pgfgo_image_width_dim}
		\__pgfgo_goban_tile_start:Nnnnn \l__pgfgo_goban_tile_y_dim
			{south} {north} {\l__pgfgo_goban_image_h_dim} {\l_pgfgo_image_height_dim}
		\int_step_inline:nnn
			{\__pgfgo_goban_tile_first:nnnn {\l_pgfgo_goban_from_x_int} {\l_pgfgo_goban_grid_x_sep_dim} {\l_pgfgo_image_width_dim} {\l__pgfgo_goban_tile_x_dim}}
			{\__pgfgo_goban_tile_last:nnnn {\l_pgfgo_goban_to_x_int} {\l_pgfgo_goban_grid_x_sep_dim} {\l_pgfgo_image_width_dim} {\l__pgfgo_goban_tile_x_dim}}
			{
				\int_step_inline:nnn
					{\__pgfgo_goban_tile_first:nnnn {\l_pgfgo_goban_from_y_int} {\l_pgfgo_goban_grid_y_sep_dim} {\l_pgfgo_image_height_dim} {\l__pgfgo_goban_tile_y_dim}}
					{\__pgfgo_goban_tile_last:nnnn {\l_pgfgo_goban_to_y_int} {\l_pgfgo_goban_grid_y_sep_dim} {\l_pgfgo_image_height_dim} {\l__pgfgo_goban_tile_y_dim}}
					{
						\pgfgo_image_draw:n {
							\pgfpoint
								{\l__pgfgo_goban_image_x_dim + \l__pgfgo_goban_tile_x_dim + \fp_to_dim:n {(##1 + 0.5) * \l_pgfgo_image_width_dim}}
								{\l__pgfgo_goban_image_y_dim + \l__pgfgo_goban_tile_y_dim + \fp_to_dim:n {(####1 + 0.5) * \l_pgfgo_image_height_dim}}
						}
					}
			}
	}
	%LA MALLA tiles = <COLUMNAS>x<FILAS> (O UN SOLO NUMERO PARA LAS DOS) EN #2 Y #3.
	\seq_new:N \l__pgfgo_goban_tiles_seq
	\msg_new:nnn {pgfgo} {image-tiles}
		{Image~tiles~must~be~'<columns>x<rows>'~or~a~number~(not~'#1').~One~tile~is~used.}
	\cs_new_protected:Npn \__pgfgo_goban_tiles:nNN #1#2#3 {
		\seq_set_split:Nnn \l__pgfgo_goban_tiles_seq {x} {#1}
		\int_set:Nn #2 {\seq_item:Nn \l__pgfgo_goban_tiles_seq {1}}
		\int_set:Nn #3 {\seq_item:Nn \l__pgfgo_goban_tiles_seq {-1}}
		\bool_lazy_or:nnT {\int_compare_p:nNn {#2} < {1}} {\int_compare_p:nNn {#3} < {1}} {
			\msg_warning:nnn {pgfgo} {image-tiles} {#1}
			\int_set:Nn #2 {1}
			\int_set:Nn #3 {1}
		}
	}
	\cs_generate_variant:Nn \__pgfgo_goban_tiles:nNN {V}
	\int_new:N \l__pgfgo_goban_tiles_x_int
	\int_new:N \l__pgfgo_goban_tiles_y_int

	%DIBUJA LA ULTIMA IMAGEN CARGADA EN CADA CELDA DE UNA MALLA DE #3 x #4 QUE EMPIEZA EN (#1,#2) (PUNTOS
	%DE PGF EN dim) Y CUYAS CELDAS MIDEN LO QUE LA IMAGEN.
	\cs_new_protected:Npn \__pgfgo_goban_mesh:nnnn #1#2#3#4 {
		\int_step_inline:nnn {0} {#3 - 1} {
			\int_step_inline:nnn {0} {#4 - 1} {
				\pgfgo_image_draw:n {
					\pgfpoint
						{#1 + \fp_to_dim:n {(##1 + 0.5) * \l_pgfgo_image_width_dim}}
						{#2 + \fp_to_dim:n {(####1 + 0.5) * \l_pgfgo_image_height_dim}}
				}
			}
		}
	}

	%#1: DONDE EMPIEZA LA BALDOSA ALINEADA EN UNA DIRECCION: 0 SI from NOMBRA EL BORDE #2, EL TAMANO DEL
	%FONDO #4 SI NOMBRA EL BORDE #3 Y, SI NO NOMBRA NINGUNO, CENTRADA (#5: TAMANO DE LA BALDOSA).
	\cs_new_protected:Npn \__pgfgo_goban_tile_start:Nnnnn #1#2#3#4#5 {
		\tl_if_in:NnTF \l_pgfgo_goban_background_image_from_tl {#2}
			{\dim_zero:N #1}
			{
				\tl_if_in:NnTF \l_pgfgo_goban_background_image_from_tl {#3}
					{\dim_set:Nn #1 {#4}}
					{\dim_set:Nn #1 {0.5 #4 - 0.5 #5}}
			}
	}
	%LA PRIMERA Y LA ULTIMA BALDOSA QUE TOCAN LA PARTE VISIBLE, CONTANDO DESDE 0 EN LA BALDOSA ALINEADA.
	%#1: PRIMERA (O ULTIMA) LINEA VISIBLE, #2: SEPARACION DE LAS LINEAS, #3: TAMANO DE LA BALDOSA, #4: DONDE
	%EMPIEZA LA BALDOSA ALINEADA, DESDE LA ESQUINA DEL FONDO COMPLETO.
	\cs_new:Npn \__pgfgo_goban_tile_first:nnnn #1#2#3#4 {
		\fp_eval:n {floor((((#1) - 1) * \dim_to_fp:n {#2} - \dim_to_fp:n {#4}) / \dim_to_fp:n {#3})}
	}
	\cs_new:Npn \__pgfgo_goban_tile_last:nnnn #1#2#3#4 {
		\fp_eval:n {
			ceil((((#1) - 1) * \dim_to_fp:n {#2} + 2 * \dim_to_fp:n {\l_pgfgo_goban_border_sep_dim}
				- \dim_to_fp:n {#4}) / \dim_to_fp:n {#3}) - 1
		}
	}
	\cs_generate_variant:Nn \pgfgo_image_load:nn {Vn}

	%DIBUJA EL TABLERO. #2 Y #3 SON EL TAMANO COMPLETO; LA PARTE VISIBLE YA LA CALCULO \pgfgo_kernel_board_init:.
	\cs_new:Npn\__pgfgo_goban:nnn #1#2#3 {
		\group_begin:
		\pgfsetlayers{
			pgfgo_layer_goban_border,
			pgfgo_layer_goban_grid,
			pgfgo_layer_goban_labels,
			pgfgo_layer_territory,
			pgfgo_layer_mark_shadow,
			pgfgo_layer_stone,
			pgfgo_layer_stone_mark,
			pgfgo_layer_mark,
			main
		}

		%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
		%-----------------TIKZ PICTURE---------------------%
		%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

		\tikzpicture
		\pgfsetxvec{\pgfpoint{ \l_pgfgo_goban_grid_x_sep_dim}{0}}
		\pgfsetyvec{\pgfpoint{0}{ \l_pgfgo_goban_grid_y_sep_dim}}
		\pgftransformscale{\l_pgfgo_goban_scale_tl}

		%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
		%----------------BORDER AND FILL-------------------%
		%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

		\pgfonlayer{pgfgo_layer_goban_border}
		\bool_if:NT\l_pgfgo_goban_border_bool{
			\pgfscope
				\pgfsetlinewidth{\l_pgfgo_goban_border_line_width_dim}
				\pgfsetstrokecolor{\l_pgfgo_goban_border_color_tl}
				\pgfsetstrokeopacity{\l_pgfgo_goban_border_opacity_tl}
				\pgfsetfillcolor{\l_pgfgo_goban_border_fill_color_tl}
				\pgfsetfillopacity{\l_pgfgo_goban_border_fill_opacity_tl}
				
%				\pgfsetcornersarced{\pgfpoint{\l_pgfgo_goban_border_rounded_corners_dim}{\l_pgfgo_goban_border_rounded_corners_dim}}
				
				%--------DROP SHADOW
				
				\bool_if:NT \l_pgfgo_goban_background_drop_shadow_bool {
					\pgfscope
						\pgftransformshift{
							\pgfpointpolar
								{\fp_to_decimal:N\l_pgfgo_goban_background_drop_shadow_angle_fp}
								{\l_pgfgo_goban_background_drop_shadow_offset_dim}}
						
						
						
					
						
						\__pgfgo_goban_background_path:nn {#2} {#3}
						
						
						\pgfsetfillcolor{\l_pgfgo_goban_background_drop_shadow_color_tl}
						\pgfsetfillopacity{\fp_to_decimal:N\l_pgfgo_goban_background_drop_shadow_opacity_fp}
						\pgfusepath{fill}
					\endpgfscope
				}
				
				
				
				
				%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
				%FONDO
				%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

				\pgfgo_goban_if_background_image:TF {
					\pgfscope
						\__pgfgo_goban_background_path:nn {#2} {#3}
						\pgfusepath{fill, clip}
						\pgfgo_goban_background_image:
					\endpgfscope
					\bool_if:NT \l_pgfgo_goban_border_line_bool {
						\__pgfgo_goban_background_path:nn {#2} {#3}
						\pgfusepath{stroke}
					}
				}{
					\__pgfgo_goban_background_path:nn {#2} {#3}
					\pgfusepath{\bool_if:NT\l_pgfgo_goban_border_line_bool{stroke}, \bool_if:NT\l_pgfgo_goban_border_fill_bool{fill}}
				}
			\endpgfscope
		}
