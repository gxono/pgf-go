		\pgfonlayer{pgfgo_layer_goban_labels}
			\pgfscope
				\pgfsetcolor{\l_pgfgo_goban_labels_color_tl}

				\bool_if:NT\l_pgfgo_goban_labels_pos_north_bool{
					\int_step_variable:nnNn {\l_pgfgo_goban_from_x_int} {\l_pgfgo_goban_to_x_int} \l__pgfgo_item_tl {
						\pgftext[at = \pgfpointadd
							{\pgfpointxy{\l__pgfgo_item_tl}{\l_pgfgo_goban_to_y_int}}
							{\pgfpoint{0}{\l_pgfgo_goban_labels_sep_dim + \l_pgfgo_players_stone_radius_dim + 0.5em}}
						]	{{
								\__pgfgo_goban_label_font:\__pgfgo_goban_column_label:n{\l__pgfgo_item_tl}
							}}}
				}

				
				
				\bool_if:NT\l_pgfgo_goban_labels_pos_east_bool{
					\int_step_variable:nnNn {\l_pgfgo_goban_from_y_int} {\l_pgfgo_goban_to_y_int}\l__pgfgo_item_tl
					{
						%LOS KANJI (UNO, DOS O TRES) SE ALINEAN DEL LADO DEL TABLERO, PARA NO PISARLO.
						\str_if_eq:VnTF \l_pgfgo_goban_label_rows_tl {kanji} {
							\pgftext[left, at = \pgfpointadd{
								\pgfpointxy{\l_pgfgo_goban_to_x_int}{\l__pgfgo_item_tl}}{
								\pgfpoint{\l_pgfgo_goban_labels_sep_dim+\l_pgfgo_players_stone_radius_dim}{0}}
							]	{{
									\__pgfgo_goban_label_font:\__pgfgo_goban_row_label:n{\l__pgfgo_item_tl}
							}}
						}{
							\pgftext[at = \pgfpointadd{
								\pgfpointxy{\l_pgfgo_goban_to_x_int}{\l__pgfgo_item_tl}}{
								\pgfpoint{\l_pgfgo_goban_labels_sep_dim+\l_pgfgo_players_stone_radius_dim+0.5em}{0}}
							]	{{
									\__pgfgo_goban_label_font:\__pgfgo_goban_row_label:n{\l__pgfgo_item_tl}
							}}
						}
					}
				}
				
				
				



				\bool_if:NT\l_pgfgo_goban_labels_pos_south_bool{
					\int_step_variable:nnNn {\l_pgfgo_goban_from_x_int} {\l_pgfgo_goban_to_x_int} \l__pgfgo_item_tl {
						\pgftext[at = \pgfpointadd{
							\pgfpointxy{\l__pgfgo_item_tl}{\l_pgfgo_goban_from_y_int}}{
							\pgfpoint{0}{-\l_pgfgo_goban_labels_sep_dim-\l_pgfgo_players_stone_radius_dim-0.5em}}
						]	{{
								\__pgfgo_goban_label_font:\__pgfgo_goban_column_label:n{\l__pgfgo_item_tl}
							}}}
				}




				\bool_if:NT\l_pgfgo_goban_labels_pos_west_bool{
					\int_step_variable:nnNn {\l_pgfgo_goban_from_y_int} {\l_pgfgo_goban_to_y_int} \l__pgfgo_item_tl {
						\str_if_eq:VnTF \l_pgfgo_goban_label_rows_tl {kanji} {
							\pgftext[right, at = \pgfpointadd{
								\pgfpointxy{\l_pgfgo_goban_from_x_int}{\l__pgfgo_item_tl}}{
								\pgfpoint{-\l_pgfgo_goban_labels_sep_dim-\l_pgfgo_players_stone_radius_dim}{0}}
							]	{{
									\__pgfgo_goban_label_font:\__pgfgo_goban_row_label:n{\l__pgfgo_item_tl}
							}}
						}{
							\pgftext[at = \pgfpointadd{
								\pgfpointxy{\l_pgfgo_goban_from_x_int}{\l__pgfgo_item_tl}}{
								\pgfpoint{-\l_pgfgo_goban_labels_sep_dim-\l_pgfgo_players_stone_radius_dim-0.5em}{0}}
							]	{{
									\__pgfgo_goban_label_font:\__pgfgo_goban_row_label:n{\l__pgfgo_item_tl}
							}}
						}
					}
				}
			\endpgfscope
		\endpgfonlayer



