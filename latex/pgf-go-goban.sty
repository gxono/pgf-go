	%EN UNA VISTA (\pgfgoview) LAS CLAVES DE LA MEMORIA NO HACEN NADA: LAS OPCIONES DEL goban CON NOMBRE SE
	%VUELVEN A USAR, Y NO TIENEN QUE BORRAR NI CAMBIAR NINGUNA MEMORIA.
	\tl_new:N \l_pgfgo_goban_view_tl
	\cs_new_protected:Npn \__pgfgo_goban_memory_key:n #1 {\tl_if_empty:NT \l_pgfgo_goban_view_tl {#1}}

	\keys_define:nn {pgfgo / goban}{
		%GUARDA TODO LO QUE DIBUJA ESTE goban CON ESE NOMBRE, PARA resume Y \pgfgoview.
		name							.code:n			= {\__pgfgo_goban_memory_key:n {\tl_set:Nn \l_pgfgo_goban_name_tl {#1}}},

		%EMPIEZA CON EL goban QUE SE LLAMA ASI COMO QUEDO AL TERMINAR: resume = {<nombre>, numbers, marks, territory}.
		resume						.code:n			= {\__pgfgo_goban_memory_key:n {\__pgfgo_goban_resume_key:n {#1}}},
		resume						.value_required:n = true,

		%LAS PIEDRAS CAPTURADAS DESAPARECEN (remove) O QUEDAN COMO PRISIONEROS (fade). SOLO CON kernel = lua.
		captures					.choices:nn = {true, remove, fade, false} {
																			\str_if_eq:VnTF \l_keys_choice_tl {false}
																				{\bool_set_false:N \l_pgfgo_goban_captures_bool}
																				{
																					\pgfgo_kernel_if_feature:nTF {captures} {
																						\bool_set_true:N \l_pgfgo_goban_captures_bool
																						\bool_set:Nn \l_pgfgo_goban_captures_fade_bool
																							{\str_if_eq_p:Vn \l_keys_choice_tl {fade}}
																					}{
																						\pgfgo_kernel_require:n {captures}
																					}
																				}
																			},
		captures					.default:n	= {remove},

		%CON captures: LAS MARCAS SOBRE UNA PIEDRA CAPTURADA QUEDAN (keep) O SE VAN CON ELLA (remove).
		captured~marks		.choice:,
		captured~marks/keep		.code:n	= {\bool_set_false:N \l_pgfgo_goban_captured_marks_bool},
		captured~marks/remove	.code:n	= {\bool_set_true:N \l_pgfgo_goban_captured_marks_bool},
		captured~marks		.initial:n	= {keep},

		%"N at M": UNA JUGADA NUMERADA EN UN PUNTO DONDE YA HUBO OTRA NO SE DIBUJA (VER pgf-go-stones.sty).
		notes							.bool_set:N	= \l_pgfgo_goban_notes_bool,
		notes							.default:n	= {true},

		grid							.code:n 		= {\keys_set:nx{pgfgo / goban / grid}		{#1}},
		grid							.default:n	= {true},

		hoshi							.code:n 		= {\keys_set:nn{pgfgo / goban / hoshi}		{#1}},
		hoshi							.default:n	= {true},

		background						.code:n 		= {\keys_set:nx{pgfgo / goban / background} {#1}},
		background						.default:n	= {true},

		label							.code:n 		= {\keys_set:nn{pgfgo / goban / label} {#1}},
		label							.default:n	= {true},

		%LAS ESQUINAS (partial = B2:D4, {B2, D4} O {B2 to D4}) O false.
		partial						.code:n 		= {
																			\str_if_eq:nnTF {#1} {false}
																				{\bool_set_false:N \l_pgfgo_goban_partial_bool}
																				{
																					\bool_set_true:N \l_pgfgo_goban_partial_bool
																					\__pgfgo_goban_partial_corners:n {#1}
																				}
																		},

		scale							.tl_set:N		= \l_pgfgo_goban_scale_tl,
		scale							.initial:n	= {1},

		size							.code:n			= {\pgfgo_kernel_board_size:n{#1}},

		%EL TAMANO DE LA PARTIDA DE UN ARCHIVO SGF (SZ). SOLO CON kernel = lua.
		sgf~size					.code:n			= {
																			\pgfgo_kernel_if_feature:nTF {sgf} {
																				\pgfgo_kernel_sgf_read:n {#1}
																				\int_set_eq:NN \l_pgfgo_goban_size_x_int \l_pgfgo_kernel_sgf_size_x_int
																				\int_set_eq:NN \l_pgfgo_goban_size_y_int \l_pgfgo_kernel_sgf_size_y_int
																			}{
																				\pgfgo_kernel_require:n {sgf}
																			}
																		},

		%LA VISTA DE UN ARCHIVO SGF (VW): EL TAMANO DE LA PARTIDA Y, SI HAY VISTA, ESA PARTE DEL TABLERO. LA
		%VISTA ES LA DE LA JUGADA sgf~view~move (LAS DOS CLAVES SE PUEDEN DAR EN CUALQUIER ORDEN).
		sgf~view					.code:n			= {
																			\tl_set:Nn \l__pgfgo_goban_sgf_view_file_tl {#1}
																			\__pgfgo_goban_sgf_view:
																		},
		sgf~view~move			.code:n			= {
																			\int_set:Nn \l_pgfgo_goban_sgf_view_from_int {#1}
																			\int_set:Nn \l_pgfgo_goban_sgf_view_to_int {#1}
																			\tl_if_empty:NF \l__pgfgo_goban_sgf_view_file_tl {\__pgfgo_goban_sgf_view:}
																		},

		use~i					.bool_set:N = \l_pgfgo_use_i_bool,

		use~i					.default:n	= {true},
		use~i					.initial:n	= {true},


		%UNA CLAVE DE /pgfgo (stone, players, mark, notes, ...) VALE SOLO PARA ESTE goban; SI NO, ES EL TAMANO.
		unknown						.code:n			= {
																			\keys_if_exist:nVTF {pgfgo} \l_keys_key_str
																				{
																					\use:e {
																						\exp_not:N \keys_set:nn {pgfgo}
																							{\l_keys_key_str \tl_if_empty:nF {#1} {= {\exp_not:n {#1}}}}
																					}
																				}
																				{\pgfgo_kernel_board_size:V\l_keys_key_str}
																		},
		}
	\prg_generate_conditional_variant:Nnn \keys_if_exist:nn {nV} {TF}

	\cs_generate_variant:Nn \pgfgo_kernel_board_size:n {V}

	\keys_define:nn {pgfgo / goban / grid}{
		false							.code:n			= {\bool_set_false:N \l_pgfgo_goban_grid_bool},
		true							.code:n			= {\bool_set_true:N \l_pgfgo_goban_grid_bool},

		line							.code:n			= {\keys_set:nn {pgfgo / goban / grid / line} {#1}},
		line							.default:n	= {true},

		x~sep							.dim_set:N	= \l_pgfgo_goban_grid_x_sep_dim,

		y~sep							.dim_set:N	= \l_pgfgo_goban_grid_y_sep_dim,

		sep								.code:n			= {\keys_set:nn{pgfgo / goban / grid}{x~sep = #1, y~sep = #1}},
		sep								.initial:n	= {1.25em},

		image							.code:n			= {\keys_set:nn {pgfgo / goban / grid / image} {#1}},
	}

	%UNA IMAGEN EN LUGAR DE LAS LINEAS. stretch: ESTIRADA DE A1 A LA ESQUINA OPUESTA DEL TABLERO COMPLETO;
	%tile: EN UNA MALLA DE tiles (<COLUMNAS>x<FILAS>) SOBRE ESA MISMA AREA, ESTIRADA AL TAMANO DE CADA
	%CELDA. SIN tiles, UNA EN CADA CASILLA DE LA CUADRICULA. rotate: COMO EN stone/image, REDONDEADO AL
	%CUARTO DE VUELTA (CADA BALDOSA EL SUYO); GIRADA, LA IMAGEN OCUPA EL MISMO LUGAR.
	\tl_new:N \l_pgfgo_goban_grid_image_tl
	\tl_new:N \l_pgfgo_goban_grid_image_fit_tl
	\tl_new:N \l_pgfgo_goban_grid_image_tiles_tl
	\tl_new:N \l_pgfgo_goban_grid_image_rotate_tl
	\keys_define:nn {pgfgo / goban / grid / image}{
		file							.tl_set:N		= \l_pgfgo_goban_grid_image_tl,
		fit								.choices:nn	= {stretch, tile}
			{\tl_set_eq:NN \l_pgfgo_goban_grid_image_fit_tl \l_keys_choice_tl},
		fit								.initial:n	= {stretch},
		tiles							.tl_set:N		= \l_pgfgo_goban_grid_image_tiles_tl,
		rotate						.tl_set:N		= \l_pgfgo_goban_grid_image_rotate_tl,
		false							.code:n			= {\tl_clear:N \l_pgfgo_goban_grid_image_tl},
	}

	%PUNTOS DE ESTRELLA. SIN color NI opacity, LOS DE LA CUADRICULA. at ELIGE LOS PUNTOS (VACIO: LOS DE SIEMPRE).
	\bool_new:N \l_pgfgo_goban_hoshi_bool
	\dim_new:N \l_pgfgo_goban_hoshi_radius_dim
	\tl_new:N \l_pgfgo_goban_hoshi_color_tl
	\tl_new:N \l_pgfgo_goban_hoshi_opacity_tl
	\tl_new:N \l_pgfgo_goban_hoshi_at_tl
	\keys_define:nn {pgfgo / goban / hoshi}{
		true							.code:n			= {\bool_set_true:N \l_pgfgo_goban_hoshi_bool},
		false							.code:n			= {\bool_set_false:N \l_pgfgo_goban_hoshi_bool},
		radius						.dim_set:N	= \l_pgfgo_goban_hoshi_radius_dim,
		radius						.initial:n	= {1.5pt},
		color							.tl_set:N		= \l_pgfgo_goban_hoshi_color_tl,
