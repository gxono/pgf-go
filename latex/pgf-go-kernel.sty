\tl_new:N \l_pgfgo_kernel_sgf_komi_tl
\seq_new:N \l_pgfgo_kernel_sgf_paths_seq
\tl_new:N \l_pgfgo_kernel_sgf_extent_tl


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%MENSAJES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\msg_new:nnn {pgfgo} {unknown-goban-key}
	{Unknown~goban~key~or~size~'#1'.~Use~a~size~like~'9'~or~'9x13'.}
\msg_new:nnn {pgfgo} {unknown-coordinate}
	{Coordinate~'#1'~was~not~recognized~and~is~ignored.~Columns~are~upper-case~letters~(for~example~'C3').}
\msg_new:nnn {pgfgo} {diagonal-line}
	{'#1'~is~not~a~horizontal~or~vertical~line~and~is~ignored.}
\msg_new:nnn {pgfgo} {outside-board}
	{Point~(#1,#2)~is~outside~the~board~and~is~ignored.}

\msg_new:nnn {pgfgo} {kernel-engine}
	{kernel~=~#1~needs~LuaLaTeX.~Using~kernel~=~expl3.}
\msg_new:nnn {pgfgo} {kernel-missing}
	{kernel~=~#1~is~not~available~(pgf-go-kernel-#1.sty~was~not~found).~Using~kernel~=~expl3.}
\msg_new:nnn {pgfgo} {kernel-incomplete}
	{kernel~=~#1~does~not~define~'#2'.}
\msg_new:nnn {pgfgo} {kernel-feature}
	{'#1'~needs~kernel~=~lua~(the~current~kernel~is~'#2').}
\msg_new:nnn {pgfgo} {sgf-not-found}
	{SGF~file~'#1'~was~not~found.}
\msg_new:nnn {pgfgo} {sgf-game}
	{'#1'~has~no~game~#2.~The~first~game~is~used.}
\msg_new:nnn {pgfgo} {sgf-charset}
	{'#1'~uses~the~charset~'#2',~which~is~not~supported~(UTF-8,~Latin-1,~GBK,~Big5,~Shift_JIS,
		~EUC-JP~and~EUC-KR~are).~It~is~read~as~Latin-1.~Convert~the~file~to~UTF-8.}
\msg_new:nnn {pgfgo} {sgf-variation}
	{'#1'~has~no~variation~'#2'.~The~first~variation~is~used~from~there.}

\cs_generate_variant:Nn \msg_warning:nnn {nnV}
\cs_generate_variant:Nn \msg_error:nnnn {nnnV, nnVe}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%CAPACIDADES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prg_new_protected_conditional:Npnn \pgfgo_kernel_if_feature:n #1 {T, F, TF} {
	\clist_if_in:NnTF \g_pgfgo_kernel_features_clist {#1} {\prg_return_true:} {\prg_return_false:}
}

%ERROR SI EL KERNEL ACTUAL NO SABE HACER #1.
\cs_new_protected:Npn \pgfgo_kernel_require:n #1 {
	\pgfgo_kernel_if_feature:nF {#1}
		{\msg_error:nnnV {pgfgo} {kernel-feature} {#1} \g_pgfgo_kernel_tl}
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%CARGA DEL KERNEL
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%\g_pgfgo_kernel_tl LO FIJA LA OPCION kernel DE pgf-go.sty. SI EL KERNEL PEDIDO NO SE PUEDE USAR, SE USA expl3.
\str_if_eq:VnT \g_pgfgo_kernel_tl {lua} {
	\sys_if_engine_luatex:F {
		\msg_warning:nnV {pgfgo} {kernel-engine} \g_pgfgo_kernel_tl
		\tl_gset:Nn \g_pgfgo_kernel_tl {expl3}
	}
}

\__pgfgo_module_if_exist:nF {pgf-go-kernel- \g_pgfgo_kernel_tl} {
	\msg_warning:nnV {pgfgo} {kernel-missing} \g_pgfgo_kernel_tl
	\tl_gset:Nn \g_pgfgo_kernel_tl {expl3}
}

\__pgfgo_load_module:e {pgf-go-kernel- \g_pgfgo_kernel_tl}

\cs_new_protected:Npn \__pgfgo_kernel_check:N #1 {
	\clist_map_inline:Nn #1 {
		\cs_if_exist:cF {##1}
			{\msg_error:nnVe {pgfgo} {kernel-incomplete} \g_pgfgo_kernel_tl {\c_backslash_str ##1}}
	}
}
\cs_generate_variant:Nn \__pgfgo_kernel_check:N {c}
\__pgfgo_kernel_check:N \c__pgfgo_kernel_interface_clist
\clist_map_inline:Nn \g_pgfgo_kernel_features_clist {
	\__pgfgo_kernel_check:c {c__pgfgo_kernel_ #1 _clist}
}

\ExplSyntaxOff
