\int_new:N \l_pgfgo_goban_size_x_int
\int_new:N \l_pgfgo_goban_size_y_int

%PARTE VISIBLE DEL TABLERO.
\int_new:N \l_pgfgo_goban_from_x_int
\int_new:N \l_pgfgo_goban_from_y_int
\int_new:N \l_pgfgo_goban_to_x_int
\int_new:N \l_pgfgo_goban_to_y_int

\seq_new:N \l_pgfgo_kernel_points_seq
\tl_new:N \l_pgfgo_kernel_point_tl

\seq_new:N \l_pgfgo_kernel_captured_seq
\seq_new:N \l_pgfgo_kernel_territory_seq

\int_new:N \l_pgfgo_kernel_sgf_size_x_int
\int_new:N \l_pgfgo_kernel_sgf_size_y_int
\seq_new:N \l_pgfgo_kernel_sgf_black_seq
\seq_new:N \l_pgfgo_kernel_sgf_white_seq
\seq_new:N \l_pgfgo_kernel_sgf_moves_seq
\seq_new:N \l_pgfgo_kernel_sgf_marks_seq
\seq_new:N \l_pgfgo_kernel_sgf_lines_seq
\seq_new:N \l_pgfgo_kernel_sgf_annotations_seq

\clist_new:N \g_pgfgo_kernel_features_clist

