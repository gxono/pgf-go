\ProvidesFile{pgf-go-kernel.sty}[2026/10/13 v0.2026.10.13 pgf-go: compute kernel interface]
\ExplSyntaxOn

%INTERFAZ ENTRE EL CALCULO Y EL DIBUJO.
%EL DIBUJO (goban, stones, marks) Y LAS CLAVES SOLO USAN LAS FUNCIONES \pgfgo_kernel_... Y LAS
%VARIABLES DECLARADAS ACA. UN KERNEL ES UN MODULO pgf-go-kernel-<nombre>.sty QUE DEFINE TODAS LAS
%FUNCIONES DE \c__pgfgo_kernel_interface_clist. SE ELIGE CON \usepackage[kernel = <nombre>]{pgf-go}.
%POR DEFECTO SE USA lua CON LuaLaTeX Y expl3 CON LOS DEMAS MOTORES. kernel = lua NECESITA LuaLaTeX.
%
%EL TAMANO Y LA VENTANA DEL TABLERO SON LOCALES (RESPETAN LOS GRUPOS DE TEX, COMO LAS OPCIONES DE goban).
%LA JUGADA, EL TURNO, LA SECUENCIA DE MARCAS Y LA MEMORIA SON GLOBALES.
%
%TABLERO
%	\pgfgo_kernel_board_size:n {9 | 9x13}
%		FIJA \l_pgfgo_goban_size_x_int Y \l_pgfgo_goban_size_y_int. ERROR unknown-goban-key SI NO ES UN TAMANO.
%	\pgfgo_kernel_board_window:n {A1 to E5}
%		GUARDA LA VENTANA PEDIDA CON partial (TODAVIA SIN RECORTAR). USA \l_pgfgo_use_i_bool.
%	\pgfgo_kernel_board_init:
%		FIJA \l_pgfgo_goban_from_x_int, ..._from_y_int, ..._to_x_int Y ..._to_y_int: LA PARTE VISIBLE.
%		ES TODO EL TABLERO, O LA VENTANA RECORTADA AL TABLERO SI \l_pgfgo_goban_partial_bool.
%	\pgfgo_kernel_if_visible:nnTF {x}{y}
%		VERDADERO SI (x,y) ESTA EN LA PARTE VISIBLE. SI ESTA FUERA DEL TABLERO AVISA (outside-board).
%	\pgfgo_kernel_column_name:n {x}							EXPANDIBLE
%		LETRA DE LA COLUMNA x. SIN use i SE SALTEA LA I.
%	\pgfgo_kernel_hoshi:
%		DEJA EN \l_pgfgo_kernel_points_seq LOS PUNTOS DE ESTRELLA DEL TABLERO, {x}{y}, FILA POR FILA DESDE
%		ABAJO. EN CADA EJE (DE 7 LINEAS O MAS) LA LINEA 4 DESDE EL BORDE (LA 3 SI EL EJE TIENE MENOS DE 13) Y,
%		SI EL EJE ES IMPAR, LA DEL MEDIO. SE DIBUJAN LAS CUATRO ESQUINAS; EL CENTRO SI LOS DOS EJES SON
%		IMPARES; Y EL MEDIO DE LOS LADOS SI ADEMAS LOS DOS TIENEN 15 LINEAS O MAS.
%
%COORDENADAS
%	\pgfgo_kernel_points:n {<coordenadas>}
%		DEJA EN \l_pgfgo_kernel_points_seq LAS INTERSECCIONES {x}{y}, SIN REPETIR, EN EL ORDEN EN QUE APARECEN.
%		ACEPTA TODA LA SINTAXIS DE \stones (RANGOS, OPERADORES, CORCHETES, ; PARA RESTAR). AVISA CON
%		unknown-coordinate Y diagonal-line.
%	\pgfgo_kernel_point:nTF {<coordenada>}
%		VERDADERO SI ES UNA SOLA INTERSECCION COMO C3; ENTONCES \l_pgfgo_kernel_point_tl ES {x}{y}.
%	\pgfgo_kernel_polygon:n {{x}{y},{x}{y},...}
%		DEJA EN \l_pgfgo_kernel_points_seq LAS INTERSECCIONES DEL TABLERO DENTRO DEL POLIGONO CERRADO DE ESOS
%		VERTICES O SOBRE SU BORDE, {x}{y}, FILA POR FILA DESDE ABAJO (Y CADA FILA DE IZQUIERDA A DERECHA).
%
%JUGADAS
%	\pgfgo_kernel_move_reset:							JUGADA 1, JUEGAN LAS NEGRAS.
%	\pgfgo_kernel_move_set_number:n {n}
%	\pgfgo_kernel_move_set_player:n {black | white}
%	\pgfgo_kernel_move_number:							EXPANDIBLE. NUMERO DE LA PROXIMA JUGADA.
%	\pgfgo_kernel_move_if_black:TF							EXPANDIBLE. LA PROXIMA JUGADA ES DE LAS NEGRAS.
%	\pgfgo_kernel_move_play:nn {x}{y}
%		JUEGA LA PROXIMA JUGADA EN (x,y): AVANZA EL NUMERO Y CAMBIA EL TURNO.
%
%SECUENCIAS DE MARCAS
%	\pgfgo_kernel_sequence_reset:n {n}
%	\pgfgo_kernel_sequence_number:							EXPANDIBLE. NUMERO DE LA PROXIMA MARCA.
%	\pgfgo_kernel_sequence_step:
%
%MEMORIA (remember / resume)
%	\pgfgo_kernel_remember_push:n {<codigo>}
%		AGREGA <codigo> A LA MEMORIA. SE EXPANDE CON e (USAR \exp_not:n PARA LAS OPCIONES DEL USUARIO).
%	\pgfgo_kernel_remember_clear:
%	\pgfgo_kernel_remember_replay:							EJECUTA EL CODIGO GUARDADO, EN ORDEN.
%
%CAPACIDADES
%	EL KERNEL GUARDA EN \g_pgfgo_kernel_features_clist LO QUE SABE HACER ADEMAS DE LO ANTERIOR
%	(captures, sgf). LAS CAPTURAS Y SGF SOLO LOS DA EL KERNEL lua. \pgfgo_kernel_if_feature:nTF Y
%	\pgfgo_kernel_require:n LO CONSULTAN. UN KERNEL QUE DECLARA UNA CAPACIDAD DEFINE TODAS SUS FUNCIONES.
%
%captures: EL KERNEL LLEVA LAS PIEDRAS QUE HAY EN EL TABLERO.
%	\pgfgo_kernel_board_clear:							TABLERO VACIO.
%	\pgfgo_kernel_board_put:nnn {black | white | empty}{x}{y}
%		PONE UNA PIEDRA SIN CAPTURAR NADA (\stones), O LA QUITA CON empty. FUERA DEL TABLERO NO HACE NADA.
%	\pgfgo_kernel_board_if_occupied:nnTF {x}{y}
%		VERDADERO SI HAY UNA PIEDRA EN (x,y).
%	\pgfgo_kernel_prisoners:n {black | white}					EXPANDIBLE
%		PRISIONEROS DEL JUGADOR DESDE \pgfgo_kernel_board_clear:: LAS PIEDRAS DEL OTRO COLOR QUE QUITARON LAS
%		JUGADAS (NO CUENTAN LAS QUE QUITA board_put CON empty).
%	\pgfgo_kernel_move_play:nn {x}{y}
%		ADEMAS PONE LA PIEDRA DEL TURNO Y SACA LOS GRUPOS SIN LIBERTADES (PRIMERO LOS DEL RIVAL; DESPUES
%		EL PROPIO, SI ES UN SUICIDIO). DEJA EN \l_pgfgo_kernel_captured_seq LAS PIEDRAS QUE SACO, {x}{y}.
%		SIN LA CAPACIDAD captures, \l_pgfgo_kernel_captured_seq QUEDA VACIA.
%
%territory: TERRITORIO.
%	\pgfgo_kernel_territory:n {{x}{y}{black | white | neutral}...}
%		RECIBE LAS PIEDRAS VIVAS Y DEJA EN \l_pgfgo_kernel_territory_seq CADA PUNTO SIN PIEDRA VIVA DEL TABLERO,
%		{x}{y}{black | white | neutral}: EL COLOR QUE RODEA SU REGION (neutral SI LA TOCAN LOS DOS O NINGUNO).
%		FILA POR FILA DESDE ABAJO.
%
%sgf: LECTURA DE PARTIDAS. SE LEE LA PARTIDA \l_pgfgo_kernel_sgf_game_int DEL ARCHIVO (1 ES LA PRIMERA; SI NO
%EXISTE, AVISO sgf-game Y SE LEE LA PRIMERA). UN ARCHIVO QUE NO ES UTF-8 SE LEE EN LA CODIFICACION
%\l_pgfgo_kernel_sgf_charset_tl O, SI ES auto, EN LA DE CA (Latin-1 SI NO HAY): Latin-1, GBK (Y GB2312),
%Big5, Shift_JIS, EUC-JP O EUC-KR. OTRA CODIFICACION DA EL AVISO sgf-charset Y SE LEE COMO Latin-1.
%	\pgfgo_kernel_sgf_read:nn {<archivo>}{<variante>}
%		LEE UNA LINEA DE LA PARTIDA. <variante> ES UNA LISTA DE NUMEROS (2.1): EN CADA
%		BIFURCACION SE TOMA ESA VARIANTE (1 ES LA PRINCIPAL); CUANDO SE TERMINA, SE SIGUE POR LA PRIMERA.
%		AVISO sgf-variation SI PIDE UNA VARIANTE QUE NO EXISTE. \pgfgo_kernel_sgf_read:n LEE LA PRINCIPAL. DEJA:
%		\l_pgfgo_kernel_sgf_size_x_int, \l_pgfgo_kernel_sgf_size_y_int	TAMANO (SZ; 19 SI NO ESTA).
%		\l_pgfgo_kernel_sgf_black_seq, \l_pgfgo_kernel_sgf_white_seq		PIEDRAS INICIALES (AB, AW), {x}{y}.
%		\l_pgfgo_kernel_sgf_moves_seq		JUGADAS, {black | white}{x}{y} (UN PASE TIENE x E y VACIOS), Y
%			ENTRE ELLAS LOS CAMBIOS DE LOS NODOS SIGUIENTES (AB, AW, AE): {add-black | add-white | remove}{x}{y},
%			{number}{n}{} ANTES DE UNA JUGADA CON MN (SU NUMERO ES n) Y {player}{black | white}{} DONDE ESTA PL.
%		\l_pgfgo_kernel_sgf_view_tl		LA VISTA (VW) DE LOS NODOS ANTERIORES A LA PRIMERA JUGADA, COMO
%			{x1}{y1}{x2}{y2} (EL RECTANGULO QUE LA CONTIENE). VACIA SI NO HAY.
%		\l_pgfgo_kernel_sgf_figures_seq		DONDE EMPIEZA CADA FIGURA (FG), {jugada}{i}: i ES EL NUMERO DEL
%			TEXTO DE SU NOMBRE (\pgfgo_kernel_sgf_name:n), O 0 SI NO TIENE.
%		\l_pgfgo_kernel_sgf_print_int		COMO SE NUMERAN LAS JUGADAS AL IMPRIMIR (PM): 0 SIN NUMEROS, 1 COMO
%			ESTAN, 2 REINICIADAS CADA 100. 1 SI NO ESTA.
%		\l_pgfgo_kernel_sgf_komi_tl		EL komi (KM), COMO NUMERO. 0 SI NO ESTA.
%		LAS COORDENADAS YA ESTAN EN EL SISTEMA DE pgf-go (LA FILA 1 ES LA DE ABAJO).
%		ERROR sgf-not-found SI NO ENCUENTRA EL ARCHIVO.
%	\pgfgo_kernel_sgf_comment:n {k}							EXPANDIBLE
%		COMENTARIO (C) DE LA JUGADA k DE LA ULTIMA PARTIDA LEIDA, COMO TEXTO (CATCODES 12 Y ESPACIOS).
%		k = 0 ES EL DE LOS NODOS ANTERIORES A LA PRIMERA JUGADA. VACIO SI NO HAY.
%	\pgfgo_kernel_sgf_marks:n {k}
%		DEJA EN \l_pgfgo_kernel_sgf_marks_seq LAS MARCAS (TR, SQ, CR, MA, SL, LB, DD) Y EL TERRITORIO (TB, TW)
%		DE LA JUGADA k, COMO {<forma>}{x}{y}{black | white | neutral}{i}. LA FORMA ES triangle, square, circle,
%		cross, selected, label, dim, black-territory O white-territory. EL COLOR ES EL DE LA PIEDRA QUE HAY
%		AHI EN ESE MOMENTO; i, PARA label, EL NUMERO DE SU TEXTO. LOS PUNTOS ATENUADOS (dim) VAN PRIMERO, Y
%		SE HEREDAN: SON LOS DEL ULTIMO DD HASTA LA JUGADA k.
%	\pgfgo_kernel_sgf_annotations:n {k}
%		DEJA EN \l_pgfgo_kernel_sgf_annotations_seq LAS ANOTACIONES DE LA JUGADA k, EN ORDEN, COMO
%		{propiedad}{valor}: {N}{i} (EL NOMBRE DEL NODO ES EL TEXTO i), O {GB | GW | DM | UC | TE | BM | DO | IT}
%		{1 | 2} (2: ENFATIZADO).
%	\pgfgo_kernel_sgf_name:n {i}								EXPANDIBLE
%		TEXTO DEL NOMBRE i (N), COMO TEXTO.
%	\pgfgo_kernel_sgf_variations:nn {k}{children | siblings | auto}
%		DEJA EN \l_pgfgo_kernel_sgf_variations_seq LAS VARIANTES DE LA JUGADA k COMO {x}{y}{color}{letra}:
%		children, LAS JUGADAS QUE PUEDEN SEGUIR; siblings, LAS ALTERNATIVAS A LA JUGADA k; auto, LO QUE DICE
%		ST (NADA SI ST PIDE QUE NO SE MARQUEN). SOLO SI HAY MAS DE UNA. LOS PASES NO SE MARCAN.
%	\pgfgo_kernel_sgf_lines:n {k}
%		DEJA EN \l_pgfgo_kernel_sgf_lines_seq LAS FLECHAS (AR) Y LINEAS (LN) DE LA JUGADA k, COMO
%		{arrow | line}{x1}{y1}{x2}{y2}.
%	\pgfgo_kernel_sgf_label:n {i}							EXPANDIBLE
%		TEXTO DE LA ETIQUETA i (LB), COMO TEXTO.
%	\pgfgo_kernel_sgf_info:nn {<archivo>}{<propiedad>}
%		ESCRIBE UNA PROPIEDAD DE LA RAIZ (PB, PW, RE, KM, DT, ...), COMO TEXTO.
%	\pgfgo_kernel_sgf_view:nn {k1}{k2}
%		DEJA EN \l_pgfgo_kernel_sgf_view_tl LA VISTA QUE ABARCA LAS DE LAS JUGADAS k1 A k2 DE LA ULTIMA PARTIDA
%		LEIDA: UN VW VALE DESDE LA JUGADA DE SU NODO (O LA SIGUIENTE, SI EL NODO NO TIENE JUGADA) HASTA EL
%		PROXIMO VW. VACIA SI EN ALGUNA DE ESAS JUGADAS SE VE TODO EL TABLERO. LA JUGADA 0 TIENE LA VISTA DE LA 1.
%	\pgfgo_kernel_sgf_tree:n {<archivo>}
%		RECORRE TODO EL ARBOL DE LA PARTIDA. DEJA:
%		\l_pgfgo_kernel_sgf_paths_seq		TODAS LAS LINEAS, EN ORDEN, COMO <variante> PARA
%			\pgfgo_kernel_sgf_read:nn (VACIA PARA UNA PARTIDA SIN BIFURCACIONES).
%		\l_pgfgo_kernel_sgf_extent_tl		EL RECTANGULO QUE CONTIENE TODAS LAS PIEDRAS, JUGADAS Y MARCAS DEL
%			ARBOL, {x1}{y1}{x2}{y2}. VACIO SI NO HAY NINGUNA.


\clist_const:Nn \c__pgfgo_kernel_interface_clist {
	pgfgo_kernel_board_size:n,
	pgfgo_kernel_board_window:n,
	pgfgo_kernel_board_init:,
	pgfgo_kernel_if_visible:nnT,
	pgfgo_kernel_if_visible:nnF,
	pgfgo_kernel_if_visible:nnTF,
	pgfgo_kernel_column_name:n,
	pgfgo_kernel_hoshi:,
	pgfgo_kernel_points:n,
	pgfgo_kernel_point:nTF,
	pgfgo_kernel_polygon:n,
	pgfgo_kernel_move_reset:,
	pgfgo_kernel_move_set_number:n,
	pgfgo_kernel_move_set_player:n,
	pgfgo_kernel_move_number:,
	pgfgo_kernel_move_if_black_p:,
	pgfgo_kernel_move_if_black:T,
	pgfgo_kernel_move_if_black:F,
	pgfgo_kernel_move_if_black:TF,
	pgfgo_kernel_move_play:nn,
	pgfgo_kernel_sequence_reset:n,
	pgfgo_kernel_sequence_number:,
	pgfgo_kernel_sequence_step:,
	pgfgo_kernel_remember_push:n,
	pgfgo_kernel_remember_clear:,
	pgfgo_kernel_remember_replay:
}

%FUNCIONES DE CADA CAPACIDAD.
\clist_const:Nn \c__pgfgo_kernel_captures_clist {
	pgfgo_kernel_board_clear:,
	pgfgo_kernel_board_put:nnn,
	pgfgo_kernel_board_if_occupied:nnT,
	pgfgo_kernel_board_if_occupied:nnF,
	pgfgo_kernel_board_if_occupied:nnTF,
	pgfgo_kernel_prisoners:n
}
\clist_const:Nn \c__pgfgo_kernel_territory_clist {
	pgfgo_kernel_territory:n
}
\clist_const:Nn \c__pgfgo_kernel_sgf_clist {
	pgfgo_kernel_sgf_read:n,
	pgfgo_kernel_sgf_read:nn,
	pgfgo_kernel_sgf_comment:n,
	pgfgo_kernel_sgf_marks:n,
	pgfgo_kernel_sgf_lines:n,
	pgfgo_kernel_sgf_variations:nn,
	pgfgo_kernel_sgf_annotations:n,
	pgfgo_kernel_sgf_name:n,
	pgfgo_kernel_sgf_label:n,
	pgfgo_kernel_sgf_info:nn,
	pgfgo_kernel_sgf_view:nn,
	pgfgo_kernel_sgf_tree:n
}


