%HACE QUE #1 (black, white O neutral) SEA EL JUGADOR ACTUAL.
\cs_new_protected:Npn \pgfgo_players_set_current:n #1 {
	\bool_set_false:N \l_pgfgo_players_black_bool
	\bool_set_false:N \l_pgfgo_players_white_bool
	\bool_set_false:N \l_pgfgo_players_neutral_bool
	\bool_set_true:c {l_pgfgo_players_ #1 _bool}
}

%LAS CLAVES black, b, white, w, neutral Y n DEL MODULO #1, EN EL GRUPO player-id: CADA UNA LLAMA A #2
%CON SU JUGADOR.
\cs_new_protected:Npn \pgfgo_players_define_id_keys:nN #1#2 {
	\clist_map_inline:nn {{black} {b}, {white} {w}, {neutral} {n}}
		{\__pgfgo_players_id_keys:nNnn {#1} #2 ##1}
}
\cs_new_protected:Npn \__pgfgo_players_id_keys:nNnn #1#2#3#4 {
	\keys_define:nn {#1} {
		#3		.code:n		= {#2 {#3}},
		#3		.groups:n	= {player-id},
		#4		.code:n		= {#2 {#3}},
		#4		.groups:n	= {player-id},
	}
}



\keys_define:nn {pgfgo / players} {
	all .code:n = {
		\keys_set:nn {pgfgo / players / neutral} 	{#1}
		\keys_set:nn {pgfgo / players / black} 		{#1}
		\keys_set:nn {pgfgo / players / white} 		{#1}
	}
}



