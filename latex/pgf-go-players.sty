	\tl_new:c		{l_pgfgo_players_ #1 _stone_image_width_tl}
	\tl_new:c		{l_pgfgo_players_ #1 _stone_image_rotate_tl}

	\keys_define:nn { pgfgo / players / #1 / stone / image } {
