	\keys_define:nn { pgfgo / players / #1 / mark / sequence } {
		true								.code:n			=	{\bool_set_true:c {l_pgfgo_players_ #1 _mark_sequence_bool}},
		false								.code:n			=	{\bool_set_false:c {l_pgfgo_players_ #1 _mark_sequence_bool}},
		use									.code:n			=	{\bool_set_true:c {l_pgfgo_players_ #1 _mark_sequence_bool}},
		%ALIAS DOCUMENTADO DE mark/label/format
		format							.code:n			= {
			\bool_set_true:c {l_pgfgo_players_ #1 _mark_sequence_bool}
			\keys_set:nn { pgfgo / players / #1 / mark / label } {format = ##1}
		},
		from								.code:n			= {
			\bool_set_true:c {l_pgfgo_players_ #1 _mark_sequence_bool}
			\int_set:cn {l_pgfgo_ #1 _mark_sequence_from_int} {##1}
			},
	}

	%LA FUNCION QUE COPIA LAS VARIABLES DEL JUGADOR EN LAS DEL JUGADOR ACTUAL.
	\cs_new_protected:cpe {__pgfgo_players_get_ #1 :}
		{\__pgfgo_players_fields:n {\__pgfgo_players_get_field:nnnn {#1}}}
}

