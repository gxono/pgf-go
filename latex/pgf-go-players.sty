%EL JUGADOR DE LA PIEDRA, LA JUGADA O LA MARCA ACTUAL: black, white O neutral.
\cs_new:Npn \__pgfgo_players_current: {
	\bool_if:NTF \l_pgfgo_players_black_bool {black}
		{\bool_if:NTF \l_pgfgo_players_white_bool {white} {neutral}}
}

\cs_new_protected:Npn \pgfgo_get_variables_from_current_player: {
	\use:c {__pgfgo_players_get_ \__pgfgo_players_current: :}
}
