		opacity			.initial:n	=	{1}
	}



	\bool_new:c				{l_pgfgo_players_ #1 _stone_drop_shadow_bool}
	\fp_new:c					{l_pgfgo_players_ #1 _stone_drop_shadow_angle_fp}
	\dim_new:c				{l_pgfgo_players_ #1 _stone_drop_shadow_offset_dim}
	\fp_new:c					{l_pgfgo_players_ #1 _stone_drop_shadow_opacity_fp}

	\keys_define:nn { pgfgo / players / #1 / stone / drop~shadow } {
