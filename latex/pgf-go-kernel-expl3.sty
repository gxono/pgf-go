%KERNEL DE CALCULO EN expl3 (EL KERNEL POR DEFECTO FUERA DE LuaLaTeX). LA INTERFAZ ESTA DESCRIPTA EN pgf-go-kernel.sty.
%NO SABE HACER CAPTURAS NI SGF.
\clist_gclear:N \g_pgfgo_kernel_features_clist

\__pgfgo_load_module:n {pgf-go-coordinate-parser}

\cs_generate_variant:Nn \int_from_alph:n {V, x, e}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%----------------------------------------TABLERO------------------------------------------------%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\seq_new:N \l__pgfgo_kernel_match_seq
\int_new:N \l__pgfgo_kernel_x_int
\tl_new:N \l__pgfgo_kernel_y_tl
\tl_new:N \l__pgfgo_kernel_to_tl

%VENTANA PEDIDA CON partial, ANTES DE RECORTARLA AL TABLERO.
\int_new:N \l__pgfgo_kernel_window_from_x_int
\int_new:N \l__pgfgo_kernel_window_from_y_int
\int_new:N \l__pgfgo_kernel_window_to_x_int
\int_new:N \l__pgfgo_kernel_window_to_y_int


\cs_new_protected:Npn \pgfgo_kernel_board_size:n #1 {
	\regex_extract_once:nnNTF {\A([\d]{1,2})\s*x\s*([\d]{1,2})\Z} {#1} \l__pgfgo_kernel_match_seq {
		\int_set:Nf \l_pgfgo_goban_size_x_int {\seq_item:Nn \l__pgfgo_kernel_match_seq {2}}
		\int_set:Nf \l_pgfgo_goban_size_y_int {\seq_item:Nn \l__pgfgo_kernel_match_seq {3}}
	}{
		\regex_extract_once:nnNTF {\A([\d]{1,2})\Z} {#1} \l__pgfgo_kernel_match_seq {
			\int_set:Nf \l_pgfgo_goban_size_x_int {\seq_item:Nn \l__pgfgo_kernel_match_seq {2}}
			\int_set:Nf \l_pgfgo_goban_size_y_int {\seq_item:Nn \l__pgfgo_kernel_match_seq {2}}
		}{
			\msg_error:nnn {pgfgo} {unknown-goban-key} {#1}
		}
	}
}


%COLUMNA Y FILA DE UNA COORDENADA COMO C3. DEJA \l__pgfgo_kernel_x_int Y \l__pgfgo_kernel_y_tl.
\cs_new_protected:Npn \__pgfgo_kernel_parse_coordinate:n #1 {
	\regex_extract_once:nnN {([A-Za-z]*)\s*(\d*)} {#1} \l__pgfgo_kernel_match_seq
	\int_set:Nn \l__pgfgo_kernel_x_int {\int_from_alph:e {\seq_item:Nn \l__pgfgo_kernel_match_seq {2}}}

	\bool_if:NF \l_pgfgo_use_i_bool {
		\int_compare:nNnT {\l__pgfgo_kernel_x_int} > {9} {
			\int_decr:N \l__pgfgo_kernel_x_int
		}
	}

	\tl_set:Ne \l__pgfgo_kernel_y_tl {\seq_item:Nn \l__pgfgo_kernel_match_seq {3}}
}
\cs_generate_variant:Nn \__pgfgo_kernel_parse_coordinate:n {e, V}


\cs_new_protected:Npn \pgfgo_kernel_board_window:n #1 {
	\regex_extract_once:nnN {
		\A\s*
		([a-zA-Z]{1}\s*\d{1,2})
		\s* to \s*
		([a-zA-Z]{1}\s*\d{1,2})
		\s*\Z
	}{#1} \l__pgfgo_kernel_match_seq

	\tl_set:Ne \l__pgfgo_kernel_to_tl {\seq_item:Nn \l__pgfgo_kernel_match_seq {3}}

	\__pgfgo_kernel_parse_coordinate:e {\seq_item:Nn \l__pgfgo_kernel_match_seq {2}}
	\int_set_eq:NN \l__pgfgo_kernel_window_from_x_int \l__pgfgo_kernel_x_int
	\int_set:Nn \l__pgfgo_kernel_window_from_y_int {\l__pgfgo_kernel_y_tl}

	\__pgfgo_kernel_parse_coordinate:V \l__pgfgo_kernel_to_tl
	\int_set_eq:NN \l__pgfgo_kernel_window_to_x_int \l__pgfgo_kernel_x_int
	\int_set:Nn \l__pgfgo_kernel_window_to_y_int {\l__pgfgo_kernel_y_tl}
}


\cs_new_protected:Npn \pgfgo_kernel_board_init: {
	\bool_if:NTF \l_pgfgo_goban_partial_bool {
		%LA VENTANA SE RECORTA AL TAMANO DEL TABLERO.
		\int_set:Nn \l_pgfgo_goban_from_x_int {\int_max:nn {1} {\int_min:nn {\l__pgfgo_kernel_window_from_x_int} {\l__pgfgo_kernel_window_to_x_int}}}
		\int_set:Nn \l_pgfgo_goban_from_y_int {\int_max:nn {1} {\int_min:nn {\l__pgfgo_kernel_window_from_y_int} {\l__pgfgo_kernel_window_to_y_int}}}
		\int_set:Nn \l_pgfgo_goban_to_x_int {\int_min:nn {\l_pgfgo_goban_size_x_int} {\int_max:nn {\l__pgfgo_kernel_window_from_x_int} {\l__pgfgo_kernel_window_to_x_int}}}
		\int_set:Nn \l_pgfgo_goban_to_y_int {\int_min:nn {\l_pgfgo_goban_size_y_int} {\int_max:nn {\l__pgfgo_kernel_window_from_y_int} {\l__pgfgo_kernel_window_to_y_int}}}
	}{
		\int_set:Nn \l_pgfgo_goban_from_x_int {1}
		\int_set:Nn \l_pgfgo_goban_from_y_int {1}
		\int_set_eq:NN \l_pgfgo_goban_to_x_int \l_pgfgo_goban_size_x_int
		\int_set_eq:NN \l_pgfgo_goban_to_y_int \l_pgfgo_goban_size_y_int
	}
}


\prg_new_protected_conditional:Npnn \pgfgo_kernel_if_visible:nn #1#2 {T, F, TF} {
	\bool_if:nTF {
		\int_compare_p:n {1 <= #1 <= \l_pgfgo_goban_size_x_int} &&
		\int_compare_p:n {1 <= #2 <= \l_pgfgo_goban_size_y_int}
	}{
		\bool_if:nTF {
			\int_compare_p:n {\l_pgfgo_goban_from_x_int <= #1 <= \l_pgfgo_goban_to_x_int} &&
			\int_compare_p:n {\l_pgfgo_goban_from_y_int <= #2 <= \l_pgfgo_goban_to_y_int}
		} {\prg_return_true:} {\prg_return_false:}
	}{
		\msg_warning:nnnn {pgfgo} {outside-board} {#1} {#2}
		\prg_return_false:
	}
}


\cs_new:Npn \pgfgo_kernel_column_name:n #1 {
	\int_to_Alph:n {#1 \bool_if:NF \l_pgfgo_use_i_bool {\int_compare:nNnT {#1} > {8} {+ 1}}}
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%--------------------------------------COORDENADAS----------------------------------------------%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \pgfgo_kernel_points:n #1 {
	\pgfgo_coordinate_parser_from_pgfgonce_to_items:n {#1}
	\seq_set_eq:NN \l_pgfgo_kernel_points_seq \l_pgfgo_coordinate_parser_items_from_pgfgonce_seq
}


\prg_new_protected_conditional:Npnn \pgfgo_kernel_point:n #1 {TF} {
	\regex_match:NnTF \c_pgfgo_coordinate_parser_subset_AN_regex {#1} {
		\pgfgo_coordinate_parser_from_group_to_items:n {#1}
		\tl_set:Ne \l_pgfgo_kernel_point_tl {\seq_item:Nn \l_pgfgo_coordinate_parser_items_from_group_seq {1}}
		\prg_return_true:
	}{
		\prg_return_false:
	}
}


%PUNTOS DE UN POLIGONO. LAS ARISTAS QUEDAN EN \l__pgfgo_kernel_edges_seq COMO {ax}{ay}{bx}{by}; UN PUNTO
%ESTA ADENTRO SI ESTA SOBRE UNA ARISTA O SI UN RAYO HACIA LA DERECHA CRUZA UNA CANTIDAD IMPAR DE ARISTAS.
%TODO CON ENTEROS.
\seq_new:N \l__pgfgo_kernel_vertices_seq
\seq_new:N \l__pgfgo_kernel_edges_seq
\bool_new:N \l__pgfgo_kernel_inside_bool
\bool_new:N \l__pgfgo_kernel_border_bool
\int_new:N \l__pgfgo_kernel_min_x_int
\int_new:N \l__pgfgo_kernel_max_x_int
\int_new:N \l__pgfgo_kernel_min_y_int
\int_new:N \l__pgfgo_kernel_max_y_int

\cs_new_protected:Npn \pgfgo_kernel_polygon:n #1 {
	\seq_clear:N \l_pgfgo_kernel_points_seq
	\seq_set_from_clist:Nn \l__pgfgo_kernel_vertices_seq {#1}
	\seq_if_empty:NF \l__pgfgo_kernel_vertices_seq {
		\seq_clear:N \l__pgfgo_kernel_edges_seq
		\int_set:Nn \l__pgfgo_kernel_min_x_int {\c_max_int}
		\int_set:Nn \l__pgfgo_kernel_max_x_int {-\c_max_int}
		\int_set:Nn \l__pgfgo_kernel_min_y_int {\c_max_int}
		\int_set:Nn \l__pgfgo_kernel_max_y_int {-\c_max_int}
		\seq_get_right:NN \l__pgfgo_kernel_vertices_seq \l_tmpa_tl
		\seq_map_inline:Nn \l__pgfgo_kernel_vertices_seq {
			\__pgfgo_kernel_polygon_edge:nnN ##1 \l_tmpa_tl
			\tl_set:Nn \l_tmpa_tl {##1}
		}
		\int_step_inline:nnn
			{\int_max:nn {1} {\l__pgfgo_kernel_min_y_int}}
			{\int_min:nn {\l_pgfgo_goban_size_y_int} {\l__pgfgo_kernel_max_y_int}}
			{
				\int_step_inline:nnn
					{\int_max:nn {1} {\l__pgfgo_kernel_min_x_int}}
					{\int_min:nn {\l_pgfgo_goban_size_x_int} {\l__pgfgo_kernel_max_x_int}}
					{\__pgfgo_kernel_polygon_point:nn {####1} {##1}}
			}
	}
}

%LA ARISTA QUE VA DEL VERTICE ANTERIOR (#3, {x}{y}) A (#1,#2).
\cs_new_protected:Npn \__pgfgo_kernel_polygon_edge:nnN #1#2#3 {
	\int_set:Nn \l__pgfgo_kernel_min_x_int {\int_min:nn {\l__pgfgo_kernel_min_x_int} {#1}}
	\int_set:Nn \l__pgfgo_kernel_max_x_int {\int_max:nn {\l__pgfgo_kernel_max_x_int} {#1}}
	\int_set:Nn \l__pgfgo_kernel_min_y_int {\int_min:nn {\l__pgfgo_kernel_min_y_int} {#2}}
	\int_set:Nn \l__pgfgo_kernel_max_y_int {\int_max:nn {\l__pgfgo_kernel_max_y_int} {#2}}
	\seq_put_right:Ne \l__pgfgo_kernel_edges_seq {\exp_not:V #3 {#1}{#2}}
}
\cs_new_protected:Npn \__pgfgo_kernel_polygon_point:nn #1#2 {
	\bool_set_false:N \l__pgfgo_kernel_inside_bool
	\bool_set_false:N \l__pgfgo_kernel_border_bool
	\seq_map_inline:Nn \l__pgfgo_kernel_edges_seq {\__pgfgo_kernel_polygon_test:nnnnnn {#1} {#2} ##1}
	\bool_if:nT {\l__pgfgo_kernel_inside_bool || \l__pgfgo_kernel_border_bool}
		{\seq_put_right:Nn \l_pgfgo_kernel_points_seq {{#1}{#2}}}
}

%(#1,#2) CONTRA LA ARISTA (#3,#4)-(#5,#6).
\cs_new_protected:Npn \__pgfgo_kernel_polygon_test:nnnnnn #1#2#3#4#5#6 {
	\bool_if:nT {
		\int_compare_p:nNn {(#5 - #3) * (#2 - #4) - (#6 - #4) * (#1 - #3)} = {0} &&
		\int_compare_p:n {\int_min:nn {#3} {#5} <= #1 <= \int_max:nn {#3} {#5}} &&
		\int_compare_p:n {\int_min:nn {#4} {#6} <= #2 <= \int_max:nn {#4} {#6}}
	} {\bool_set_true:N \l__pgfgo_kernel_border_bool}
	\bool_if:nT {
		(\int_compare_p:nNn {#4} > {#2} && ! \int_compare_p:nNn {#6} > {#2}) ||
		(\int_compare_p:nNn {#6} > {#2} && ! \int_compare_p:nNn {#4} > {#2})
	}{
		\bool_if:nT {
			(\int_compare_p:nNn {#6 - #4} > {0} &&
				\int_compare_p:nNn {(#1 - #3) * (#6 - #4)} < {(#2 - #4) * (#5 - #3)}) ||
			(\int_compare_p:nNn {#6 - #4} < {0} &&
				\int_compare_p:nNn {(#1 - #3) * (#6 - #4)} > {(#2 - #4) * (#5 - #3)})
		} {\bool_set:Nn \l__pgfgo_kernel_inside_bool {! \l__pgfgo_kernel_inside_bool}}
	}
}


