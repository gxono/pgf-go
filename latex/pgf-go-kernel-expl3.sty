%QUITA EL LADO QUE SALE DEL VERTICE ACTUAL HACIA \l__pgfgo_kernel_region_d_int.
\cs_new_protected:Npn \__pgfgo_kernel_region_remove: {
	\tl_set:Ne \l__pgfgo_kernel_region_key_tl
