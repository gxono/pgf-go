\bool_new:N \g__pgfgo_kernel_black_turn_bool
\bool_gset_true:N \g__pgfgo_kernel_black_turn_bool


\cs_new_protected:Npn \pgfgo_kernel_move_reset: {
	\int_gset:Nn \g__pgfgo_kernel_move_int {1}
	\bool_gset_true:N \g__pgfgo_kernel_black_turn_bool
}

\cs_new_protected:Npn \pgfgo_kernel_move_set_number:n #1 {
