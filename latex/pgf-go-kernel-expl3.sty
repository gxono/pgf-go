%LAS COORDENADAS SE EXPANDEN ANTES (COMO EN EL KERNEL lua).
\cs_new_protected:Npn \pgfgo_kernel_points:n #1 {
	\pgfgo_coordinate_parser_from_pgfgonce_to_items:e {#1}
	\seq_set_eq:NN \l_pgfgo_kernel_points_seq \l_pgfgo_coordinate_parser_items_from_pgfgonce_seq
}
\cs_generate_variant:Nn \pgfgo_coordinate_parser_from_pgfgonce_to_items:n {e}


\prg_new_protected_conditional:Npnn \pgfgo_kernel_point:n #1 {TF} {
	\regex_match:NnTF \c_pgfgo_coordinate_parser_subset_AN_regex {#1} {
		\pgfgo_coordinate_parser_from_group_to_items:n {#1}
		\tl_set:Ne \l_pgfgo_kernel_point_tl {\seq_item:Nn \l_pgfgo_coordinate_parser_items_from_group_seq {1}}
		\prg_return_true:
	}{
		\prg_return_false:
	}
}


%PUNTOS DE UN POLIGONO. LAS ARISTAS QUEDAN EN \l__pgfgo_kernel_edges_seq COMO {ax}{ay}{bx}{by}; UN PUNTO
%ESTA ADENTRO SI ESTA SOBRE UNA ARISTA O SI UN RAYO HACIA LA DERECHA CRUZA UNA CANTIDAD IMPAR DE ARISTAS.
%TODO CON ENTEROS.
\seq_new:N \l__pgfgo_kernel_vertices_seq
\seq_new:N \l__pgfgo_kernel_edges_seq
\bool_new:N \l__pgfgo_kernel_inside_bool
\bool_new:N \l__pgfgo_kernel_border_bool
\int_new:N \l__pgfgo_kernel_min_x_int
\int_new:N \l__pgfgo_kernel_max_x_int
\int_new:N \l__pgfgo_kernel_min_y_int
\int_new:N \l__pgfgo_kernel_max_y_int

\cs_new_protected:Npn \pgfgo_kernel_polygon:n #1 {
	\seq_clear:N \l_pgfgo_kernel_points_seq
	\seq_set_from_clist:Nn \l__pgfgo_kernel_vertices_seq {#1}
	\seq_if_empty:NF \l__pgfgo_kernel_vertices_seq {
		\seq_clear:N \l__pgfgo_kernel_edges_seq
		\int_set:Nn \l__pgfgo_kernel_min_x_int {\c_max_int}
		\int_set:Nn \l__pgfgo_kernel_max_x_int {-\c_max_int}
		\int_set:Nn \l__pgfgo_kernel_min_y_int {\c_max_int}
		\int_set:Nn \l__pgfgo_kernel_max_y_int {-\c_max_int}
		\seq_get_right:NN \l__pgfgo_kernel_vertices_seq \l_tmpa_tl
		\seq_map_inline:Nn \l__pgfgo_kernel_vertices_seq {
			\__pgfgo_kernel_polygon_edge:nnN ##1 \l_tmpa_tl
			\tl_set:Nn \l_tmpa_tl {##1}
		}
		\int_step_inline:nnn
			{\int_max:nn {1} {\l__pgfgo_kernel_min_y_int}}
			{\int_min:nn {\l_pgfgo_goban_size_y_int} {\l__pgfgo_kernel_max_y_int}}
			{
				\int_step_inline:nnn
					{\int_max:nn {1} {\l__pgfgo_kernel_min_x_int}}
					{\int_min:nn {\l_pgfgo_goban_size_x_int} {\l__pgfgo_kernel_max_x_int}}
					{\__pgfgo_kernel_polygon_point:nn {####1} {##1}}
			}
	}
}

%LA ARISTA QUE VA DEL VERTICE ANTERIOR (#3, {x}{y}) A (#1,#2).
\cs_new_protected:Npn \__pgfgo_kernel_polygon_edge:nnN #1#2#3 {
	\int_set:Nn \l__pgfgo_kernel_min_x_int {\int_min:nn {\l__pgfgo_kernel_min_x_int} {#1}}
	\int_set:Nn \l__pgfgo_kernel_max_x_int {\int_max:nn {\l__pgfgo_kernel_max_x_int} {#1}}
	\int_set:Nn \l__pgfgo_kernel_min_y_int {\int_min:nn {\l__pgfgo_kernel_min_y_int} {#2}}
	\int_set:Nn \l__pgfgo_kernel_max_y_int {\int_max:nn {\l__pgfgo_kernel_max_y_int} {#2}}
	\seq_put_right:Ne \l__pgfgo_kernel_edges_seq {\exp_not:V #3 {#1}{#2}}
}
\cs_new_protected:Npn \__pgfgo_kernel_polygon_point:nn #1#2 {
	\bool_set_false:N \l__pgfgo_kernel_inside_bool
	\bool_set_false:N \l__pgfgo_kernel_border_bool
	\seq_map_inline:Nn \l__pgfgo_kernel_edges_seq {\__pgfgo_kernel_polygon_test:nnnnnn {#1} {#2} ##1}
	\bool_if:nT {\l__pgfgo_kernel_inside_bool || \l__pgfgo_kernel_border_bool}
		{\seq_put_right:Nn \l_pgfgo_kernel_points_seq {{#1}{#2}}}
}

%(#1,#2) CONTRA LA ARISTA (#3,#4)-(#5,#6).
\cs_new_protected:Npn \__pgfgo_kernel_polygon_test:nnnnnn #1#2#3#4#5#6 {
	\bool_if:nT {
		\int_compare_p:nNn {(#5 - #3) * (#2 - #4) - (#6 - #4) * (#1 - #3)} = {0} &&
		\int_compare_p:n {\int_min:nn {#3} {#5} <= #1 <= \int_max:nn {#3} {#5}} &&
		\int_compare_p:n {\int_min:nn {#4} {#6} <= #2 <= \int_max:nn {#4} {#6}}
	} {\bool_set_true:N \l__pgfgo_kernel_border_bool}
	\bool_if:nT {
		(\int_compare_p:nNn {#4} > {#2} && ! \int_compare_p:nNn {#6} > {#2}) ||
		(\int_compare_p:nNn {#6} > {#2} && ! \int_compare_p:nNn {#4} > {#2})
	}{
		\bool_if:nT {
			(\int_compare_p:nNn {#6 - #4} > {0} &&
				\int_compare_p:nNn {(#1 - #3) * (#6 - #4)} < {(#2 - #4) * (#5 - #3)}) ||
			(\int_compare_p:nNn {#6 - #4} < {0} &&
				\int_compare_p:nNn {(#1 - #3) * (#6 - #4)} > {(#2 - #4) * (#5 - #3)})
		} {\bool_set:Nn \l__pgfgo_kernel_inside_bool {! \l__pgfgo_kernel_inside_bool}}
	}
}


%REGION: LAS CASILLAS PINTADAS ("x,y" DE SU ESQUINA DE ABAJO A LA IZQUIERDA) Y, POR VERTICE, LAS
%DIRECCIONES DE LOS LADOS QUE SALEN DE EL (0 ESTE, 1 NORTE, 2 OESTE, 3 SUR). EL METODO ESTA EXPLICADO EN
%pgfgo.region (pgf-go.lua); LOS DOS KERNELS DAN LO MISMO.
\prop_new:N \l__pgfgo_kernel_region_own_prop
\prop_new:N \l__pgfgo_kernel_region_cells_prop
\prop_new:N \l__pgfgo_kernel_region_out_prop
\seq_new:N \l__pgfgo_kernel_region_vertices_seq
\int_new:N \l__pgfgo_kernel_region_x_int
\int_new:N \l__pgfgo_kernel_region_y_int
\int_new:N \l__pgfgo_kernel_region_d_int
\int_new:N \l__pgfgo_kernel_region_last_int
\bool_new:N \l__pgfgo_kernel_region_found_bool
\tl_new:N \l__pgfgo_kernel_region_key_tl
\tl_new:N \l__pgfgo_kernel_region_tl

\cs_new_protected:Npn \pgfgo_kernel_region:n #1 {
	\prop_clear:N \l__pgfgo_kernel_region_own_prop
	\prop_clear:N \l__pgfgo_kernel_region_cells_prop
	\prop_clear:N \l__pgfgo_kernel_region_out_prop
	\seq_clear:N \l_pgfgo_kernel_region_seq
	\clist_map_inline:nn {#1} {\__pgfgo_kernel_region_own:nn ##1}
	\int_step_inline:nn {\l_pgfgo_goban_size_y_int - 1} {
		\int_step_inline:nn {\l_pgfgo_goban_size_x_int - 1} {\__pgfgo_kernel_region_cell:nn {####1} {##1}}
	}
	\int_step_inline:nn {\l_pgfgo_goban_size_y_int - 1} {
		\int_step_inline:nn {\l_pgfgo_goban_size_x_int - 1} {\__pgfgo_kernel_region_sides:nn {####1} {##1}}
	}
	\int_step_inline:nn {\l_pgfgo_goban_size_y_int} {
		\int_step_inline:nn {\l_pgfgo_goban_size_x_int} {\__pgfgo_kernel_region_start:nn {####1} {##1}}
	}
}

\cs_new_protected:Npn \__pgfgo_kernel_region_own:nn #1#2 {
	\prop_put:Nen \l__pgfgo_kernel_region_own_prop {\int_eval:n {#1}, \int_eval:n {#2}} {}
}
\cs_generate_variant:Nn \prop_put:Nnn {Nen}
\cs_generate_variant:Nn \prop_if_in_p:Nn {Ne}

\cs_new:Npn \__pgfgo_kernel_region_if_own_p:nn #1#2 {
	\prop_if_in_p:Ne \l__pgfgo_kernel_region_own_prop {\int_eval:n {#1}, \int_eval:n {#2}}
}
\cs_new:Npn \__pgfgo_kernel_region_if_painted_p:nn #1#2 {
	\prop_if_in_p:Ne \l__pgfgo_kernel_region_cells_prop {\int_eval:n {#1}, \int_eval:n {#2}}
}

\cs_new_protected:Npn \__pgfgo_kernel_region_cell:nn #1#2 {
	\bool_lazy_any:nT {
		{\__pgfgo_kernel_region_if_own_p:nn {#1} {#2}}
		{\__pgfgo_kernel_region_if_own_p:nn {#1 + 1} {#2}}
		{\__pgfgo_kernel_region_if_own_p:nn {#1} {#2 + 1}}
		{\__pgfgo_kernel_region_if_own_p:nn {#1 + 1} {#2 + 1}}
	} {\prop_put:Nnn \l__pgfgo_kernel_region_cells_prop {#1,#2} {}}
}

%LOS LADOS DE LA CASILLA (#1,#2), EN SENTIDO ANTIHORARIO, QUE NO TIENEN OTRA CASILLA PINTADA DEL OTRO LADO.
\cs_new_protected:Npn \__pgfgo_kernel_region_sides:nn #1#2 {
	\prop_if_in:NnT \l__pgfgo_kernel_region_cells_prop {#1,#2} {
		\bool_if:nF {\__pgfgo_kernel_region_if_painted_p:nn {#1} {#2 - 1}}
			{\__pgfgo_kernel_region_side:nnn {#1} {#2} {0}}
		\bool_if:nF {\__pgfgo_kernel_region_if_painted_p:nn {#1 + 1} {#2}}
			{\__pgfgo_kernel_region_side:nnn {#1 + 1} {#2} {1}}
		\bool_if:nF {\__pgfgo_kernel_region_if_painted_p:nn {#1} {#2 + 1}}
			{\__pgfgo_kernel_region_side:nnn {#1 + 1} {#2 + 1} {2}}
		\bool_if:nF {\__pgfgo_kernel_region_if_painted_p:nn {#1 - 1} {#2}}
			{\__pgfgo_kernel_region_side:nnn {#1} {#2 + 1} {3}}
	}
}
\cs_new_protected:Npn \__pgfgo_kernel_region_side:nnn #1#2#3 {
	\tl_set:Ne \l__pgfgo_kernel_region_key_tl {\int_eval:n {#1}, \int_eval:n {#2}}
	\prop_get:NVNF \l__pgfgo_kernel_region_out_prop \l__pgfgo_kernel_region_key_tl \l__pgfgo_kernel_region_tl
		{\tl_clear:N \l__pgfgo_kernel_region_tl}
	\prop_put:NVe \l__pgfgo_kernel_region_out_prop \l__pgfgo_kernel_region_key_tl
		{\exp_not:V \l__pgfgo_kernel_region_tl #3}
}
\cs_generate_variant:Nn \prop_put:Nnn {NVe}

%LOS CONTORNOS QUE EMPIEZAN EN EL VERTICE (#1,#2).
\cs_new_protected:Npn \__pgfgo_kernel_region_start:nn #1#2 {
	\prop_get:NnNT \l__pgfgo_kernel_region_out_prop {#1,#2} \l__pgfgo_kernel_region_tl {
		\tl_if_empty:NF \l__pgfgo_kernel_region_tl {
			\clist_map_inline:nn {3, 2, 1, 0} {
