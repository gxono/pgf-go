\tl_new:N \l__pgfgo_sgf_note_DO_ii_tl
\tl_set:Nn \l__pgfgo_sgf_note_DO_ii_tl {\l__pgfgo_sgf_note_DO_i_tl}
\tl_new:N \l__pgfgo_sgf_note_IT_ii_tl
\tl_set:Nn \l__pgfgo_sgf_note_IT_ii_tl {\l__pgfgo_sgf_note_IT_i_tl}

\keys_define:nn {pgfgo} {
	sgf~annotations				.code:n			= {\keys_set:nn {pgfgo / sgf~annotations} {#1}},
}

\cs_new_protected:Npn \__pgfgo_sgf_note:nn #1#2 {
	\str_if_eq:nnTF {#1} {N}
		{\seq_put_right:Nn \l__pgfgo_sgf_note_seq {\textbf{\pgfgo_kernel_sgf_name:n {#2}}}}
		{
			\cs_if_exist:cT {l__pgfgo_sgf_note_ #1 _ \int_to_roman:n {#2} _tl}
				{\seq_put_right:Nv \l__pgfgo_sgf_note_seq {l__pgfgo_sgf_note_ #1 _ \int_to_roman:n {#2} _tl}}
		}
}

%ESCRIBE EL COMENTARIO DE LA JUGADA #1 DE LA ULTIMA PARTIDA LEIDA (0: EL DE ANTES DE LA PRIMERA JUGADA).
\cs_new_protected:Npn \pgfgo_sgf_comment:n #1 {
	\seq_clear:N \l__pgfgo_sgf_note_seq
	\bool_if:NT \l__pgfgo_sgf_annotations_bool {
		\pgfgo_kernel_sgf_annotations:n {#1}
		\seq_map_inline:Nn \l_pgfgo_kernel_sgf_annotations_seq {\__pgfgo_sgf_note:nn ##1}
	}
	\seq_if_empty:NF \l__pgfgo_sgf_note_seq {
		\seq_use:Nn \l__pgfgo_sgf_note_seq {.~}.
		\tl_if_blank:eF {\pgfgo_kernel_sgf_comment:n {#1}} {~}
	}
	\pgfgo_kernel_sgf_comment:n {#1}
}

%VERDADERO SI LA JUGADA #1 TIENE COMENTARIO O ANOTACIONES.
\prg_new_protected_conditional:Npnn \__pgfgo_sgf_if_comment:n #1 {T} {
	\bool_if:NTF \l__pgfgo_sgf_annotations_bool
		{\pgfgo_kernel_sgf_annotations:n {#1}}
		{\seq_clear:N \l_pgfgo_kernel_sgf_annotations_seq}
	\bool_lazy_or:nnTF
		{! \seq_if_empty_p:N \l_pgfgo_kernel_sgf_annotations_seq}
		{! \tl_if_blank_p:e {\pgfgo_kernel_sgf_comment:n {#1}}}
		{\prg_return_true:} {\prg_return_false:}
}

%\sgfcomment[<opciones>]{<archivo>}{<jugada>} ESCRIBE EL COMENTARIO DE UNA JUGADA.
