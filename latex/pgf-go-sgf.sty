\cs_new_protected:Npn \__pgfgo_sgfanim_keep_move:nnn #1#2#3 {
	\__pgfgo_sgf_if_move:nnnT {#1} {#2} {#3}
		{\seq_put_right:Nn \l__pgfgo_sgfanim_moves_seq {{#1}{#2}{#3}}}
}

%LEE LA PARTIDA Y FIJA LOS CUADROS. SEPARADO DE \pgfgo_sgfanimation:nn PARA PODER DIBUJAR CUADROS SUELTOS.
\cs_new_protected:Npn \pgfgo_sgfanimation_setup:nn #1#2 {
	\keys_set:nn {pgfgo / sgf~animation} {#1}
	\bool_set_eq:NN \l__pgfgo_sgf_annotations_bool \l__pgfgo_sgfanim_annotations_bool
	%CADA CUADRO SIGUE LA PARTIDA DESDE EL ANTERIOR (VER \__pgfgo_sgf_play:).
	\__pgfgo_sgf_cache_begin:
	\tl_set:Nn \l__pgfgo_sgfanim_file_tl {#2}
	\exp_args:NnV \pgfgo_kernel_sgf_read:nn {#2} \l__pgfgo_sgfanim_variation_tl
	%LOS TABLEROS TIENEN EL TAMANO DE LA PARTIDA (goban = {...} PUEDE CAMBIARLO).
	\__pgfgo_sgf_size:N \l__pgfgo_sgfanim_size_tl
	%UN CUADRO POR JUGADA.
	\seq_clear:N \l__pgfgo_sgfanim_moves_seq
	\seq_map_inline:Nn \l_pgfgo_kernel_sgf_moves_seq {\__pgfgo_sgfanim_keep_move:nnn ##1}
	\int_set:Nn \l__pgfgo_sgfanim_to_int {
		\int_compare:nNnTF {\l__pgfgo_sgfanim_to_int} < {0}
			{\seq_count:N \l__pgfgo_sgfanim_moves_seq}
			{\int_min:nn {\l__pgfgo_sgfanim_to_int} {\seq_count:N \l__pgfgo_sgfanim_moves_seq}}
	}
	\int_set:Nn \l__pgfgo_sgfanim_from_int
		{\int_max:nn {0} {\int_min:nn {\l__pgfgo_sgfanim_from_int} {\l__pgfgo_sgfanim_to_int}}}
	%TODOS LOS CUADROS TIENEN EL MISMO TABLERO: SI LA VISTA (VW) CAMBIA, EL QUE ABARCA TODAS.
	\int_set_eq:NN \l_pgfgo_goban_sgf_view_from_int \l__pgfgo_sgfanim_from_int
	\int_set_eq:NN \l_pgfgo_goban_sgf_view_to_int \l__pgfgo_sgfanim_to_int
	\tl_set_eq:NN \l_pgfgo_goban_sgf_view_variation_tl \l__pgfgo_sgfanim_variation_tl
}

%MARCA LA JUGADA #2,#3 DE #1. UN PASE NO SE MARCA, NI UN PUNTO QUE YA MARCA EL ARCHIVO.
\cs_new_protected:Npn \__pgfgo_sgfanim_mark:nnn #1#2#3 {
	\tl_if_blank:nF {#2} {
		\__pgfgo_captures_key:nn {#2} {#3}
		\bool_lazy_and:nnF
			{\l__pgfgo_sgfanim_marks_bool}
			{\prop_if_in_p:NV \g__pgfgo_sgf_marked_prop \l__pgfgo_captures_key_tl}
			{
				\use:e {
					\exp_not:N \pgfgo_marks_parsed:nn
						{#1, \exp_not:V \l__pgfgo_sgfanim_last_tl} {\exp_not:n {{#2}{#3}}}
				}
			}
	}
}

%ARMA UN CUADRO (O UNA LAMINA): EL goban CON #1 ADENTRO Y, CON comments, EL COMENTARIO #2 DEBAJO.
\cs_new_protected:Npn \__pgfgo_sgfanim_wrap:nn #1#2 {
	\hbox_set:Nn \l__pgfgo_sgfanim_box {
		\use:e {
			\exp_not:N \begin{goban}
				[
					size = \l__pgfgo_sgfanim_size_tl,
					\bool_if:NT \l__pgfgo_sgfanim_view_bool {sgf~view = {\exp_not:V \l__pgfgo_sgfanim_file_tl},}
					\exp_not:V \l__pgfgo_sgfanim_goban_tl
				]
		}
			%CADA CUADRO ES UN TABLERO NUEVO: NO SE RECUERDA NADA.
			\pgfgo_goban_remember_nothing:
			#1
		\end{goban}
	}
	\bool_if:NTF \l__pgfgo_sgfanim_comments_bool {
		\vbox:n {
			\box_use:N \l__pgfgo_sgfanim_box
			\skip_vertical:n {0.5em}
			\hbox:n {
				%EL \strut DA LA MISMA ALTURA A LA PRIMERA LINEA, HAYA COMENTARIO O NO: TODOS LOS CUADROS
				%MIDEN LO MISMO (SI NO, animate LOS ESTIRA PARA QUE ENTREN EN LA ANIMACION).
				\parbox[t][\l__pgfgo_sgfanim_comment_height_dim][t]{\box_wd:N \l__pgfgo_sgfanim_box}
					{\raggedright \l__pgfgo_sgfanim_comment_font_tl \strut #2}
			}
		}
	}{
		\box_use:N \l__pgfgo_sgfanim_box
	}
}

%LA PARTIDA HASTA LA JUGADA #1, CON LA MARCA DE LA ULTIMA JUGADA.
\cs_new_protected:Npn \__pgfgo_sgfanim_game:n #1 {
	\bool_set:Nn \l__pgfgo_sgf_check_size_bool
		{\int_compare_p:nNn {#1} = {\l__pgfgo_sgfanim_from_int}}
	\use:e {
		\exp_not:N \pgfgo_sgf:nn
			{
				to = \int_eval:n {#1},
				from = \bool_if:NTF \l__pgfgo_sgfanim_numbers_bool {1} {\int_eval:n {#1 + 1}},
				variation = {\exp_not:V \l__pgfgo_sgfanim_variation_tl},
				marks = \bool_if:NTF \l__pgfgo_sgfanim_marks_bool {true} {false},
				step = {\exp_not:V \l__pgfgo_sgfanim_step_clist},
				restart = {
					from = \int_use:N \l__pgfgo_sgfanim_restart_from_int,
					\exp_not:V \l__pgfgo_sgfanim_restart_tl
				},
				numbers = true,
				last~mark = false
			}
			{\exp_not:V \l__pgfgo_sgfanim_file_tl}
	}
	\bool_if:nT {
		! \l__pgfgo_sgfanim_numbers_bool &&
		! \tl_if_empty_p:N \l__pgfgo_sgfanim_last_tl &&
		\int_compare_p:nNn {#1} > {0}
	}{
		\use:e {
			\exp_not:N \__pgfgo_sgfanim_mark:nnn
				\seq_item:Nn \l__pgfgo_sgfanim_moves_seq {#1}
		}
	}
}

%DIBUJA EL CUADRO #1: LA POSICION DESPUES DE LA JUGADA #1.
\cs_new_protected:Npn \pgfgo_sgfanimation_frame:n #1 {
	\group_begin:
	\mode_leave_vertical:
	\__pgfgo_sgfanim_wrap:nn {\__pgfgo_sgfanim_game:n {#1}} {\pgfgo_sgf_comment:n {#1}}
	\group_end:
}


%POR CAPAS (layers): CADA PIEDRA SE DIBUJA UNA SOLA VEZ, EN UNA LAMINA QUE animate MUESTRA (CON UN
%timeline) DESDE EL CUADRO EN QUE APARECE HASTA EL ULTIMO EN QUE SIGUE IGUAL. EL PDF CRECE CON LA CANTIDAD
%DE JUGADAS, Y NO CON SU CUADRADO. LAS LAMINAS SE NUMERAN EN EL ORDEN EN QUE SE ARMAN: LA 0 ES EL
%TABLERO; DESPUES, POR CADA CUADRO, LO QUE SOLO ESTA EN ESE CUADRO (MARCAS Y COMENTARIO) Y LAS PIEDRAS
%QUE APARECEN EN EL. TODAS TIENEN EL TAMANO DEL TABLERO.
\int_new:N \g__pgfgo_sgfanim_layer_int
\int_new:N \g__pgfgo_sgfanim_file_int
\tl_new:N \l__pgfgo_sgfanim_old_tl
%LAS PIEDRAS ("x,y" -> CODIGO) DEL CUADRO ANTERIOR Y DEL ACTUAL.
\prop_new:N \l__pgfgo_sgfanim_prev_prop
\prop_new:N \l__pgfgo_sgfanim_cur_prop
%LA FIRMA DE LO QUE SE DIBUJA EN CADA PUNTO ({codigo}{atenuada}{marcas}) Y EL CUADRO AL QUE PERTENECE
%("ANIMACION.CUADRO"), EN EL CUADRO ANTERIOR (old) Y EN EL ACTUAL (new): \l__pgfgo_sgfanim_old_sig_x,y_tl, ETC.
\int_new:N \g__pgfgo_sgfanim_run_int
\tl_new:N \l__pgfgo_sgfanim_stamp_tl
\tl_new:N \l__pgfgo_sgfanim_last_stamp_tl
\cs_new_protected:Npn \__pgfgo_sgfanim_point_vars:n #1 {
	\tl_if_exist:cF {l__pgfgo_sgfanim_old_sig_ #1 _tl} {
		\tl_new:c {l__pgfgo_sgfanim_old_sig_ #1 _tl}
		\tl_new:c {l__pgfgo_sgfanim_old_stamp_ #1 _tl}
		\tl_new:c {l__pgfgo_sgfanim_new_sig_ #1 _tl}
		\tl_new:c {l__pgfgo_sgfanim_new_stamp_ #1 _tl}
	}
}
%"x,y" -> LAMINA DE LA PIEDRA QUE SE VE AHORA, Y LAMINA -> CUADRO EN QUE APARECIO.
\prop_new:N \l__pgfgo_sgfanim_active_prop
\prop_new:N \l__pgfgo_sgfanim_start_prop
%"x,y" -> LAMINA DE LAS PIEDRAS QUE APARECEN EN EL CUADRO QUE SE ARMA.
\prop_new:N \g__pgfgo_sgfanim_new_prop
%{LAMINA}{CUADRO EN QUE APARECE}{CANTIDAD DE CUADROS} DE CADA PIEDRA, Y CUADRO -> LAMINA DEL CUADRO.
\seq_new:N \l__pgfgo_sgfanim_stones_seq
\prop_new:N \l__pgfgo_sgfanim_own_prop
\iow_new:N \g__pgfgo_sgfanim_iow
\tl_new:N \l__pgfgo_sgfanim_timeline_tl

%LAS CAPAS DE PGF DE LAS LAMINAS: EL TABLERO, Y TODO LO DEMAS.
\clist_const:Nn \c__pgfgo_sgfanim_board_layers_clist
	{pgfgo_layer_goban_border, pgfgo_layer_goban_grid, pgfgo_layer_goban_labels}
\clist_const:Nn \c__pgfgo_sgfanim_top_layers_clist
	{pgfgo_layer_territory, pgfgo_layer_mark_shadow, pgfgo_layer_stone, pgfgo_layer_stone_mark, pgfgo_layer_mark, main}

%GUARDA LA LAMINA SIGUIENTE (#1: goban, #2: COMENTARIO).
\cs_new_protected:Npn \__pgfgo_sgfanim_layer:nn #1#2 {
	\box_if_exist:cF {g__pgfgo_sgfanim_ \int_use:N \g__pgfgo_sgfanim_layer_int _box}
		{\box_new:c {g__pgfgo_sgfanim_ \int_use:N \g__pgfgo_sgfanim_layer_int _box}}
	\hbox_gset:cn {g__pgfgo_sgfanim_ \int_use:N \g__pgfgo_sgfanim_layer_int _box}
		{\__pgfgo_sgfanim_wrap:nn {#1} {#2}}
	\int_gincr:N \g__pgfgo_sgfanim_layer_int
}

%SIN goban/captures, LAS PIEDRAS SE GUARDAN IGUAL (PARA DIBUJARLAS EN SUS LAMINAS), PERO NO SE QUITA NINGUNA.
\cs_new_protected:Npn \__pgfgo_sgfanim_collect: {
	\bool_if:NF \l_pgfgo_goban_captures_bool {
		\bool_set_true:N \l_pgfgo_goban_captures_bool
		\bool_set_true:N \l_pgfgo_captures_collect_bool
		\pgfgo_captures_begin:
	}
}

%UNA PIEDRA QUE APARECE EN EL PUNTO #1 CON LA FIRMA #2: SU LAMINA.
\cs_new_protected:Npn \__pgfgo_sgfanim_new_stone:nn #1#2 {
	\prop_gput:Nne \g__pgfgo_sgfanim_new_prop {#1} {\int_use:N \g__pgfgo_sgfanim_layer_int}
	\__pgfgo_sgfanim_layer:nn {
		\__pgfgo_sgfanim_collect:
		\__pgfgo_sgfanim_put:nnnn {#1} #2
	} {}
}
\cs_new_protected:Npn \__pgfgo_sgfanim_put:nnnn #1#2#3#4 {
	\prop_gput:Nnn \g__pgfgo_captures_pending_prop {#1} {#2}
	\int_compare:nNnT {#3} = {1} {\prop_gput:Nnn \g__pgfgo_captures_faded_prop {#1} {}}
	\tl_if_empty:nF {#4} {\prop_gput:Nnn \g__pgfgo_captures_marks_prop {#1} {#4}}
}

%TERMINA LA LAMINA DE LA PIEDRA QUE SE VEIA EN #1; #2 ES EL ULTIMO CUADRO EN QUE SE VE.
\cs_new_protected:Npn \__pgfgo_sgfanim_end_stone:nn #1#2 {
	\prop_pop:NnNT \l__pgfgo_sgfanim_active_prop {#1} \l__pgfgo_sgfanim_old_tl {
		\seq_put_right:Ne \l__pgfgo_sgfanim_stones_seq {
			{\l__pgfgo_sgfanim_old_tl}
			{\prop_item:NV \l__pgfgo_sgfanim_start_prop \l__pgfgo_sgfanim_old_tl}
			{\int_eval:n {#2 - \prop_item:NV \l__pgfgo_sgfanim_start_prop \l__pgfgo_sgfanim_old_tl + 1}}
		}
	}
}

%EL CUADRO #1: SU LAMINA, Y LAS LAMINAS DE LAS PIEDRAS QUE CAMBIARON.
\cs_new_protected:Npn \__pgfgo_sgfanim_layers_frame:n #1 {
	\prop_put:Nne \l__pgfgo_sgfanim_own_prop {#1} {\int_use:N \g__pgfgo_sgfanim_layer_int}
	\group_begin:
		\bool_set_true:N \l_pgfgo_captures_overlay_bool
		\clist_set_eq:NN \l_pgfgo_goban_layers_clist \c__pgfgo_sgfanim_top_layers_clist
		\__pgfgo_sgfanim_layer:nn
			{\__pgfgo_sgfanim_collect: \__pgfgo_sgfanim_game:n {#1}}
			{\pgfgo_sgf_comment:n {#1}}
	\group_end:
	%LO QUE QUEDO EN CADA PUNTO (LAS PROPIEDADES DE LAS CAPTURAS SON GLOBALES; LAS LAMINAS DE LAS PIEDRAS
	%LAS VACIAN). LA FIRMA DE CADA PUNTO VA EN SU PROPIA VARIABLE, CON EL CUADRO AL QUE PERTENECE, PARA
	%COMPARAR LOS DOS CUADROS SIN BUSCAR EN LISTAS LARGAS.
	\tl_set:Ne \l__pgfgo_sgfanim_stamp_tl {\int_use:N \g__pgfgo_sgfanim_run_int . \int_eval:n {#1}}
	\tl_set:Ne \l__pgfgo_sgfanim_last_stamp_tl {\int_use:N \g__pgfgo_sgfanim_run_int . \int_eval:n {#1 - 1}}
	\prop_set_eq:NN \l__pgfgo_sgfanim_cur_prop \g__pgfgo_captures_pending_prop
	\prop_map_inline:Nn \l__pgfgo_sgfanim_cur_prop {
		\__pgfgo_sgfanim_point_vars:n {##1}
		\tl_set_eq:cN {l__pgfgo_sgfanim_new_stamp_ ##1 _tl} \l__pgfgo_sgfanim_stamp_tl
		\tl_set:ce {l__pgfgo_sgfanim_new_sig_ ##1 _tl} {
			{\exp_not:n {##2}}
			{\prop_if_in:NnTF \g__pgfgo_captures_faded_prop {##1} {1} {0}}
			{\prop_item:Nn \g__pgfgo_captures_marks_prop {##1}}
		}
	}
	%LAS PIEDRAS QUE YA NO SE VEN IGUAL TERMINAN EN EL CUADRO ANTERIOR.
	\prop_map_inline:Nn \l__pgfgo_sgfanim_prev_prop {
		\bool_lazy_and:nnF
			{\tl_if_eq_p:cN {l__pgfgo_sgfanim_new_stamp_ ##1 _tl} \l__pgfgo_sgfanim_stamp_tl}
			{\tl_if_eq_p:cc {l__pgfgo_sgfanim_new_sig_ ##1 _tl} {l__pgfgo_sgfanim_old_sig_ ##1 _tl}}
			{\__pgfgo_sgfanim_end_stone:nn {##1} {#1 - 1}}
	}
	%LAS QUE APARECEN O CAMBIAN, EMPIEZAN.
	\group_begin:
		\clist_set_eq:NN \l_pgfgo_goban_layers_clist \c__pgfgo_sgfanim_top_layers_clist
		\prop_map_inline:Nn \l__pgfgo_sgfanim_cur_prop {
			\bool_lazy_and:nnF
				{\tl_if_eq_p:cN {l__pgfgo_sgfanim_old_stamp_ ##1 _tl} \l__pgfgo_sgfanim_last_stamp_tl}
				{\tl_if_eq_p:cc {l__pgfgo_sgfanim_new_sig_ ##1 _tl} {l__pgfgo_sgfanim_old_sig_ ##1 _tl}}
				{\exp_args:Nnv \__pgfgo_sgfanim_new_stone:nn {##1} {l__pgfgo_sgfanim_new_sig_ ##1 _tl}}
		}
	\group_end:
	\prop_map_inline:Nn \l__pgfgo_sgfanim_cur_prop {
		\tl_set_eq:cc {l__pgfgo_sgfanim_old_stamp_ ##1 _tl} {l__pgfgo_sgfanim_new_stamp_ ##1 _tl}
		\tl_set_eq:cc {l__pgfgo_sgfanim_old_sig_ ##1 _tl} {l__pgfgo_sgfanim_new_sig_ ##1 _tl}
	}
	\prop_map_inline:Nn \g__pgfgo_sgfanim_new_prop {
		\prop_put:Nnn \l__pgfgo_sgfanim_active_prop {##1} {##2}
		\prop_put:Nnn \l__pgfgo_sgfanim_start_prop {##2} {#1}
	}
	\prop_gclear:N \g__pgfgo_sgfanim_new_prop
	\prop_set_eq:NN \l__pgfgo_sgfanim_prev_prop \l__pgfgo_sgfanim_cur_prop
}

%ARMA TODAS LAS LAMINAS (DESPUES DE \pgfgo_sgfanimation_setup:nn).
\cs_new_protected:Npn \pgfgo_sgfanimation_layers: {
	\int_gincr:N \g__pgfgo_sgfanim_run_int
	\int_gzero:N \g__pgfgo_sgfanim_layer_int
	\prop_clear:N \l__pgfgo_sgfanim_prev_prop
	\prop_clear:N \l__pgfgo_sgfanim_active_prop
	\prop_clear:N \l__pgfgo_sgfanim_start_prop
	\prop_clear:N \l__pgfgo_sgfanim_own_prop
	\seq_clear:N \l__pgfgo_sgfanim_stones_seq
	%LA LAMINA 0, EL TABLERO, DA EL TAMANO DE TODAS.
	\group_begin:
		\clist_set_eq:NN \l_pgfgo_goban_layers_clist \c__pgfgo_sgfanim_board_layers_clist
		\__pgfgo_sgfanim_layer:nn {} {}
	\group_end:
	\tl_set_eq:NN \l_pgfgo_goban_bbox_tl \g_pgfgo_goban_bbox_tl
	\int_step_inline:nnn {\l__pgfgo_sgfanim_from_int} {\l__pgfgo_sgfanim_to_int}
		{\__pgfgo_sgfanim_layers_frame:n {##1}}
	\prop_map_inline:Nn \l__pgfgo_sgfanim_active_prop
		{\__pgfgo_sgfanim_end_stone:nn {##1} {\l__pgfgo_sgfanim_to_int}}
}

%EL timeline DE animate: UNA LINEA POR CUADRO, CON TRES PILAS (TABLERO; PIEDRAS; LAMINA DEL CUADRO).
\cs_new_protected:Npn \__pgfgo_sgfanim_timeline:n #1 {
	\prop_clear:N \l_tmpa_prop
	\seq_map_inline:Nn \l__pgfgo_sgfanim_stones_seq {\__pgfgo_sgfanim_timeline_stone:nnn ##1}
	\iow_open:Nn \g__pgfgo_sgfanim_iow {#1}
	\int_step_inline:nnn {\l__pgfgo_sgfanim_from_int} {\l__pgfgo_sgfanim_to_int} {
		\iow_now:Ne \g__pgfgo_sgfanim_iow {
			::
			\int_compare:nNnT {##1} = {\l__pgfgo_sgfanim_from_int} {0x0}
			;
			\prop_item:Nn \l_tmpa_prop {##1}
			;
			\prop_item:Nn \l__pgfgo_sgfanim_own_prop {##1}
		}
	}
	\iow_close:N \g__pgfgo_sgfanim_iow
}
\cs_generate_variant:Nn \__pgfgo_sgfanim_timeline:n {V}
\cs_new_protected:Npn \__pgfgo_sgfanim_timeline_stone:nnn #1#2#3 {
	\prop_get:NnNTF \l_tmpa_prop {#2} \l_tmpa_tl
		{\prop_put:Nne \l_tmpa_prop {#2} {\l_tmpa_tl , #1x#3}}
		{\prop_put:Nnn \l_tmpa_prop {#2} {#1x#3}}
}

%EL CUADRO #1 ARMADO CON SUS LAMINAS, UNA SOBRE OTRA (PARA COMPROBAR QUE ES IGUAL AL CUADRO ENTERO).
\cs_new_protected:Npn \pgfgo_sgfanimation_layers_frame:n #1 {
	\mode_leave_vertical:
	\hbox:n {
		\hbox_overlap_right:n {\box_use:c {g__pgfgo_sgfanim_0_box}}
		\seq_map_inline:Nn \l__pgfgo_sgfanim_stones_seq {\__pgfgo_sgfanim_overlap:nnnn {#1} ##1}
		\box_use:c {g__pgfgo_sgfanim_ \prop_item:Nn \l__pgfgo_sgfanim_own_prop {#1} _box}
	}
}
\cs_new_protected:Npn \__pgfgo_sgfanim_overlap:nnnn #1#2#3#4 {
	\int_compare:nT {#3 <= #1 < #3 + #4}
		{\hbox_overlap_right:n {\box_use:c {g__pgfgo_sgfanim_ #2 _box}}}
}

%LA ANIMACION POR CAPAS: LAS LAMINAS, UNA POR CUADRO DE animate, Y EL timeline QUE DICE CUALES SE VEN.
\cs_new_protected:Npn \__pgfgo_sgfanim_layered: {
	\pgfgo_sgfanimation_layers:
	\int_gincr:N \g__pgfgo_sgfanim_file_int
	\tl_set:Ne \l__pgfgo_sgfanim_timeline_tl {\c_sys_jobname_str -pgfgo- \int_use:N \g__pgfgo_sgfanim_file_int .tln}
	%animate LEE EL timeline SIN COMILLAS: UN ESPACIO EN EL NOMBRE DEL ARCHIVO LO CORTA. LAS LLAVES
	%DE timeline = {...} PROTEGEN LAS COMAS Y LOS = DEL NOMBRE.
	\tl_replace_all:Nnn \l__pgfgo_sgfanim_timeline_tl {~} {_}
	\__pgfgo_sgfanim_timeline:V \l__pgfgo_sgfanim_timeline_tl
	\tl_clear:N \l_tmpb_tl
	\int_step_inline:nnn {0} {\g__pgfgo_sgfanim_layer_int - 2}
		{\tl_put_right:Nn \l_tmpb_tl {\box_use:c {g__pgfgo_sgfanim_ ##1 _box} \newframe}}
	\mode_leave_vertical:
	\use:e {
		\exp_not:N \begin{animateinline}
			[\exp_not:V \l__pgfgo_sgfanim_animate_tl, timeline = {\l__pgfgo_sgfanim_timeline_tl}]
			{\exp_not:V \l__pgfgo_sgfanim_fps_tl}
			\exp_not:V \l_tmpb_tl
			\exp_not:N \box_use:c {g__pgfgo_sgfanim_ \int_eval:n {\g__pgfgo_sgfanim_layer_int - 1} _box}
		\exp_not:N \end{animateinline}
	}
}

%LA ANIMACION SIN CAPAS: CADA CUADRO ES UN goban ENTERO.
\cs_new_protected:Npn \__pgfgo_sgfanim_frames: {
	\use:e {
		\exp_not:N \begin{animateinline}
			[\exp_not:V \l__pgfgo_sgfanim_animate_tl] {\exp_not:V \l__pgfgo_sgfanim_fps_tl}
		\exp_not:N \multiframe
			{\int_eval:n {\l__pgfgo_sgfanim_to_int - \l__pgfgo_sgfanim_from_int + 1}}
			{iPgfgoFrame = \int_use:N \l__pgfgo_sgfanim_from_int + 1}
			{\exp_not:N \pgfgo_sgfanimation_frame:n {\exp_not:N \iPgfgoFrame}}
		\exp_not:N \end{animateinline}
	}
}

\cs_new_protected:Npn \pgfgo_sgfanimation:nn #1#2 {
	\group_begin:
		\pgfgo_sgfanimation_setup:nn {#1} {#2}
		\bool_if:NTF \l__pgfgo_sgfanim_layers_bool
			{\__pgfgo_sgfanim_layered:}
			{\__pgfgo_sgfanim_frames:}
	\group_end:
}

\NewDocumentCommand{\sgfanimation}{O{}m}{
	\__pgfgo_sgf_if_kernel:n {
		\cs_if_exist:NTF \animateinline
			{\pgfgo_sgfanimation:nn {#1} {#2}}
			{\msg_error:nn {pgfgo} {sgf-animation-animate}}
	}
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%--------------------------------SERIE DE DIAGRAMAS---------------------------------------------%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%\sgfdiagrams[<opciones>]{<archivo>} DIBUJA LA PARTIDA COMO EN LOS LIBROS: UN DIAGRAMA CADA step JUGADAS
%(1-50, 51-100, ...). CADA UNO PARTE DE LA POSICION REAL (LAS JUGADAS ANTERIORES SIN NUMERO, CON LAS
%CAPTURAS), Y DEBAJO LLEVA SU EPIGRAFE ("Diagram 2 (51-100)") Y SUS NOTAS "N at M". SE USA FUERA DE goban.

\int_new:N \l__pgfgo_sgfdiag_from_int
\int_new:N \l__pgfgo_sgfdiag_to_int
\tl_new:N \l__pgfgo_sgfdiag_layout_tl
\tl_new:N \l__pgfgo_sgfdiag_goban_tl
\tl_new:N \l__pgfgo_sgfdiag_variation_tl
\tl_new:N \l__pgfgo_sgfdiag_title_tl
\tl_new:N \l__pgfgo_sgfdiag_font_tl
\bool_new:N \l__pgfgo_sgfdiag_numbers_bool
\tl_new:N \l__pgfgo_sgfdiag_last_tl
\bool_new:N \l__pgfgo_sgfdiag_notes_bool
\bool_new:N \l__pgfgo_sgfdiag_comments_bool
\bool_new:N \l__pgfgo_sgfdiag_view_bool
\bool_new:N \l__pgfgo_sgfdiag_figures_bool
\bool_new:N \l__pgfgo_sgfdiag_result_bool
\tl_new:N \l__pgfgo_sgfdiag_result_title_tl
\tl_new:N \l__pgfgo_sgfdiag_result_format_tl
\tl_new:N \l__pgfgo_sgfdiag_black_tl
\tl_new:N \l__pgfgo_sgfdiag_white_tl
%LA PARTIDA: EL ARCHIVO, SU TAMANO, SU komi, SUS JUGADAS Y LA ULTIMA QUE SE DIBUJA.
\tl_new:N \l__pgfgo_sgfdiag_file_tl
\tl_new:N \l__pgfgo_sgfdiag_size_tl
\tl_new:N \l__pgfgo_sgfdiag_komi_tl
\int_new:N \l__pgfgo_sgfdiag_total_int
\int_new:N \l__pgfgo_sgfdiag_last_int

\keys_define:nn {pgfgo / sgf~diagrams} {
	%LOS DIAGRAMAS SON LOS MISMOS (Y CON EL MISMO NUMERO) QUE SIN from: SOLO SE DIBUJAN LOS QUE TIENEN JUGADAS
	%DESDE from, Y EL PRIMERO EMPIEZA EN from.
	from						.int_set:N	= \l__pgfgo_sgfdiag_from_int,
	from						.initial:n	= {1},
	%last (-1): LA ULTIMA JUGADA.
	to							.code:n			= {\__pgfgo_sgf_set_to:Nnn \l__pgfgo_sgfdiag_to_int {-1} {#1}},
	to							.initial:n	= {last},
	%SIN numbers, LAS JUGADAS DE CADA DIAGRAMA NO LLEVAN NUMERO. last~mark: COMO EN \sgf, EN CADA DIAGRAMA.
	numbers					.bool_set:N	= \l__pgfgo_sgfdiag_numbers_bool,
	numbers					.default:n	= {true},
	numbers					.initial:n	= {true},
	last~mark				.code:n			= {
															\str_if_eq:nnTF {#1} {false}
																{\tl_clear:N \l__pgfgo_sgfdiag_last_tl}
																{\tl_set:Nn \l__pgfgo_sgfdiag_last_tl {#1}}
														},
	last~mark				.initial:n	= {false},
	goban						.tl_set:N		= \l__pgfgo_sgfdiag_goban_tl,
	variation				.tl_set:N		= \l__pgfgo_sgfdiag_variation_tl,
	notes						.bool_set:N	= \l__pgfgo_sgfdiag_notes_bool,
	notes						.default:n	= {true},
	notes						.initial:n	= {true},
	title						.tl_set:N		= \l__pgfgo_sgfdiag_title_tl,
	title						.initial:n	= {\pgfgo_text:n {diagram}},
	caption					.code:n			= {\keys_set:nn {pgfgo / sgf~diagrams / caption} {#1}},
	%LOS COMENTARIOS DE LAS JUGADAS DEL DIAGRAMA, DEBAJO DE SUS NOTAS.
	comments				.bool_set:N	= \l__pgfgo_sgfdiag_comments_bool,
	comments				.default:n	= {true},
	game						.code:n			= {\int_set:Nn \l_pgfgo_kernel_sgf_game_int {#1}},
	view						.bool_set:N	= \l__pgfgo_sgfdiag_view_bool,
	view						.default:n	= {true},
	view						.initial:n	= {true},
	%SI EL ARCHIVO TIENE FIGURAS (FG), CADA FIGURA ES UN DIAGRAMA (CON SU NOMBRE COMO EPIGRAFE).
	figures					.bool_set:N	= \l__pgfgo_sgfdiag_figures_bool,
	figures					.default:n	= {true},
	figures					.initial:n	= {true},
	annotations			.bool_set:N	= \l__pgfgo_sgfdiag_annotations_bool,
	annotations			.default:n	= {true},
	%EL RESULTADO Y EL PUNTAJE DEBAJO DEL ULTIMO DIAGRAMA.
	result					.code:n			= {\keys_set:nn {pgfgo / sgf~diagrams / result} {#1}},
	result					.default:n	= {true},
	black~name			.tl_set:N		= \l__pgfgo_sgfdiag_black_tl,
	black~name			.initial:n	= {\pgfgo_text:n {black}},
	white~name			.tl_set:N		= \l__pgfgo_sgfdiag_white_tl,
	white~name			.initial:n	= {\pgfgo_text:n {white}},
	%OPCIONES DE /pgfgo/layout SOLO PARA \sgfdiagrams (SE SUMAN A LAS DE TODO EL DOCUMENTO).
	layout					.code:n			= {\tl_put_right:Nn \l__pgfgo_sgfdiag_layout_tl {, #1}},
}

%{5, 10, 3}: DIAGRAMAS DE 5, 10, 3, 3, 3... JUGADAS. CON restart, DESDE EL SEGUNDO, CADA DIAGRAMA NUMERA
%DESDE restart/from.
\__pgfgo_sgf_numbering_keys:nnn {pgfgo / sgf~diagrams} {sgfdiag} {50}

\keys_define:nn {pgfgo / sgf~diagrams / caption} {
	font						.tl_set:N		= \l__pgfgo_sgfdiag_font_tl,
	font						.initial:n	= {\small},
}

\keys_define:nn {pgfgo / sgf~diagrams / result} {
	true						.code:n			= {\bool_set_true:N \l__pgfgo_sgfdiag_result_bool},
	false						.code:n			= {\bool_set_false:N \l__pgfgo_sgfdiag_result_bool},
	title						.tl_set:N		= \l__pgfgo_sgfdiag_result_title_tl,
	title						.initial:n	= {\pgfgo_text:n {result}},
	%text: EL RESULTADO EN PALABRAS ("Black wins by resignation"); raw: COMO ESTA EN EL ARCHIVO ("B+R").
	format					.choices:nn	= {text, raw} {\tl_set_eq:NN \l__pgfgo_sgfdiag_result_format_tl \l_keys_choice_tl},
	format					.initial:n	= {text},
}
\bool_set_true:N \l__pgfgo_sgfdiag_result_bool

\keys_define:nn {pgfgo} {
	sgf~diagrams		.code:n			= {\keys_set:nn {pgfgo / sgf~diagrams} {#1}}
}

%UN DIAGRAMA (DE \sgfdiagrams O DE \sgfproblem) SE ARMA EN \l__pgfgo_sgfdiag_cell_box: EL goban CON LAS
%JUGADAS #1 A #2 (NUMERADAS DESDE #1) DE LA LINEA \l__pgfgo_sgfdiag_variation_tl, Y DEBAJO EL EPIGRAFE #3 Y
%LO QUE DIGA #4 (SE EJECUTA DESPUES DEL goban). LAS OPCIONES DEL goban QUE ELIGEN LA PARTE VISIBLE ESTAN EN
%\l__pgfgo_sgfdiag_window_tl, Y restart EN \l__pgfgo_sgfdiag_sgf_restart_tl. EN LA GRILLA (VER pgf-go-layout.sty)
%EL DIAGRAMA TIENE EL ANCHO DE LA CELDA, Y CON fit TODOS LOS TABLEROS USAN LA ESCALA QUE LLENA LA CELDA CON
%EL PRIMERO (\l__pgfgo_sgfdiag_scale_tl). \l__pgfgo_sgfdiag_align_tl ES LA ALINEACION DE LO QUE VA DEBAJO.
\tl_new:N \l__pgfgo_sgfdiag_window_tl
\tl_new:N \l__pgfgo_sgfdiag_sgf_restart_tl
\tl_new:N \l__pgfgo_sgfdiag_scale_tl
\tl_new:N \l__pgfgo_sgfdiag_align_tl
\dim_new:N \l__pgfgo_sgfdiag_width_dim
\box_new:N \l__pgfgo_sgfdiag_box
\box_new:N \l__pgfgo_sgfdiag_caption_box
\box_new:N \l__pgfgo_sgfdiag_cell_box

%EMPIEZA UNA SERIE DE DIAGRAMAS DEL ARCHIVO #2, CON LAS OPCIONES DE layout #1.
\cs_new_protected:Npn \__pgfgo_sgfdiag_begin:Nn #1#2 {
	\pgfgo_layout_begin:V #1
	\tl_clear:N \l__pgfgo_sgfdiag_scale_tl
	\tl_set:Nn \l__pgfgo_sgfdiag_file_tl {#2}
}

\cs_new_protected:Npn \__pgfgo_sgfdiag_draw:nnnn #1#2#3#4 {
	\pgfgo_layout_if_fit:T {
		\tl_if_empty:NT \l__pgfgo_sgfdiag_scale_tl {
			\pgfgo_layout_fit:nN
				{
					\tl_set:Nn \l__pgfgo_sgfdiag_scale_tl {scale = ##1}
					\__pgfgo_sgfdiag_board:nn {#1} {#2}
				}
				\l__pgfgo_sgfdiag_box
			\tl_set:Ne \l__pgfgo_sgfdiag_scale_tl {scale = \l_pgfgo_layout_scale_tl}
		}
	}
	\__pgfgo_sgfdiag_board:nn {#1} {#2}
	\pgfgo_layout_if_grid:TF
		{
			\tl_set:Nn \l__pgfgo_sgfdiag_align_tl {\pgfgo_layout_par_align:}
			\dim_set_eq:NN \l__pgfgo_sgfdiag_width_dim \l_pgfgo_layout_cell_dim
			\vbox_set_top:Nn \l__pgfgo_sgfdiag_cell_box {
				\pgfgo_layout_place:n {\box_use:N \l__pgfgo_sgfdiag_box}
				\skip_vertical:n {0.3em}
				\__pgfgo_sgfdiag_below:nn {\pgfgo_layout_par_align:} {#3}
				#4
			}
		}
		{
			\tl_set:Nn \l__pgfgo_sgfdiag_align_tl {\centering}
			%EL EPIGRAFE NO SE CORTA: EL DIAGRAMA TIENE EL ANCHO DEL TABLERO O DEL EPIGRAFE, EL MAYOR.
			\hbox_set:Nn \l__pgfgo_sgfdiag_caption_box {\l__pgfgo_sgfdiag_font_tl #3}
			\dim_set:Nn \l__pgfgo_sgfdiag_width_dim
				{\dim_max:nn {\box_wd:N \l__pgfgo_sgfdiag_box} {\box_wd:N \l__pgfgo_sgfdiag_caption_box}}
			\vbox_set_top:Nn \l__pgfgo_sgfdiag_cell_box {
				\hbox_to_wd:nn {\l__pgfgo_sgfdiag_width_dim} {\hfil \box_use:N \l__pgfgo_sgfdiag_box \hfil}
				\skip_vertical:n {0.3em}
				\hbox_to_wd:nn {\l__pgfgo_sgfdiag_width_dim} {\hfil \box_use:N \l__pgfgo_sgfdiag_caption_box \hfil}
				#4
			}
		}
}
%EL MISMO DIAGRAMA, PUESTO EN LA DISPOSICION.
\cs_new_protected:Npn \__pgfgo_sgfdiag_add:nnnn #1#2#3#4 {
	\__pgfgo_sgfdiag_draw:nnnn {#1} {#2} {#3} {#4}
	\pgfgo_layout_add:N \l__pgfgo_sgfdiag_cell_box
}

%EL goban DEL DIAGRAMA (JUGADAS #1 A #2) EN \l__pgfgo_sgfdiag_box.
\cs_new_protected:Npn \__pgfgo_sgfdiag_board:nn #1#2 {
	\hbox_set:Nn \l__pgfgo_sgfdiag_box {
		\pgfgo_layout_restore_goban:
		\use:e {
			\exp_not:N \begin{goban}
				[
					size = \l__pgfgo_sgfdiag_size_tl, captures, notes,
					\exp_not:V \l__pgfgo_sgfdiag_window_tl,
					\exp_not:V \l__pgfgo_sgfdiag_goban_tl,
					\exp_not:V \l__pgfgo_sgfdiag_scale_tl
				]
		}
			\pgfgo_goban_remember_nothing:
			%COMO EN LOS LIBROS, LAS CAPTURAS DEL TRAMO NUMERADO NO SE QUITAN (SE VEN EN EL DIAGRAMA SIGUIENTE).
			\bool_set_true:N \l__pgfgo_sgf_keep_numbered_bool
			\tl_set_eq:NN \l__pgfgo_sgf_first_tl \l__pgfgo_sgfdiag_first_tl
			\use:e {
				\exp_not:N \pgfgo_sgf:nn
					{
						from = \int_eval:n {#1},
						to = \int_eval:n {#2},
						variation = {\exp_not:V \l__pgfgo_sgfdiag_variation_tl},
						restart = {\exp_not:V \l__pgfgo_sgfdiag_sgf_restart_tl},
						numbers = \bool_if:NTF \l__pgfgo_sgfdiag_numbers_bool {true} {false},
						last~mark = {\tl_if_empty:NTF \l__pgfgo_sgfdiag_last_tl {false} {\exp_not:V \l__pgfgo_sgfdiag_last_tl}}
					}
					{\exp_not:V \l__pgfgo_sgfdiag_file_tl}
			}
		\end{goban}
	}
}

%DEBAJO DEL EPIGRAFE: UN PARRAFO DEL ANCHO DEL DIAGRAMA (#1: \centering, \raggedright, ETC.).
\cs_new_protected:Npn \__pgfgo_sgfdiag_below:nn #1#2 {
	\hbox:n {\parbox[t]{\l__pgfgo_sgfdiag_width_dim} {#1 \l__pgfgo_sgfdiag_font_tl #2}}
}

%LAS NOTAS "N at M" Y LOS COMENTARIOS DE LAS JUGADAS #1 A #2.
\cs_new_protected:Npn \__pgfgo_sgfdiag_notes:nn #1#2 {
	\bool_if:nT {\l__pgfgo_sgfdiag_notes_bool && ! \seq_if_empty_p:N \g_pgfgo_move_notes_seq}
		{\__pgfgo_sgfdiag_below:nn {\l__pgfgo_sgfdiag_align_tl} {\pgfgomovenotes}}
	\bool_if:NT \l__pgfgo_sgfdiag_comments_bool {
		\__pgfgo_sgfdiag_below:nn {\raggedright} {
			\int_step_inline:nnn {#1} {#2} {
				\__pgfgo_sgf_if_comment:nT {##1}
					{\par \textbf{##1}:~\__pgfgo_sgf_comment_use:}
			}
		}
	}
}

%EL DIAGRAMA #1, CON LAS JUGADAS #2 A #3. #4: EL NUMERO DEL NOMBRE DE SU FIGURA (0: SIN NOMBRE).
\cs_new_protected:Npn \__pgfgo_sgfdiag_diagram:nnnn #1#2#3#4 {
	%LA VISTA QUE ABARCA LAS DE TODAS LAS JUGADAS DEL DIAGRAMA.
	\int_set:Nn \l_pgfgo_goban_sgf_view_from_int {#2}
	\int_set:Nn \l_pgfgo_goban_sgf_view_to_int {#3}
	\__pgfgo_sgfdiag_add:nnnn {#2} {#3}
		{
			\int_compare:nNnTF {#4} > {0}
				{\pgfgo_kernel_sgf_name:n {#4}}
				{\l__pgfgo_sgfdiag_title_tl \nobreakspace \int_eval:n {#1}}
			\nobreakspace (\int_eval:n {#2}--\int_eval:n {#3})
		}
		{
			\__pgfgo_sgfdiag_notes:nn {#2} {#3}
			\bool_lazy_and:nnT
				{\l__pgfgo_sgfdiag_result_bool}
				{\int_compare_p:nNn {#3} = {\l__pgfgo_sgfdiag_total_int}}
				{\__pgfgo_sgfdiag_result:}
		}
}

%EL DIAGRAMA #1 (JUGADAS #2 A #3, CON EL NOMBRE #4), SI TIENE JUGADAS DESDE from: EMPIEZA EN from O DESPUES.
%CON restart, SI NO EMPIEZA EN LA JUGADA 1, LA JUGADA #2 SE MUESTRA COMO restart/from (AUNQUE NO SE DIBUJE).
\tl_new:N \l__pgfgo_sgfdiag_first_tl
\cs_new_protected:Npn \__pgfgo_sgfdiag_range:nnnn #1#2#3#4 {
	\int_compare:nNnF {#3} < {\l__pgfgo_sgfdiag_from_int} {
		\bool_lazy_and:nnTF {\str_if_eq_p:Vn \l__pgfgo_sgfdiag_restart_tl {true}} {\int_compare_p:nNn {#2} > {1}}
			{
				\tl_set:Ne \l__pgfgo_sgfdiag_first_tl {
					\int_eval:n {
						\l__pgfgo_sgfdiag_restart_from_int + \int_max:nn {#2} {\l__pgfgo_sgfdiag_from_int} - (#2)
					}
				}
			}
			{\tl_clear:N \l__pgfgo_sgfdiag_first_tl}
		\__pgfgo_sgfdiag_diagram:nnnn {#1} {\int_max:nn {#2} {\l__pgfgo_sgfdiag_from_int}} {#3} {#4}
	}
}

%DEBAJO DEL ULTIMO DIAGRAMA: EL RESULTADO (RE) Y, SI EL ARCHIVO MARCA EL TERRITORIO (TB, TW), EL PUNTAJE DE
%CADA JUGADOR COMO EL DE \pgfgoscore (CON EL komi DE KM).
\tl_new:N \l__pgfgo_sgfdiag_re_tl
\cs_new_protected:Npn \__pgfgo_sgfdiag_result: {
	\tl_set:Ne \l__pgfgo_sgfdiag_re_tl {\exp_args:NV \pgfgo_kernel_sgf_info:nn \l__pgfgo_sgfdiag_file_tl {RE}}
	\bool_lazy_or:nnT
		{! \tl_if_blank_p:V \l__pgfgo_sgfdiag_re_tl}
		{! \prop_if_empty_p:N \g_pgfgo_territory_prop}
		{
			\__pgfgo_sgfdiag_below:nn {\l__pgfgo_sgfdiag_align_tl} {
				\l__pgfgo_sgfdiag_result_title_tl :~
				\tl_if_blank:VF \l__pgfgo_sgfdiag_re_tl {
					\str_if_eq:VnTF \l__pgfgo_sgfdiag_result_format_tl {raw}
						{\tl_use:N \l__pgfgo_sgfdiag_re_tl}
						{\exp_args:NV \__pgfgo_sgfdiag_result_text:n \l__pgfgo_sgfdiag_re_tl}
				}
				\prop_if_empty:NF \g_pgfgo_territory_prop {
					\tl_if_blank:VTF \l__pgfgo_sgfdiag_re_tl
						{\__pgfgo_sgfdiag_score:n {}}
						{\__pgfgo_sgfdiag_score:n {~(} )}
				}
			}
		}
}
\cs_new_protected:Npn \__pgfgo_sgfdiag_score:n #1 {
	#1
	\l__pgfgo_sgfdiag_black_tl \nobreakspace \pgfgoscore{black},~
	\l__pgfgo_sgfdiag_white_tl \nobreakspace \__pgfgo_sgfdiag_white_score:V \l__pgfgo_sgfdiag_komi_tl
}
\cs_new_protected:Npn \__pgfgo_sgfdiag_white_score:n #1 {\pgfgoscore[komi = {#1}]{white}}
\cs_generate_variant:Nn \__pgfgo_sgfdiag_white_score:n {V}

%EL RESULTADO #1 (RE) EN PALABRAS, CON LOS TEXTOS DEL IDIOMA (VER pgf-go-lang.sty): 0 O Draw, Void, ?, Y B+
%O W+ SEGUIDO DE NADA, DE LA DIFERENCIA, DE R (Resign), T (Time) O F (Forfeit). OTRA COSA SE ESCRIBE COMO ESTA.
%EN LOS TEXTOS, \pgfgowinner ES EL NOMBRE DEL GANADOR (black name O white name) Y \pgfgopoints LA DIFERENCIA.
\tl_new:N \l__pgfgo_sgfdiag_winner_tl
\tl_new:N \l__pgfgo_sgfdiag_points_tl
\seq_new:N \l__pgfgo_sgfdiag_re_seq
\NewDocumentCommand \pgfgowinner {} {\l__pgfgo_sgfdiag_winner_tl}
\NewDocumentCommand \pgfgopoints {} {\l__pgfgo_sgfdiag_points_tl}
\cs_new_protected:Npn \__pgfgo_sgfdiag_result_text:n #1 {
	\str_case_e:nnF {\str_lowercase:n {#1}} {
		{0}				{\pgfgo_text:n {draw}}
		{draw}		{\pgfgo_text:n {draw}}
		{void}		{\pgfgo_text:n {void}}
		{?}				{\pgfgo_text:n {unknown~result}}
	}{
		\regex_extract_once:nnNTF {\A([BbWw])\+(.*)\Z} {#1} \l__pgfgo_sgfdiag_re_seq
			{
				\str_if_eq:eeTF {\str_uppercase:f {\seq_item:Nn \l__pgfgo_sgfdiag_re_seq {2}}} {B}
					{\tl_set_eq:NN \l__pgfgo_sgfdiag_winner_tl \l__pgfgo_sgfdiag_black_tl}
					{\tl_set_eq:NN \l__pgfgo_sgfdiag_winner_tl \l__pgfgo_sgfdiag_white_tl}
				\tl_set:Ne \l__pgfgo_sgfdiag_points_tl {\seq_item:Nn \l__pgfgo_sgfdiag_re_seq {3}}
				\str_case_e:nnF {\str_lowercase:f {\l__pgfgo_sgfdiag_points_tl}} {
					{}				{\pgfgo_text:n {win}}
					{r}				{\pgfgo_text:n {win~by~resignation}}
					{resign}	{\pgfgo_text:n {win~by~resignation}}
					{t}				{\pgfgo_text:n {win~on~time}}
					{time}		{\pgfgo_text:n {win~on~time}}
					{f}				{\pgfgo_text:n {win~by~forfeit}}
					{forfeit}	{\pgfgo_text:n {win~by~forfeit}}
				}{
					\regex_match:nVTF {\A\d+(\.\d*)?\Z} \l__pgfgo_sgfdiag_points_tl
						{\pgfgo_text:n {win~by~points}}
						{#1}
				}
			}
			{#1}
	}
}

%UN DIAGRAMA POR FIGURA (FG): DESDE DONDE EMPIEZA HASTA LA JUGADA ANTERIOR A LA FIGURA SIGUIENTE. SI LA
%PRIMERA FIGURA NO EMPIEZA EN LA JUGADA 1, LAS JUGADAS ANTERIORES SON UN DIAGRAMA MAS.
\int_new:N \l__pgfgo_sgfdiag_count_int
\seq_new:N \l__pgfgo_sgfdiag_figures_seq
\cs_new_protected:Npn \__pgfgo_sgfdiag_figures: {
	\seq_set_eq:NN \l__pgfgo_sgfdiag_figures_seq \l_pgfgo_kernel_sgf_figures_seq
	\seq_get_left:NN \l__pgfgo_sgfdiag_figures_seq \l_tmpa_tl
	\int_compare:nNnT {\exp_after:wN \use_i:nn \l_tmpa_tl} > {1}
		{\seq_put_left:Nn \l__pgfgo_sgfdiag_figures_seq {{1}{0}}}
	\seq_put_right:Ne \l__pgfgo_sgfdiag_figures_seq {{\int_eval:n {\l__pgfgo_sgfdiag_last_int + 1}}{0}}
	\int_zero:N \l__pgfgo_sgfdiag_count_int
	\int_step_inline:nn {\seq_count:N \l__pgfgo_sgfdiag_figures_seq - 1} {
		\use:e {
			\exp_not:N \__pgfgo_sgfdiag_figure:nnnn
				\seq_item:Nn \l__pgfgo_sgfdiag_figures_seq {##1}
				\seq_item:Nn \l__pgfgo_sgfdiag_figures_seq {##1 + 1}
		}
	}
}
%#1#2: {JUGADA}{NOMBRE} DE LA FIGURA, #3#4: LOS DE LA SIGUIENTE.
\cs_new_protected:Npn \__pgfgo_sgfdiag_figure:nnnn #1#2#3#4 {
	\int_compare:nNnT {#1} < {#3} {
		\int_compare:nNnF {#1} > {\l__pgfgo_sgfdiag_last_int} {
			\int_incr:N \l__pgfgo_sgfdiag_count_int
			\__pgfgo_sgfdiag_range:nnnn {\l__pgfgo_sgfdiag_count_int} {#1}
				{\int_min:nn {#3 - 1} {\l__pgfgo_sgfdiag_last_int}} {#2}
		}
	}
}

%UN DIAGRAMA CADA step JUGADAS: EL DIAGRAMA n TIENE TANTAS COMO EL ELEMENTO n DE step (O EL ULTIMO).
\int_new:N \l__pgfgo_sgfdiag_start_int
\int_new:N \l__pgfgo_sgfdiag_length_int
\cs_new_protected:Npn \__pgfgo_sgfdiag_steps: {
	\clist_if_empty:NT \l__pgfgo_sgfdiag_step_clist {\clist_set:Nn \l__pgfgo_sgfdiag_step_clist {50}}
	\int_zero:N \l__pgfgo_sgfdiag_count_int
	\int_set:Nn \l__pgfgo_sgfdiag_start_int {1}
	\int_until_do:nNnn {\l__pgfgo_sgfdiag_start_int} > {\l__pgfgo_sgfdiag_last_int} {
		\int_incr:N \l__pgfgo_sgfdiag_count_int
		\int_set:Nn \l__pgfgo_sgfdiag_length_int {
			\int_max:nn {1} {
				\clist_item:Nn \l__pgfgo_sgfdiag_step_clist
					{\int_min:nn {\l__pgfgo_sgfdiag_count_int} {\clist_count:N \l__pgfgo_sgfdiag_step_clist}}
			}
		}
		\use:e {
			\exp_not:N \__pgfgo_sgfdiag_range:nnnn
				{\int_use:N \l__pgfgo_sgfdiag_count_int}
				{\int_use:N \l__pgfgo_sgfdiag_start_int}
				{\int_min:nn {\l__pgfgo_sgfdiag_start_int + \l__pgfgo_sgfdiag_length_int - 1} {\l__pgfgo_sgfdiag_last_int}}
				{0}
		}
		\int_add:Nn \l__pgfgo_sgfdiag_start_int {\l__pgfgo_sgfdiag_length_int}
	}
}

\cs_new_protected:Npn \pgfgo_sgfdiagrams:nn #1#2 {
	\group_begin:
		\keys_set:nn {pgfgo / sgf~diagrams} {#1}
		\bool_set_eq:NN \l__pgfgo_sgf_annotations_bool \l__pgfgo_sgfdiag_annotations_bool
		%CADA DIAGRAMA SIGUE LA PARTIDA DESDE EL ANTERIOR (VER \__pgfgo_sgf_play:).
		\__pgfgo_sgf_cache_begin:
		\__pgfgo_sgfdiag_begin:Nn \l__pgfgo_sgfdiag_layout_tl {#2}
		\exp_args:NnV \pgfgo_kernel_sgf_read:nn {#2} \l__pgfgo_sgfdiag_variation_tl
		\__pgfgo_sgf_size:N \l__pgfgo_sgfdiag_size_tl
		\tl_set_eq:NN \l__pgfgo_sgfdiag_komi_tl \l_pgfgo_kernel_sgf_komi_tl
		%CON true, CADA DIAGRAMA SE NUMERA CON \l__pgfgo_sgfdiag_first_tl: \sgf NO REINICIA.
		\tl_set:Ne \l__pgfgo_sgfdiag_sgf_restart_tl
			{\str_if_eq:VnTF \l__pgfgo_sgfdiag_restart_tl {auto} {auto} {false}}
		\tl_set:Ne \l__pgfgo_sgfdiag_window_tl {
			\bool_if:NT \l__pgfgo_sgfdiag_view_bool {sgf~view = {\exp_not:n {#2}}}
		}
		\tl_set_eq:NN \l_pgfgo_goban_sgf_view_variation_tl \l__pgfgo_sgfdiag_variation_tl
		\__pgfgo_sgf_count_moves:Nn \l__pgfgo_sgfdiag_total_int {\c_max_int}
		\int_set:Nn \l__pgfgo_sgfdiag_last_int {
			\int_compare:nNnTF {\l__pgfgo_sgfdiag_to_int} < {0}
				{\l__pgfgo_sgfdiag_total_int}
				{\int_min:nn {\l__pgfgo_sgfdiag_to_int} {\l__pgfgo_sgfdiag_total_int}}
		}
		\bool_lazy_and:nnTF {\l__pgfgo_sgfdiag_figures_bool} {! \seq_if_empty_p:N \l_pgfgo_kernel_sgf_figures_seq}
			{\__pgfgo_sgfdiag_figures:}
			{\__pgfgo_sgfdiag_steps:}
		\pgfgo_layout_end:
	\group_end:
}

\NewDocumentCommand{\sgfdiagrams}{O{}m}{
	\__pgfgo_sgf_if_kernel:n {\pgfgo_sgfdiagrams:nn {#1} {#2}}
}


