%\sgf[from = <n>, to = <m>]{<archivo>} DIBUJA UNA PARTIDA EN EL goban ACTUAL. SOLO CON kernel = lua.
%LAS PIEDRAS INICIALES (AB, AW) SON PIEDRAS COMO LAS DE \stones. LAS JUGADAS SON COMO LAS DE \moves:
%ANTES DE from SIN NUMERO, DESDE from NUMERADAS, Y DESPUES DE to NO SE JUEGAN. AL TERMINAR, EL NUMERO
%Y EL TURNO QUEDAN LISTOS PARA SEGUIR LA PARTIDA CON \moves.

%from Y to SON POSICIONES DE JUGADA EN EL ARCHIVO (1, 2, 3...). EL NUMERO QUE SE MUESTRA PUEDE SER OTRO:
%MN LO CAMBIA, Y restart LO REINICIA EN CADA TRAMO DE step JUGADAS (VER MAS ABAJO). restart = auto Y
%numbers = auto HACEN LO QUE DICE PM: CON PM[2] SE REINICIA CADA 100, Y CON PM[0] NO SE NUMERA.
\int_new:N \l__pgfgo_sgf_from_int
\int_new:N \l__pgfgo_sgf_to_int
\tl_new:N \l__pgfgo_sgf_last_mark_tl

%LA CLAVE to: #1 = #3, O #2 SI #3 ES last O UN NUMERO NEGATIVO (HASTA LA ULTIMA JUGADA).
\cs_new_protected:Npn \__pgfgo_sgf_set_to:Nnn #1#2#3 {
	\str_if_eq:nnTF {#3} {last}
		{\int_set:Nn #1 {#2}}
		{
			\int_compare:nNnTF {#3} < {0}
				{\int_set:Nn #1 {#2}}
				{\int_set:Nn #1 {#3}}
		}
}
\tl_new:N \l__pgfgo_sgf_variation_tl
\bool_new:N \l__pgfgo_sgf_marks_bool
\tl_new:N \l__pgfgo_sgf_numbers_tl
\tl_new:N \l__pgfgo_sgf_variations_tl
\tl_new:N \l__pgfgo_sgf_file_tl
%restart Y numbers YA RESUELTOS (CON auto, SEGUN PM). restart: 0, NO SE REINICIA; 1, EN CADA TRAMO DE step;
%2, CADA 100 (PM[2]).
\int_new:N \l__pgfgo_sgf_restart_int
\bool_new:N \l__pgfgo_sgf_numbers_bool
%POSICION DE LA JUGADA EN EL ARCHIVO, NUMERO SIN REINICIAR (SIGUE A MN) Y NUMERO QUE SE MUESTRA.
\int_new:N \l__pgfgo_sgf_count_int
\int_new:N \l__pgfgo_sgf_number_int
\int_new:N \l__pgfgo_sgf_shown_int
%LA ULTIMA JUGADA QUE SE MUESTRA.
\int_new:N \l__pgfgo_sgf_last_int
%SI LA JUGADA QUE SE DIBUJA LLEVA NUMERO.
\bool_new:N \l__pgfgo_sgf_numbered_bool
%LO USA \sgfdiagrams: DESDE from, LAS PIEDRAS CAPTURADAS NO SE QUITAN DEL DIBUJO.
\bool_new:N \l__pgfgo_sgf_keep_numbered_bool
%LO USA \sgfdiagrams: SI NO ESTA VACIO, LA JUGADA from SE MUESTRA CON ESE NUMERO, Y LAS SIGUIENTES SIGUEN
%DESDE AHI (SE SUMA \l__pgfgo_sgf_shift_int AL NUMERO).
\tl_new:N \l__pgfgo_sgf_first_tl
\int_new:N \l__pgfgo_sgf_shift_int
%LAS ANIMACIONES SOLO COMPRUEBAN EL TAMANO EN EL PRIMER CUADRO.
\bool_new:N \l__pgfgo_sgf_check_size_bool
\bool_set_true:N \l__pgfgo_sgf_check_size_bool
%LAS MARCAS Y LAS VARIANTES DE LA ULTIMA JUGADA QUE SE MUESTRA, Y "x,y" DE LOS PUNTOS QUE MARCAN.
\seq_new:N \l__pgfgo_sgf_marks_seq
\seq_new:N \l__pgfgo_sgf_variations_seq
\prop_new:N \g__pgfgo_sgf_marked_prop
\tl_new:N \l__pgfgo_sgf_mark_tl
\bool_new:N \l__pgfgo_sgf_remove_warned_bool

%LA NUMERACION DE \sgf, \sgfanimation Y \sgfdiagrams. LAS JUGADAS VAN EN TRAMOS DE step (UNA LISTA REPITE
%EL ULTIMO TAMANO; EN \sgfdiagrams, CADA TRAMO ES UN DIAGRAMA). restart: true, DESDE EL SEGUNDO TRAMO CADA
%UNO NUMERA DESDE from; false, LOS NUMEROS DE LA PARTIDA; auto, LO QUE PIDE PM (CON PM[2], CADA 100).
%from TAMBIEN PRENDE restart. #1: EL ARBOL DE CLAVES, #2: EL PREFIJO DE LAS VARIABLES, #3: step INICIAL.
%CLAVES: /pgfgo/{sgf, sgf animation, sgf diagrams}/{step, restart}
%CLAVES: /pgfgo/{sgf, sgf animation, sgf diagrams}/restart/{true, false, auto, from}
\cs_new_protected:Npn \__pgfgo_sgf_numbering_keys:nnn #1#2#3 {
	\clist_new:c {l__pgfgo_ #2 _step_clist}
	\tl_new:c {l__pgfgo_ #2 _restart_tl}
	\int_new:c {l__pgfgo_ #2 _restart_from_int}
	\keys_define:nn {#1} {
		step				.clist_set:c	= {l__pgfgo_ #2 _step_clist},
		step				.initial:n		= {#3},
		restart			.code:n				= {\keys_set:nn {#1 / restart} {##1}},
		restart			.default:n		= {true},
	}
	\keys_define:nn {#1 / restart} {
		true				.code:n				= {\tl_set:cn {l__pgfgo_ #2 _restart_tl} {true}},
		false				.code:n				= {\tl_set:cn {l__pgfgo_ #2 _restart_tl} {false}},
		auto				.code:n				= {\tl_set:cn {l__pgfgo_ #2 _restart_tl} {auto}},
		from				.code:n				= {
															\tl_set:cn {l__pgfgo_ #2 _restart_tl} {true}
															\int_set:cn {l__pgfgo_ #2 _restart_from_int} {##1}
														},
	}
	\tl_set:cn {l__pgfgo_ #2 _restart_tl} {auto}
	\int_set:cn {l__pgfgo_ #2 _restart_from_int} {1}
}
\__pgfgo_sgf_numbering_keys:nnn {pgfgo / sgf} {sgf} {100}

\keys_define:nn {pgfgo / sgf} {
	from				.int_set:N	= \l__pgfgo_sgf_from_int,
	from				.initial:n	= {1},
	%last (O UN NUMERO NEGATIVO): HASTA LA ULTIMA JUGADA.
	to					.code:n			= {\__pgfgo_sgf_set_to:Nnn \l__pgfgo_sgf_to_int {\c_max_int} {#1}},
	to					.initial:n	= {last},
	%OPCIONES DE UNA MARCA PARA LA ULTIMA JUGADA QUE SE MUESTRA. false: SIN MARCA.
	last~mark		.code:n			= {
												\str_if_eq:nnTF {#1} {false}
													{\tl_clear:N \l__pgfgo_sgf_last_mark_tl}
													{\tl_set:Nn \l__pgfgo_sgf_last_mark_tl {#1}}
											},
	last~mark		.initial:n	= {false},
	%2.1: EN LA PRIMERA BIFURCACION, LA SEGUNDA VARIANTE; EN LA SEGUNDA, LA PRIMERA.
	variation		.tl_set:N		= \l__pgfgo_sgf_variation_tl,
	marks				.bool_set:N	= \l__pgfgo_sgf_marks_bool,
	marks				.default:n	= {true},
	marks				.initial:n	= {true},
	numbers			.choices:nn	= {true, false, auto}
		{\tl_set_eq:NN \l__pgfgo_sgf_numbers_tl \l_keys_choice_tl},
	numbers			.default:n	= {true},
	numbers			.initial:n	= {auto},
	%LA PARTIDA DEL ARCHIVO (1 ES LA PRIMERA).
	game				.code:n			= {\int_set:Nn \l_pgfgo_kernel_sgf_game_int {#1}},
	%LAS VARIANTES DE LA ULTIMA JUGADA, COMO LETRAS: none, children, siblings O auto (LO QUE DICE ST).
	variations	.choices:nn	= {none, children, siblings, auto}
		{\tl_set_eq:NN \l__pgfgo_sgf_variations_tl \l_keys_choice_tl},
	variations	.default:n	= {auto},
	variations	.initial:n	= {none},
}

%\pgfgoset{sgf = {...}} FIJA LAS OPCIONES DE TODOS LOS \sgf (Y LA PARTIDA DE LOS DEMAS COMANDOS).
%sgf charset: LA CODIFICACION DE LOS ARCHIVOS QUE NO SON UTF-8 (auto: LA DE CA).
\keys_define:nn {pgfgo} {
	sgf					.code:n			= {\keys_set:nn {pgfgo / sgf} {#1}},
	sgf~charset	.tl_set:N		= \l_pgfgo_kernel_sgf_charset_tl,
}

\msg_new:nnn {pgfgo} {sgf-size}
	{The~game~in~'#1'~is~for~a~#2~board,~but~the~goban~is~#3.}
%AE: SOLO SE PUEDE QUITAR UNA PIEDRA CON goban/captures (LAS PIEDRAS SE DIBUJAN AL FINAL). SIN CAPTURAS,
%\sgf AVISA UNA VEZ.
\msg_new:nnn {pgfgo} {sgf-remove}
	{'#1'~removes~stones~(AE).~That~needs~goban/captures,~so~they~are~not~removed.}


%PIEDRAS INICIALES. #1: black O white. #2: LISTA DE {x}{y}.
\cs_new_protected:Npn \__pgfgo_sgf_stones:nn #1#2 {
	\tl_if_blank:nF {#2} {
		\bool_if:NT \l__pgfgo_sgf_cache_bool {\clist_map_inline:nn {#2} {\__pgfgo_sgf_cache_outside:nn ##1}}
		\bool_if:NT \l_pgfgo_goban_remember_stone_bool
			{\pgfgo_kernel_remember_push:n {\exp_not:N \pgfgo_stones_parsed:nn {#1} {\exp_not:n {#2}}}}
		\pgfgo_stones_parsed:nn {#1} {#2}
	}
}
\cs_generate_variant:Nn \__pgfgo_sgf_stones:nn {nV}

%LAS PIEDRAS INICIALES DE #1 (black O white), DE LA SECUENCIA #2 DEL KERNEL.
\cs_new_protected:Npn \__pgfgo_sgf_setup_stones:nN #1#2 {
	\clist_set_from_seq:NN \l_tmpa_clist #2
	\__pgfgo_sgf_stones:nV {#1} \l_tmpa_clist
}

%UN EVENTO DE LA PARTIDA: UNA JUGADA ({black | white}{x}{y}), UN CAMBIO DE UN NODO POSTERIOR A LA
%PRIMERA JUGADA ({add-black | add-white | remove}{x}{y}), UN NUMERO DE JUGADA ({number}{n}{}, POR MN) O
%UN TURNO ({player}{black | white}{}, POR PL). LAS JUGADAS, QUE SON LA MAYORIA, SE PRUEBAN PRIMERO.
\cs_new_protected:Npn \__pgfgo_sgf_event:nnn #1#2#3 {
	\str_case:nnF {#1} {
		{black}			{\__pgfgo_sgf_move:nnn {black} {#2} {#3}}
		{white}			{\__pgfgo_sgf_move:nnn {white} {#2} {#3}}
		{add-black}	{\__pgfgo_sgf_stones:nn {black} {{#2}{#3}}}
		{add-white}	{\__pgfgo_sgf_stones:nn {white} {{#2}{#3}}}
		{remove}		{\__pgfgo_sgf_remove:nn {#2} {#3}}
		{number}		{\int_set:Nn \l__pgfgo_sgf_number_int {#2 - 1}}
		{player}		{\pgfgo_kernel_move_set_player:n {#2}}
	}{
		\__pgfgo_sgf_move:nnn {#1} {#2} {#3}
	}
}

\cs_new_protected:Npn \__pgfgo_sgf_remove:nn #1#2 {
	\bool_if:nTF {\l_pgfgo_goban_captures_bool && ! \l_pgfgo_captures_collect_bool} {
		\bool_if:NT \l_pgfgo_goban_remember_stone_bool
			{\pgfgo_kernel_remember_push:n {\exp_not:N \pgfgo_captures_remove:nn {#1} {#2}}}
		\pgfgo_captures_remove:nn {#1} {#2}
	}{
		\bool_if:NF \l__pgfgo_sgf_remove_warned_bool {
			\msg_warning:nnV {pgfgo} {sgf-remove} \l__pgfgo_sgf_file_tl
			\bool_set_true:N \l__pgfgo_sgf_remove_warned_bool
		}
	}
}

%UNA JUGADA DE #1 (black O white) EN (#2,#3). x E y VACIOS: PASE.
\cs_new_protected:Npn \__pgfgo_sgf_move:nnn #1#2#3 {
	\bool_if:NT \l__pgfgo_sgf_cache_bool {
		\bool_lazy_and:nnT
			{\int_compare_p:nNn {\l__pgfgo_sgf_count_int + 1} = {\l__pgfgo_sgf_from_int}}
			{! \int_compare_p:nNn {\l__pgfgo_sgf_from_int} > {\l__pgfgo_sgf_to_int}}
			{\__pgfgo_sgf_save:nn {a} {\l__pgfgo_sgf_index_int}}
	}
	\int_incr:N \l__pgfgo_sgf_count_int
	\int_compare:nNnTF {\l__pgfgo_sgf_count_int} > {\l__pgfgo_sgf_to_int} {
		\int_decr:N \l__pgfgo_sgf_count_int
		\int_set_eq:NN \l__pgfgo_sgf_resume_int \l__pgfgo_sgf_index_int
		\seq_map_break:
	}{
		\int_incr:N \l__pgfgo_sgf_number_int
		\bool_lazy_and:nnT
			{! \tl_if_empty_p:N \l__pgfgo_sgf_first_tl}
			{\int_compare_p:nNn {\l__pgfgo_sgf_count_int} = {\l__pgfgo_sgf_from_int}}
			{\int_set:Nn \l__pgfgo_sgf_shift_int {\l__pgfgo_sgf_first_tl - \l__pgfgo_sgf_number_int}}
		\int_compare:nNnT {\l__pgfgo_sgf_restart_int} = {1} {\__pgfgo_sgf_block:n {\l__pgfgo_sgf_number_int}}
		\int_set:Nn \l__pgfgo_sgf_shown_int {
			\int_case:nnF {\l__pgfgo_sgf_restart_int}
				{
					{1} {
						\int_compare:nNnTF {\l__pgfgo_sgf_block_int} = {1}
							{\l__pgfgo_sgf_number_int}
							{\l__pgfgo_sgf_restart_from_int + \l__pgfgo_sgf_number_int - \l__pgfgo_sgf_block_int}
					}
					{2} {\int_mod:nn {\l__pgfgo_sgf_number_int - 1} {100} + 1}
				}
				{\l__pgfgo_sgf_number_int + \l__pgfgo_sgf_shift_int}
		}
		\pgfgo_kernel_move_set_number:n {\l__pgfgo_sgf_shown_int}
		\pgfgo_kernel_move_set_player:n {#1}
		\tl_if_blank:nTF {#2} {
			%UN PASE CUENTA, PERO NO SE DIBUJA.
			\pgfgo_kernel_move_set_number:n {\l__pgfgo_sgf_shown_int + 1}
			\pgfgo_kernel_move_set_player:n {\str_if_eq:nnTF {#1} {black} {white} {black}}
		}{
			\__pgfgo_sgf_stone:nnn {#1} {#2} {#3}
		}
	}
}

%LA PIEDRA DE UNA JUGADA. SIN NUMERO ANTES DE from, Y TAMPOCO SI UNA MARCA DEL ARCHIVO CAE EN ESE PUNTO
%(LA MARCA LO REEMPLAZA).
\cs_new_protected:Npn \__pgfgo_sgf_stone:nnn #1#2#3 {
	\bool_set:Nn \l__pgfgo_sgf_numbered_bool
		{! \int_compare_p:nNn {\l__pgfgo_sgf_count_int} < {\l__pgfgo_sgf_from_int}}
	\bool_set:Nn \l__pgfgo_captures_keep_bool
		{\l__pgfgo_sgf_keep_numbered_bool && \l__pgfgo_sgf_numbered_bool}
	\__pgfgo_captures_key:nn {#2} {#3}
	\bool_if:NT \l__pgfgo_sgf_cache_bool {\__pgfgo_sgf_cache_point:nn {#2} {#3}}
	\bool_set:Nn \l__pgfgo_sgf_numbered_bool {
		\l__pgfgo_sgf_numbers_bool && \l__pgfgo_sgf_numbered_bool &&
		! \prop_if_in_p:NV \g__pgfgo_sgf_marked_prop \l__pgfgo_captures_key_tl
	}
	\bool_if:NT \l_pgfgo_goban_remember_move_bool {
		\pgfgo_kernel_remember_push:n {
			\exp_not:N \pgfgo_move_parsed:nnn
				{
					\bool_if:nTF {\l__pgfgo_sgf_numbered_bool && \l_pgfgo_goban_remember_move_label_bool}
						{\exp_not:N \BooleanTrue} {\exp_not:N \BooleanFalse}
				}
				{from = \int_use:N \l__pgfgo_sgf_shown_int, #1}
				{{#2}{#3}}
		}
	}
	\bool_if:NTF \l__pgfgo_sgf_numbered_bool
		{\pgfgo_move:nnnn {\BooleanTrue} {} {#2} {#3}}
		{\pgfgo_move:nnnn {\BooleanFalse} {} {#2} {#3}}
}

%MARCAS DEL ARCHIVO (TR, SQ, CR, MA, LB; TB Y TW SON TERRITORIO): #1 FORMA, (#2,#3) PUNTO, #4 COLOR DE LA
%PIEDRA (black, white O neutral, PARA QUE LA MARCA SE VEA), #5 TEXTO DE LB.
\cs_new_protected:Npn \__pgfgo_sgf_mark:nnnnn #1#2#3#4#5 {
	\str_case:nnF {#1} {
		{black-territory}	{\__pgfgo_sgf_territory:nnn {black} {#2} {#3}}
		{white-territory}	{\__pgfgo_sgf_territory:nnn {white} {#2} {#3}}
		{selected}				{\__pgfgo_sgf_mark_draw:nnnnn {filled~square} {#2} {#3} {#4} {#5}}
	}{
		\__pgfgo_sgf_mark_draw:nnnnn {#1} {#2} {#3} {#4} {#5}
	}
}

%TB Y TW: TERRITORIO DE #1 EN (#2,#3), COMO EL DE \territory (CUENTA PARA \pgfgoscore). UNA PIEDRA DEL
%RIVAL EN ESE PUNTO ESTA MUERTA.
\cs_new_protected:Npn \__pgfgo_sgf_territory:nnn #1#2#3 {
	\__pgfgo_captures_key:nn {#2} {#3}
	\prop_get:NVNT \g_pgfgo_points_prop \l__pgfgo_captures_key_tl \l__pgfgo_sgf_mark_tl {
		\str_if_eq:eeT {\l__pgfgo_sgf_mark_tl} {\str_if_eq:nnTF {#1} {black} {white} {black}}
			{\prop_gput:NVe \g_pgfgo_points_prop \l__pgfgo_captures_key_tl {dead- \l__pgfgo_sgf_mark_tl}}
	}
	\bool_if:NT \l_pgfgo_goban_remember_territory_bool {
		\pgfgo_kernel_remember_push:n
			{\exp_not:N \pgfgo_territory_parsed:nnn {#1} {\l__pgfgo_territory_draw_tl} {{#2}{#3}}}
	}
	\pgfgo_territory_parsed:nVn {#1} \l__pgfgo_territory_draw_tl {{#2}{#3}}
}

\cs_new_protected:Npn \__pgfgo_sgf_mark_draw:nnnnn #1#2#3#4#5 {
	\tl_set:Ne \l__pgfgo_sgf_mark_tl {
		#4,
		\str_if_eq:nnTF {#1} {label}
			{custom = {\pgfgo_kernel_sgf_label:n {#5}}}
			{#1}
	}
	\__pgfgo_sgf_mark_put:Vn \l__pgfgo_sgf_mark_tl {{#2}{#3}}
}

%DIBUJA (Y RECUERDA) LA MARCA DE OPCIONES #1 EN EL PUNTO #2 ({x}{y}).
\cs_new_protected:Npn \__pgfgo_sgf_mark_put:nn #1#2 {
	\bool_if:NT \l_pgfgo_goban_remember_mark_bool
		{\pgfgo_kernel_remember_push:n {\exp_not:N \pgfgo_marks_parsed:nn {\exp_not:n {#1}} {#2}}}
	\pgfgo_marks_parsed:nn {#1} {#2}
}
\cs_generate_variant:Nn \__pgfgo_sgf_mark_put:nn {Vn}

%LA LETRA #4 DE UNA VARIANTE EN (#1,#2), EN EL COLOR #3 DE LA PIEDRA QUE HAY AHI.
\cs_new_protected:Npn \__pgfgo_sgf_variation:nnnn #1#2#3#4 {
	\__pgfgo_sgf_mark_put:nn {#3, custom = {#4}} {{#1}{#2}}
}

%FLECHAS Y LINEAS DEL ARCHIVO (AR, LN): #1 arrow O line, DE (#2,#3) A (#4,#5).
\cs_new_protected:Npn \__pgfgo_sgf_line:nnnnn #1#2#3#4#5 {
	\bool_if:NT \l_pgfgo_goban_remember_mark_bool
		{\pgfgo_kernel_remember_push:n {\exp_not:N \pgfgo_line_parsed:nnnnnn {#1} {} {#2} {#3} {#4} {#5}}}
	\pgfgo_line_parsed:nnnnnn {#1} {} {#2} {#3} {#4} {#5}
}

%LOS PUNTOS QUE MARCA EL ULTIMO NODO QUE SE MUESTRA. LOS PUNTOS ATENUADOS NO REEMPLAZAN EL NUMERO DE LA JUGADA.
\cs_new_protected:Npn \__pgfgo_sgf_marked_point:nnnnn #1#2#3#4#5 {
	\str_if_eq:nnF {#1} {dim} {
		\__pgfgo_captures_key:nn {#2} {#3}
		\prop_gput:NVn \g__pgfgo_sgf_marked_prop \l__pgfgo_captures_key_tl {}
	}
}

%restart Y numbers SEGUN LA OPCION Y, CON auto, SEGUN PM.
\cs_new_protected:Npn \__pgfgo_sgf_numbering: {
	\int_zero:N \l__pgfgo_sgf_restart_int
	\str_if_eq:VnT \l__pgfgo_sgf_restart_tl {true} {\int_set:Nn \l__pgfgo_sgf_restart_int {1}}
	\str_if_eq:VnT \l__pgfgo_sgf_restart_tl {auto} {
		\int_compare:nNnT {\l_pgfgo_kernel_sgf_print_int} = {2} {\int_set:Nn \l__pgfgo_sgf_restart_int {2}}
	}
	\clist_if_empty:NT \l__pgfgo_sgf_step_clist {\clist_set:Nn \l__pgfgo_sgf_step_clist {100}}
	\bool_set:Nn \l__pgfgo_sgf_numbers_bool {
		\str_if_eq_p:Vn \l__pgfgo_sgf_numbers_tl {true} ||
		(\str_if_eq_p:Vn \l__pgfgo_sgf_numbers_tl {auto} &&
			! \int_compare_p:nNn {\l_pgfgo_kernel_sgf_print_int} = {0})
	}
}

%EN \l__pgfgo_sgf_block_int, LA PRIMERA JUGADA DEL TRAMO DE step EN QUE CAE EL NUMERO #1. LOS TRAMOS QUE
%REPITEN EL ULTIMO TAMANO DE LA LISTA SE SALTAN DE UNA VEZ.
\int_new:N \l__pgfgo_sgf_block_int
\int_new:N \l__pgfgo_sgf_block_size_int
\int_new:N \l__pgfgo_sgf_block_index_int
\cs_new_protected:Npn \__pgfgo_sgf_block:n #1 {
	\int_set:Nn \l__pgfgo_sgf_block_int {1}
	\int_set:Nn \l__pgfgo_sgf_block_index_int {1}
	\__pgfgo_sgf_block_loop:n {#1}
}
\cs_new_protected:Npn \__pgfgo_sgf_block_loop:n #1 {
	\int_set:Nn \l__pgfgo_sgf_block_size_int {
		\int_max:nn {1} {
			\clist_item:Nn \l__pgfgo_sgf_step_clist
				{\int_min:nn {\l__pgfgo_sgf_block_index_int} {\clist_count:N \l__pgfgo_sgf_step_clist}}
		}
	}
	\int_compare:nNnT {#1} > {\l__pgfgo_sgf_block_int + \l__pgfgo_sgf_block_size_int - 1} {
		\int_compare:nNnTF {\l__pgfgo_sgf_block_index_int} < {\clist_count:N \l__pgfgo_sgf_step_clist}
			{
				\int_add:Nn \l__pgfgo_sgf_block_int {\l__pgfgo_sgf_block_size_int}
				\int_incr:N \l__pgfgo_sgf_block_index_int
				\__pgfgo_sgf_block_loop:n {#1}
			}
			{
				\int_add:Nn \l__pgfgo_sgf_block_int {
					\int_div_truncate:nn {#1 - \l__pgfgo_sgf_block_int} {\l__pgfgo_sgf_block_size_int}
						* \l__pgfgo_sgf_block_size_int
				}
			}
	}
}

%AVISA SI LA PARTIDA DEL ARCHIVO #1 NO ES DEL TAMANO DEL goban.
\cs_new_protected:Npn \__pgfgo_sgf_check_size:n #1 {
	\bool_lazy_and:nnF
		{\int_compare_p:nNn {\l_pgfgo_kernel_sgf_size_x_int} = {\l_pgfgo_goban_size_x_int}}
		{\int_compare_p:nNn {\l_pgfgo_kernel_sgf_size_y_int} = {\l_pgfgo_goban_size_y_int}}
		{
			\msg_warning:nnnee {pgfgo} {sgf-size} {#1}
				{\int_use:N \l_pgfgo_kernel_sgf_size_x_int x \int_use:N \l_pgfgo_kernel_sgf_size_y_int}
				{\int_use:N \l_pgfgo_goban_size_x_int x \int_use:N \l_pgfgo_goban_size_y_int}
		}
}

%LAS MARCAS Y LAS LETRAS DE LAS VARIANTES DE LA ULTIMA JUGADA QUE SE MUESTRA. SE AVERIGUAN ANTES DE JUGAR,
%PORQUE REEMPLAZAN LOS NUMEROS, Y SE DIBUJAN DESPUES.
\cs_new_protected:Npn \__pgfgo_sgf_marked: {
	\prop_gclear:N \g__pgfgo_sgf_marked_prop
	\seq_clear:N \l__pgfgo_sgf_marks_seq
	\bool_if:NT \l__pgfgo_sgf_marks_bool {
		\pgfgo_kernel_sgf_marks:n {\l__pgfgo_sgf_last_int}
		\seq_set_eq:NN \l__pgfgo_sgf_marks_seq \l_pgfgo_kernel_sgf_marks_seq
		\seq_map_inline:Nn \l__pgfgo_sgf_marks_seq {\__pgfgo_sgf_marked_point:nnnnn ##1}
	}
	\seq_clear:N \l__pgfgo_sgf_variations_seq
	\str_if_eq:VnF \l__pgfgo_sgf_variations_tl {none} {
		\exp_args:NnV \pgfgo_kernel_sgf_variations:nn {\l__pgfgo_sgf_last_int} \l__pgfgo_sgf_variations_tl
		\seq_set_eq:NN \l__pgfgo_sgf_variations_seq \l_pgfgo_kernel_sgf_variations_seq
		\seq_map_inline:Nn \l__pgfgo_sgf_variations_seq {\__pgfgo_sgf_marked_point:nnnnn {variation} ##1}
	}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%CON \l__pgfgo_sgf_cache_bool (\sgfanimation Y \sgfdiagrams, QUE DIBUJAN MUCHOS TABLEROS DE LA MISMA
%PARTIDA) UN \sgf NO VUELVE A JUGAR LA PARTIDA DESDE EL PRINCIPIO: SIGUE DESDE LA POSICION QUE GUARDO
%UN \sgf ANTERIOR. HAY DOS COPIAS: a, ANTES DE LA PRIMERA JUGADA NUMERADA (from), Y b, DESPUES DE LA
%ULTIMA (to). CADA UNA TIENE LO QUE DEJARON LAS JUGADAS: EL TABLERO DEL KERNEL, LO QUE SE VA A DIBUJAR
%(LAS PIEDRAS, LAS ATENUADAS Y LAS MARCAS), LOS PUNTOS DE \pgfgoscore, LAS NOTAS "N at M" Y EL NUMERO.
%
%UNA COPIA DE c JUGADAS SIRVE SI ES DEL MISMO ARCHIVO, CON LAS MISMAS OPCIONES Y EL MISMO TABLERO (EL
%CONTEXTO), SI to NO ES MENOR QUE c, SI LAS JUGADAS 1 A c SON LAS MISMAS NUMERADAS (from IGUAL, O LOS DOS
%MAYORES QUE c), Y SI NINGUNA DE ESAS JUGADAS NUMERADAS CAE EN UN PUNTO QUE MARCA EL ULTIMO NODO (LA
%MARCA LE QUITA EL NUMERO). NO SE GUARDA NADA SI HUBO UN AVISO (PARA QUE CADA TABLERO AVISE IGUAL).
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\bool_new:N \l__pgfgo_sgf_cache_bool
\tl_new:N \l__pgfgo_sgf_context_tl
%EL EVENTO QUE SE JUEGA, Y EL PRIMERO QUE NO SE JUGO (DONDE SIGUE UNA COPIA).
\int_new:N \l__pgfgo_sgf_index_int
\int_new:N \l__pgfgo_sgf_resume_int
\int_new:N \l__pgfgo_sgf_start_int
%"x,y" DE LAS JUGADAS NUMERADAS (ANTES DE LAS MARCAS), Y SI UN PUNTO QUEDO FUERA DEL TABLERO.
\prop_new:N \l__pgfgo_sgf_numbered_prop
\bool_new:N \l__pgfgo_sgf_outside_bool
\tl_new:N \l__pgfgo_sgf_slot_tl
\clist_map_inline:nn {a, b} {
	\tl_new:c {g__pgfgo_sgf_#1_context_tl}
	\int_new:c {g__pgfgo_sgf_#1_count_int}
	\int_new:c {g__pgfgo_sgf_#1_index_int}
	\int_new:c {g__pgfgo_sgf_#1_from_int}
	\int_new:c {g__pgfgo_sgf_#1_number_int}
	\int_new:c {g__pgfgo_sgf_#1_shift_int}
	\seq_new:c {g__pgfgo_sgf_#1_captured_seq}
	\seq_new:c {g__pgfgo_sgf_#1_notes_seq}
	\clist_map_inline:nn {numbered, pending, faded, marks, points, notes_number, notes_code}
		{\prop_new:c {g__pgfgo_sgf_#1_##1_prop}}
}

%BORRA LAS COPIAS (AL EMPEZAR CADA \sgfanimation O \sgfdiagrams).
\cs_new_protected:Npn \__pgfgo_sgf_cache_begin: {
	\bool_set_true:N \l__pgfgo_sgf_cache_bool
	\tl_gclear:c {g__pgfgo_sgf_a_context_tl}
	\tl_gclear:c {g__pgfgo_sgf_b_context_tl}
}

%UN PUNTO FUERA DEL TABLERO DA UN AVISO.
\cs_new_protected:Npn \__pgfgo_sgf_cache_outside:nn #1#2 {
	\bool_lazy_and:nnF
		{\int_compare_p:n {1 <= #1 <= \l_pgfgo_goban_size_x_int}}
		{\int_compare_p:n {1 <= #2 <= \l_pgfgo_goban_size_y_int}}
		{\bool_set_true:N \l__pgfgo_sgf_outside_bool}
}

%LA PIEDRA DE UNA JUGADA EN (#1,#2), CON \l__pgfgo_captures_key_tl Y \l__pgfgo_sgf_numbered_bool LISTOS.
\cs_new_protected:Npn \__pgfgo_sgf_cache_point:nn #1#2 {
	\__pgfgo_sgf_cache_outside:nn {#1} {#2}
	\bool_if:nT {\l__pgfgo_sgf_numbers_bool && \l__pgfgo_sgf_numbered_bool}
		{\prop_put:NVn \l__pgfgo_sgf_numbered_prop \l__pgfgo_captures_key_tl {}}
}

%VERDADERO SI ALGUNA JUGADA NUMERADA DE LA PROP #1 CAE EN UN PUNTO MARCADO.
\prg_new_conditional:Npnn \__pgfgo_sgf_if_marked_conflict:N #1 {TF} {
	\bool_set_false:N \l_tmpa_bool
	\prop_map_inline:Nn \g__pgfgo_sgf_marked_prop {
		\prop_if_in:NnT #1 {##1} {\bool_set_true:N \l_tmpa_bool \prop_map_break:}
	}
	\bool_if:NTF \l_tmpa_bool {\prg_return_true:} {\prg_return_false:}
}
\prg_generate_conditional_variant:Nnn \__pgfgo_sgf_if_marked_conflict:N {c} {TF}

%EL CONTEXTO DEL \sgf QUE EMPIEZA (DESPUES DE LEER LA PARTIDA Y DE \__pgfgo_sgf_numbering:).
\cs_new_protected:Npn \__pgfgo_sgf_context: {
	\tl_set:Ne \l__pgfgo_sgf_context_tl {
		{\exp_not:V \l__pgfgo_sgf_file_tl}
		{\exp_not:V \l__pgfgo_sgf_variation_tl}
		{\exp_not:V \l_pgfgo_kernel_sgf_charset_tl}
		{
			\int_use:N \l_pgfgo_kernel_sgf_game_int ,
			\int_use:N \l_pgfgo_goban_size_x_int , \int_use:N \l_pgfgo_goban_size_y_int ,
			\int_use:N \l_pgfgo_goban_from_x_int , \int_use:N \l_pgfgo_goban_to_x_int ,
			\int_use:N \l_pgfgo_goban_from_y_int , \int_use:N \l_pgfgo_goban_to_y_int ,
			\int_use:N \l__pgfgo_sgf_restart_int ,
			\int_use:N \l__pgfgo_sgf_restart_from_int ,
			\clist_use:Nn \l__pgfgo_sgf_step_clist {;} ,
			\tl_use:N \l__pgfgo_sgf_first_tl
		}
		\bool_to_str:N \l_pgfgo_goban_captures_bool
		\bool_to_str:N \l_pgfgo_captures_collect_bool
		\bool_to_str:N \l_pgfgo_goban_captures_fade_bool
		\bool_to_str:N \l_pgfgo_goban_notes_bool
		\bool_to_str:N \l__pgfgo_sgf_numbers_bool
		\bool_to_str:N \l__pgfgo_sgf_keep_numbered_bool
	}
}

%GUARDA LA COPIA #1 (a O b), QUE SIGUE EN EL EVENTO #2.
\cs_new_protected:Npn \__pgfgo_sgf_save:nn #1#2 {
	\bool_if:nF {
		\g__pgfgo_captures_warned_bool || \l__pgfgo_sgf_remove_warned_bool || \l__pgfgo_sgf_outside_bool
	}{
		\__pgfgo_sgf_if_marked_conflict:NTF \l__pgfgo_sgf_numbered_prop {
			\tl_gclear:c {g__pgfgo_sgf_#1_context_tl}
		}{
			\tl_gset_eq:cN {g__pgfgo_sgf_#1_context_tl} \l__pgfgo_sgf_context_tl
			\int_gset_eq:cN {g__pgfgo_sgf_#1_count_int} \l__pgfgo_sgf_count_int
			\int_gset:cn {g__pgfgo_sgf_#1_index_int} {#2}
			\int_gset:cn {g__pgfgo_sgf_#1_from_int}
				{\int_min:nn {\l__pgfgo_sgf_from_int} {\l__pgfgo_sgf_count_int + 1}}
			\int_gset_eq:cN {g__pgfgo_sgf_#1_number_int} \l__pgfgo_sgf_number_int
			\int_gset_eq:cN {g__pgfgo_sgf_#1_shift_int} \l__pgfgo_sgf_shift_int
			\seq_gset_eq:cN {g__pgfgo_sgf_#1_captured_seq} \l_pgfgo_kernel_captured_seq
			\seq_gset_eq:cN {g__pgfgo_sgf_#1_notes_seq} \g_pgfgo_move_notes_seq
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_numbered_prop} \l__pgfgo_sgf_numbered_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_pending_prop} \g__pgfgo_captures_pending_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_faded_prop} \g__pgfgo_captures_faded_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_marks_prop} \g__pgfgo_captures_marks_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_points_prop} \g_pgfgo_points_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_notes_number_prop} \g__pgfgo_notes_number_prop
			\prop_gset_eq:cN {g__pgfgo_sgf_#1_notes_code_prop} \g__pgfgo_notes_code_prop
			\pgfgo_kernel_board_save:n {sgf-#1}
		}
	}
}

%DEJA EN \l__pgfgo_sgf_slot_tl LA COPIA QUE SIRVE (LA DE MAS JUGADAS), O NADA.
\cs_new_protected:Npn \__pgfgo_sgf_choose: {
	\tl_clear:N \l__pgfgo_sgf_slot_tl
	\clist_map_inline:nn {a, b} {
		\bool_lazy_all:nT {
			{\tl_if_eq_p:Nc \l__pgfgo_sgf_context_tl {g__pgfgo_sgf_##1_context_tl}}
			{! \int_compare_p:nNn {\int_use:c {g__pgfgo_sgf_##1_count_int}} > {\l__pgfgo_sgf_to_int}}
			{
				\int_compare_p:nNn {\int_use:c {g__pgfgo_sgf_##1_from_int}} =
					{\int_min:nn {\l__pgfgo_sgf_from_int} {\int_use:c {g__pgfgo_sgf_##1_count_int} + 1}}
			}
			{
				\bool_lazy_or_p:nn
					{\tl_if_empty_p:N \l__pgfgo_sgf_slot_tl}
					{
						\int_compare_p:nNn {\int_use:c {g__pgfgo_sgf_##1_count_int}}
							> {\int_use:c {g__pgfgo_sgf_ \l__pgfgo_sgf_slot_tl _count_int}}
					}
			}
		}{
			\__pgfgo_sgf_if_marked_conflict:cTF {g__pgfgo_sgf_##1_numbered_prop}
				{} {\tl_set:Nn \l__pgfgo_sgf_slot_tl {##1}}
		}
	}
}

%VUELVE A LA COPIA #1.
\cs_new_protected:Npn \__pgfgo_sgf_restore:n #1 {
	\int_set_eq:Nc \l__pgfgo_sgf_count_int {g__pgfgo_sgf_#1_count_int}
	\int_set_eq:Nc \l__pgfgo_sgf_number_int {g__pgfgo_sgf_#1_number_int}
	\int_set_eq:Nc \l__pgfgo_sgf_shift_int {g__pgfgo_sgf_#1_shift_int}
	\int_set_eq:Nc \l__pgfgo_sgf_start_int {g__pgfgo_sgf_#1_index_int}
	\seq_set_eq:Nc \l_pgfgo_kernel_captured_seq {g__pgfgo_sgf_#1_captured_seq}
	\seq_gset_eq:Nc \g_pgfgo_move_notes_seq {g__pgfgo_sgf_#1_notes_seq}
	\prop_set_eq:Nc \l__pgfgo_sgf_numbered_prop {g__pgfgo_sgf_#1_numbered_prop}
	\prop_gset_eq:Nc \g__pgfgo_captures_pending_prop {g__pgfgo_sgf_#1_pending_prop}
	\prop_gset_eq:Nc \g__pgfgo_captures_faded_prop {g__pgfgo_sgf_#1_faded_prop}
	\prop_gset_eq:Nc \g__pgfgo_captures_marks_prop {g__pgfgo_sgf_#1_marks_prop}
	\prop_gset_eq:Nc \g_pgfgo_points_prop {g__pgfgo_sgf_#1_points_prop}
	\prop_gset_eq:Nc \g__pgfgo_notes_number_prop {g__pgfgo_sgf_#1_notes_number_prop}
	\prop_gset_eq:Nc \g__pgfgo_notes_code_prop {g__pgfgo_sgf_#1_notes_code_prop}
	\pgfgo_kernel_board_restore:n {sgf-#1}
}
\cs_generate_variant:Nn \__pgfgo_sgf_restore:n {V}

%LA ULTIMA JUGADA QUE SE MUESTRA, Y SUS MARCAS.
\cs_new_protected:Npn \__pgfgo_sgf_last: {
	\__pgfgo_sgf_count_moves:Nn \l__pgfgo_sgf_last_int {\l__pgfgo_sgf_to_int}
	\int_set:Nn \l__pgfgo_sgf_last_int {\int_min:nn {\l__pgfgo_sgf_last_int} {\l__pgfgo_sgf_to_int}}
	\__pgfgo_sgf_marked:
}

%LAS PIEDRAS INICIALES Y LAS JUGADAS, DESDE EL PRINCIPIO O (CON \l__pgfgo_sgf_cache_bool) DESDE UNA COPIA.
%LAS MARCAS SE AVERIGUAN ANTES, PORQUE DECIDEN SI UNA COPIA SIRVE (NO DAN AVISOS).
\cs_new_protected:Npn \__pgfgo_sgf_play: {
	\int_zero:N \l__pgfgo_sgf_count_int
	\int_zero:N \l__pgfgo_sgf_number_int
	\int_zero:N \l__pgfgo_sgf_shift_int
	\tl_clear:N \l__pgfgo_sgf_slot_tl
	%SIN goban/captures LAS PIEDRAS SE DIBUJAN AL JUGARLAS: NO HAY NADA QUE GUARDAR.
	\bool_lazy_and:nnTF {\l__pgfgo_sgf_cache_bool} {\l_pgfgo_goban_captures_bool} {
		\int_set:Nn \l__pgfgo_sgf_start_int {1}
		\int_set:Nn \l__pgfgo_sgf_resume_int {\seq_count:N \l_pgfgo_kernel_sgf_moves_seq + 1}
		\prop_clear:N \l__pgfgo_sgf_numbered_prop
		\bool_set_false:N \l__pgfgo_sgf_outside_bool
		\bool_gset_false:N \g__pgfgo_captures_warned_bool
		\__pgfgo_sgf_context:
		\__pgfgo_sgf_last:
		\__pgfgo_sgf_choose:
		\tl_if_empty:NTF \l__pgfgo_sgf_slot_tl {
			\__pgfgo_sgf_setup_stones:nN {black} \l_pgfgo_kernel_sgf_black_seq
			\__pgfgo_sgf_setup_stones:nN {white} \l_pgfgo_kernel_sgf_white_seq
		}{
			\__pgfgo_sgf_restore:V \l__pgfgo_sgf_slot_tl
		}
		\seq_map_indexed_inline:Nn \l_pgfgo_kernel_sgf_moves_seq {
			\int_compare:nNnF {##1} < {\l__pgfgo_sgf_start_int} {
				\int_set:Nn \l__pgfgo_sgf_index_int {##1}
				\__pgfgo_sgf_event:nnn ##2
			}
		}
		\__pgfgo_sgf_save:nn {b} {\l__pgfgo_sgf_resume_int}
	}{
		\bool_set_false:N \l__pgfgo_sgf_cache_bool
		\__pgfgo_sgf_setup_stones:nN {black} \l_pgfgo_kernel_sgf_black_seq
		\__pgfgo_sgf_setup_stones:nN {white} \l_pgfgo_kernel_sgf_white_seq
		\__pgfgo_sgf_last:
		\seq_map_inline:Nn \l_pgfgo_kernel_sgf_moves_seq {\__pgfgo_sgf_event:nnn ##1}
	}
}

\cs_new_protected:Npn \pgfgo_sgf:nn #1#2 {
	\group_begin:
		\keys_set:nn {pgfgo / sgf} {#1}
		\tl_set:Nn \l__pgfgo_sgf_file_tl {#2}
		\exp_args:NnV \pgfgo_kernel_sgf_read:nn {#2} \l__pgfgo_sgf_variation_tl
		\__pgfgo_sgf_numbering:
		\bool_if:NT \l__pgfgo_sgf_check_size_bool {\__pgfgo_sgf_check_size:n {#2}}
		\__pgfgo_sgf_play:
		%LAS MARCAS, LAS FLECHAS Y LAS VARIANTES DE LA ULTIMA JUGADA.
		\seq_map_inline:Nn \l__pgfgo_sgf_marks_seq {\__pgfgo_sgf_mark:nnnnn ##1}
		\bool_if:NT \l__pgfgo_sgf_marks_bool {
			\pgfgo_kernel_sgf_lines:n {\l__pgfgo_sgf_last_int}
			\seq_map_inline:Nn \l_pgfgo_kernel_sgf_lines_seq {\__pgfgo_sgf_line:nnnnn ##1}
		}
		\seq_map_inline:Nn \l__pgfgo_sgf_variations_seq {\__pgfgo_sgf_variation:nnnn ##1}
		\__pgfgo_sgf_last_mark:
	\group_end:
}

%CON last~mark: LA MARCA DE LA ULTIMA JUGADA QUE SE MUESTRA (NO SI ES UN PASE NI SI EL ARCHIVO MARCA ESE PUNTO).
\cs_new_protected:Npn \__pgfgo_sgf_last_mark: {
	\bool_lazy_and:nnT
		{! \tl_if_empty_p:N \l__pgfgo_sgf_last_mark_tl}
		{\int_compare_p:nNn {\l__pgfgo_sgf_last_int} > {0}}
		{
			\int_zero:N \l_tmpa_int
			\seq_map_inline:Nn \l_pgfgo_kernel_sgf_moves_seq {
				\__pgfgo_sgf_if_move:nnnT ##1 {
					\int_incr:N \l_tmpa_int
					\int_compare:nNnT {\l_tmpa_int} = {\l__pgfgo_sgf_last_int} {
						\__pgfgo_sgf_last_mark:nnn ##1
						\seq_map_break:
					}
				}
			}
		}
}
\cs_new_protected:Npn \__pgfgo_sgf_last_mark:nnn #1#2#3 {
	\tl_if_blank:nF {#2} {
		\__pgfgo_captures_key:nn {#2} {#3}
		\prop_if_in:NVF \g__pgfgo_sgf_marked_prop \l__pgfgo_captures_key_tl {
			\use:e {
				\exp_not:N \__pgfgo_sgf_mark_put:nn
					{#1, \exp_not:V \l__pgfgo_sgf_last_mark_tl} {\exp_not:n {{#2}{#3}}}
			}
		}
	}
}
\cs_generate_variant:Nn \prop_if_in:NnF {NV}

