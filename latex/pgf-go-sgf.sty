%SE USA FUERA DE goban. NECESITA kernel = lua Y \usepackage{animate}.

\int_new:N \l__pgfgo_sgfanim_from_int
\bool_new:N \l__pgfgo_sgfanim_layers_bool
\int_new:N \l__pgfgo_sgfanim_to_int
\tl_new:N \l__pgfgo_sgfanim_fps_tl
\tl_new:N \l__pgfgo_sgfanim_goban_tl
\tl_new:N \l__pgfgo_sgfanim_animate_tl
\tl_new:N \l__pgfgo_sgfanim_last_tl
\bool_new:N \l__pgfgo_sgfanim_numbers_bool
\bool_new:N \l__pgfgo_sgfanim_comments_bool
\dim_new:N \l__pgfgo_sgfanim_comment_height_dim
\tl_new:N \l__pgfgo_sgfanim_comment_font_tl
\tl_new:N \l__pgfgo_sgfanim_file_tl
\tl_new:N \l__pgfgo_sgfanim_size_tl
\seq_new:N \l__pgfgo_sgfanim_moves_seq
