\ExplSyntaxOn

%\sgf[from = <n>, to = <m>]{<archivo>} DIBUJA UNA PARTIDA EN EL goban ACTUAL. SOLO CON kernel = lua.
%LAS PIEDRAS INICIALES (AB, AW) SON PIEDRAS COMO LAS DE \stones. LAS JUGADAS SON COMO LAS DE \moves:
%ANTES DE from SIN NUMERO, DESDE from NUMERADAS, Y DESPUES DE to NO SE JUEGAN. AL TERMINAR, EL NUMERO
%Y EL TURNO QUEDAN LISTOS PARA SEGUIR LA PARTIDA CON \moves.

\int_new:N \l__pgfgo_sgf_from_int
\int_new:N \l__pgfgo_sgf_to_int
\int_new:N \l__pgfgo_sgf_number_int
%LAS ANIMACIONES SOLO COMPRUEBAN EL TAMANO EN EL PRIMER CUADRO.
\bool_new:N \l__pgfgo_sgf_check_size_bool
\bool_set_true:N \l__pgfgo_sgf_check_size_bool

\keys_define:nn {pgfgo / sgf} {
	from		.int_set:N	= \l__pgfgo_sgf_from_int,
	from		.initial:n	= {1},
	to			.int_set:N	= \l__pgfgo_sgf_to_int,
	to			.initial:n	= {\c_max_int},
}

\msg_new:nnn {pgfgo} {sgf-size}
	{The~game~in~'#1'~is~for~a~#2~board,~but~the~goban~is~#3.}
\cs_generate_variant:Nn \msg_warning:nnnnn {nnnee}


%PIEDRAS INICIALES. #1: black O white. #2: LISTA DE {x}{y}.
\cs_new_protected:Npn \__pgfgo_sgf_stones:nn #1#2 {
	\tl_if_blank:nF {#2} {
		\bool_if:NT \l_pgfgo_goban_remember_stone_bool
			{\pgfgo_kernel_remember_push:n {\exp_not:N \pgfgo_stones_parsed:nn {#1} {\exp_not:n {#2}}}}
		\pgfgo_stones_parsed:nn {#1} {#2}
	}
}
\cs_generate_variant:Nn \__pgfgo_sgf_stones:nn {nV}


%UNA JUGADA DE #1 (black O white) EN (#2,#3). x E y VACIOS: PASE.
\cs_new_protected:Npn \__pgfgo_sgf_move:nnn #1#2#3 {
	\int_incr:N \l__pgfgo_sgf_number_int
	\int_compare:nNnTF {\l__pgfgo_sgf_number_int} > {\l__pgfgo_sgf_to_int} {
		\seq_map_break:
	}{
		\pgfgo_kernel_move_set_number:n {\l__pgfgo_sgf_number_int}
		\pgfgo_kernel_move_set_player:n {#1}
		\tl_if_blank:nTF {#2} {
			%UN PASE CUENTA, PERO NO SE DIBUJA.
			\pgfgo_kernel_move_set_number:n {\l__pgfgo_sgf_number_int + 1}
			\pgfgo_kernel_move_set_player:n {\str_if_eq:nnTF {#1} {black} {white} {black}}
		}{
			\bool_if:NT \l_pgfgo_goban_remember_move_bool {
				\pgfgo_kernel_remember_push:n {
					\exp_not:N \pgfgo_move_parsed:nnn
						{
							\bool_if:nTF {
								\int_compare_p:nNn {\l__pgfgo_sgf_number_int} < {\l__pgfgo_sgf_from_int} ||
								! \l_pgfgo_goban_remember_move_label_bool
							} {\exp_not:N \BooleanFalse} {\exp_not:N \BooleanTrue}
						}
						{from = \int_use:N \l__pgfgo_sgf_number_int, #1}
						{{#2}{#3}}
				}
			}
			\int_compare:nNnTF {\l__pgfgo_sgf_number_int} < {\l__pgfgo_sgf_from_int}
				{\pgfgo_move:nnnn {\BooleanFalse} {} {#2} {#3}}
				{\pgfgo_move:nnnn {\BooleanTrue} {} {#2} {#3}}
		}
	}
}


\cs_new_protected:Npn \pgfgo_sgf:nn #1#2 {
	\group_begin:
		\keys_set:nn {pgfgo / sgf} {#1}
		\pgfgo_kernel_sgf_read:n {#2}

		\bool_if:nF {
			! \l__pgfgo_sgf_check_size_bool ||
			(\int_compare_p:nNn {\l_pgfgo_kernel_sgf_size_x_int} = {\l_pgfgo_goban_size_x_int} &&
			\int_compare_p:nNn {\l_pgfgo_kernel_sgf_size_y_int} = {\l_pgfgo_goban_size_y_int})
		}{
			\msg_warning:nnnee {pgfgo} {sgf-size} {#2}
				{\int_use:N \l_pgfgo_kernel_sgf_size_x_int x \int_use:N \l_pgfgo_kernel_sgf_size_y_int}
				{\int_use:N \l_pgfgo_goban_size_x_int x \int_use:N \l_pgfgo_goban_size_y_int}
		}

		\clist_set_from_seq:NN \l_tmpa_clist \l_pgfgo_kernel_sgf_black_seq
		\__pgfgo_sgf_stones:nV {black} \l_tmpa_clist
		\clist_set_from_seq:NN \l_tmpa_clist \l_pgfgo_kernel_sgf_white_seq
		\__pgfgo_sgf_stones:nV {white} \l_tmpa_clist

		\int_zero:N \l__pgfgo_sgf_number_int
		\seq_map_inline:Nn \l_pgfgo_kernel_sgf_moves_seq {\__pgfgo_sgf_move:nnn ##1}
	\group_end:
}

%\sgf SOLO EXISTE DENTRO DE goban (VER pgf-go-goban.sty).
\NewDocumentCommand{\__pgfgo_sgf_command}{O{}m}{
	\pgfgo_kernel_if_feature:nTF {sgf}
		{\pgfgo_sgf:nn {#1} {#2}}
		{\pgfgo_kernel_require:n {sgf}}
}


