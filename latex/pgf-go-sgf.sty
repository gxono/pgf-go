	comment~font		.initial:n	= {\small},
	%COMO EN \sgf.
	variation				.tl_set:N		= \l__pgfgo_sgfanim_variation_tl,
	marks						.bool_set:N	= \l__pgfgo_sgfanim_marks_bool,
