	from						.initial:n	= {0},
	%-1: LA ULTIMA JUGADA.
	to							.int_set:N	= \l__pgfgo_sgfanim_to_int,
	to							.initial:n	= {-1},
	fps							.tl_set:N		= \l__pgfgo_sgfanim_fps_tl,
	fps							.initial:n	= {1},
