%LEE EL COMENTARIO DE LA JUGADA #1 DE LA ULTIMA PARTIDA LEIDA (0: EL DE ANTES DE LA PRIMERA JUGADA), PARA
%PREGUNTAR SI TIENE (\__pgfgo_sgf_if_comment:nT) Y ESCRIBIRLO (\__pgfgo_sgf_comment_use:) SIN VOLVER A PEDIRLO.
\cs_new_protected:Npn \__pgfgo_sgf_comment_get:n #1 {
	\seq_clear:N \l__pgfgo_sgf_note_seq
	\bool_set_false:N \l__pgfgo_sgf_annotated_bool
	\bool_if:NT \l__pgfgo_sgf_annotations_bool {
		\pgfgo_kernel_sgf_annotations:n {#1}
		\seq_if_empty:NF \l_pgfgo_kernel_sgf_annotations_seq {
			\bool_set_true:N \l__pgfgo_sgf_annotated_bool
			\seq_map_inline:Nn \l_pgfgo_kernel_sgf_annotations_seq {\__pgfgo_sgf_note:nn ##1}
		}
	}
	\tl_set:Ne \l__pgfgo_sgf_comment_tl {\pgfgo_kernel_sgf_comment:n {#1}}
}
\cs_new_protected:Npn \__pgfgo_sgf_comment_use: {
	\seq_if_empty:NF \l__pgfgo_sgf_note_seq {
		\seq_use:Nn \l__pgfgo_sgf_note_seq {.~}.
		\tl_if_blank:VF \l__pgfgo_sgf_comment_tl {~}
	}
	\tl_use:N \l__pgfgo_sgf_comment_tl
}

%ESCRIBE EL COMENTARIO DE LA JUGADA #1 DE LA ULTIMA PARTIDA LEIDA.
\cs_new_protected:Npn \pgfgo_sgf_comment:n #1 {
	\__pgfgo_sgf_comment_get:n {#1}
	\__pgfgo_sgf_comment_use:
}

%VERDADERO SI LA JUGADA #1 TIENE COMENTARIO O ANOTACIONES. DEJA EL COMENTARIO LISTO PARA
%\__pgfgo_sgf_comment_use:.
\prg_new_protected_conditional:Npnn \__pgfgo_sgf_if_comment:n #1 {T} {
	\__pgfgo_sgf_comment_get:n {#1}
	\bool_lazy_or:nnTF
		{\l__pgfgo_sgf_annotated_bool}
		{! \tl_if_blank_p:V \l__pgfgo_sgf_comment_tl}
		{\prg_return_true:} {\prg_return_false:}
}

