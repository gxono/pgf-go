	animate					.tl_set:N		= \l__pgfgo_sgfanim_animate_tl,
	animate					.initial:n	= {controls},
	numbers					.bool_set:N	= \l__pgfgo_sgfanim_numbers_bool,
	numbers					.default:n	= {true},
	%OPCIONES DE LA MARCA DE LA ULTIMA JUGADA (SIN numbers). false: SIN MARCA.
	last~mark				.code:n			= {
															\str_if_eq:nnTF {#1} {false}
																{\tl_clear:N \l__pgfgo_sgfanim_last_tl}
																{\tl_set:Nn \l__pgfgo_sgfanim_last_tl {#1}}
														},
