\ProvidesFile{pgf-go-coordinate-parser.sty}[2026/10/13 v0.2026.10.13 pgf-go: coordinate parser]
\ExplSyntaxOn

%PARTE DEL KERNEL expl3 (LO CARGA pgf-go-kernel-expl3.sty). EL RESTO DEL PAQUETE USA \pgfgo_kernel_points:n.
%
%SINTAXIS. L ES UNA LETRA MAYUSCULA Y N UN NUMERO DE UNA O DOS CIFRAS. LOS RANGOS INCLUYEN LOS DOS
%EXTREMOS, EN CUALQUIER ORDEN; SE RECORRE COLUMNA POR COLUMNA Y CADA COLUMNA DE ABAJO HACIA ARRIBA.
%	*				TODA LA PARTE VISIBLE DEL TABLERO.
%	LN				UNA INTERSECCION (C3).
%	L O N			UNA COLUMNA O UNA FILA DE LA PARTE VISIBLE (C, 3).
%	L:L O N:N		VARIAS COLUMNAS O FILAS DE LA PARTE VISIBLE (A:C, 3:5).
%	L:L N O L N:N O L:L N:N	UN TRAMO DE FILA, DE COLUMNA O UN RECTANGULO (A:C 3, C 1:3, A:B 1:2).
%	LN -| LN		JOTA: PRIMERO HORIZONTAL Y DESPUES VERTICAL.
%	LN |- LN		GAMMA: PRIMERO VERTICAL Y DESPUES HORIZONTAL.
%	LN -- LN		LINEA HORIZONTAL O VERTICAL (SI ES DIAGONAL, AVISO diagonal-line).
%	LN :--: LN		LINEA EN CUALQUIER DIRECCION: UNA PIEDRA POR FILA (O POR COLUMNA, SI AVANZA MAS DE LO
%				QUE SUBE), LA MAS CERCANA A LA RECTA ENTRE LOS DOS EXTREMOS.
%	LN :-|: LN		ESA LINEA, Y EN CADA ESCALON LA ESQUINA DE -| (PRIMERO HORIZONTAL): UNA ESCALERA.
%	LN :|-: LN		LO MISMO CON LA ESQUINA DE |- (PRIMERO VERTICAL).
%	LN r LN			RECTANGULO HUECO.
%	LN R LN			RECTANGULO RELLENO.
%	L[...] O [...]N O [...][...]	LISTAS DE LETRAS O NUMEROS (Y RANGOS) ENTRE CORCHETES (A[1,3:4], [B,D]2, [A:B][4:5]).
%LOS OPERADORES SE ENCADENAN: A1 -| C3 -- E3 ES A1 -| C3, C3 -- E3. LAS COMAS SEPARAN SUBCONJUNTOS QUE SE
%SUMAN; LOS CORCHETES SE PROCESAN DESPUES DE LOS DEMAS. LOS ; SEPARAN GRUPOS QUE SE SUMAN Y SE RESTAN
%ALTERNADAMENTE: EN A1 R E5; C3, 1; C1 SE SUMA EL RECTANGULO, SE RESTAN C3 Y LA FILA 1 Y SE SUMA C1.


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%RESULTADO: CONJUNTO ORDENADO DE INTERSECCIONES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%CADA INTERSECCION {x}{y} OCUPA LA CASILLA \__pgfgo_coordinate_slot_<i>: Y \__pgfgo_coordinate_seen_{x}{y}:
%GUARDA SU NUMERO i. ASI AGREGAR Y QUITAR NO RECORRE LO QUE YA ESTA. TODO ES LOCAL AL GRUPO DE
%\__pgfgo_coordinate_points:nN, ASI QUE NO HACE FALTA BORRARLO.
\int_new:N \l__pgfgo_coordinate_count_int
\bool_new:N \l__pgfgo_coordinate_subtract_bool
\tl_new:N \l__pgfgo_coordinate_items_tl

%AGREGA (O QUITA, EN UN GRUPO QUE RESTA) LA INTERSECCION (#1,#2). LOS ARGUMENTOS SE EXPANDEN CON e.
\cs_new_protected:Npn \__pgfgo_coordinate_put:nn #1#2 {
	\bool_if:NTF \l__pgfgo_coordinate_subtract_bool
		{\__pgfgo_coordinate_remove:e}
		{\__pgfgo_coordinate_add:e}
	{{#1}{#2}}
}
\cs_new_protected:Npn \__pgfgo_coordinate_add:n #1 {
	\cs_if_exist:cF {__pgfgo_coordinate_seen_ \tl_to_str:n {#1} :} {
		\int_incr:N \l__pgfgo_coordinate_count_int
		\cs_set:cpe {__pgfgo_coordinate_seen_ \tl_to_str:n {#1} :} {\int_use:N \l__pgfgo_coordinate_count_int}
		\cs_set:cpn {__pgfgo_coordinate_slot_ \int_use:N \l__pgfgo_coordinate_count_int :} {#1}
	}
}
\cs_new_protected:Npn \__pgfgo_coordinate_remove:n #1 {
	\cs_if_exist:cT {__pgfgo_coordinate_seen_ \tl_to_str:n {#1} :} {
		\cs_set:cpn {__pgfgo_coordinate_slot_ \use:c {__pgfgo_coordinate_seen_ \tl_to_str:n {#1} :} :} {}
		\cs_set_eq:cN {__pgfgo_coordinate_seen_ \tl_to_str:n {#1} :} \scan_stop:
	}
}
\cs_generate_variant:Nn \__pgfgo_coordinate_add:n {e}
\cs_generate_variant:Nn \__pgfgo_coordinate_remove:n {e}

%LA CASILLA #1 COMO ITEM DE UNA clist (VACIO SI SE QUITO).
\cs_new:Npn \__pgfgo_coordinate_slot:n #1 {\exp_not:v {__pgfgo_coordinate_slot_ #1 :} ,}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%GENERADORES
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%NUMERO DE LA COLUMNA DE LA LETRA #1. SIN use i, I Y J SON LA 9.
\cs_new:Npn \__pgfgo_coordinate_column:n #1 {
	\int_eval:n {`#1 - `A + 1 \bool_if:NF \l_pgfgo_use_i_bool {\int_compare:nNnT {`#1} > {`I} {- 1}}}
}
\cs_generate_variant:Nn \__pgfgo_coordinate_column:n {e}

\int_new:N \l__pgfgo_coordinate_a_int
\int_new:N \l__pgfgo_coordinate_b_int
%COLUMNAS DE LAS LETRAS #1 Y #2.
\cs_new_protected:Npn \__pgfgo_coordinate_columns:nn #1#2 {
	\int_set:Nn \l__pgfgo_coordinate_a_int {\__pgfgo_coordinate_column:n {#1}}
	\int_set:Nn \l__pgfgo_coordinate_b_int {\__pgfgo_coordinate_column:n {#2}}
}

%RECTANGULO DE LAS COLUMNAS #1 A #2 Y LAS FILAS #3 A #4, COLUMNA POR COLUMNA.
\cs_new_protected:Npn \__pgfgo_coordinate_rectangle:nnnn #1#2#3#4 {
	\int_step_inline:nnn {\int_min:nn {#1} {#2}} {\int_max:nn {#1} {#2}} {
		\int_step_inline:nnn {\int_min:nn {#3} {#4}} {\int_max:nn {#3} {#4}}
			{\__pgfgo_coordinate_put:nn {##1} {####1}}
	}
}
%LAS COLUMNAS #1 A #2 DE LA FILA #3 (#3 QUEDA COMO ESTA ESCRITA).
\cs_new_protected:Npn \__pgfgo_coordinate_row:nnn #1#2#3 {
	\int_step_inline:nnn {\int_min:nn {#1} {#2}} {\int_max:nn {#1} {#2}}
		{\__pgfgo_coordinate_put:nn {##1} {#3}}
}

%UNA FUNCION POR FORMA. RECIBEN LOS GRUPOS DE SU EXPRESION REGULAR.
%*
\cs_new_protected:Npn \__pgfgo_coordinate_all: {
	\__pgfgo_coordinate_rectangle:nnnn
		{\l_pgfgo_goban_from_x_int} {\l_pgfgo_goban_to_x_int} {\l_pgfgo_goban_from_y_int} {\l_pgfgo_goban_to_y_int}
}
%C3
\cs_new_protected:Npn \__pgfgo_coordinate_LN:nn #1#2 {
	\__pgfgo_coordinate_put:nn {\__pgfgo_coordinate_column:n {#1}} {#2}
}
%C
\cs_new_protected:Npn \__pgfgo_coordinate_L:n #1 {
	\__pgfgo_coordinate_LL:nn {#1} {#1}
}
%3
\cs_new_protected:Npn \__pgfgo_coordinate_N:n #1 {
	\__pgfgo_coordinate_row:nnn {\l_pgfgo_goban_from_x_int} {\l_pgfgo_goban_to_x_int} {#1}
}
%A:C
\cs_new_protected:Npn \__pgfgo_coordinate_LL:nn #1#2 {
	\__pgfgo_coordinate_columns:nn {#1} {#2}
	\__pgfgo_coordinate_rectangle:nnnn {\l__pgfgo_coordinate_a_int} {\l__pgfgo_coordinate_b_int}
		{\l_pgfgo_goban_from_y_int} {\l_pgfgo_goban_to_y_int}
}
%3:5
\cs_new_protected:Npn \__pgfgo_coordinate_NN:nn #1#2 {
	\__pgfgo_coordinate_rectangle:nnnn {\l_pgfgo_goban_from_x_int} {\l_pgfgo_goban_to_x_int} {#1} {#2}
}
%A:C 3
\cs_new_protected:Npn \__pgfgo_coordinate_LLN:nnn #1#2#3 {
	\__pgfgo_coordinate_columns:nn {#1} {#2}
	\__pgfgo_coordinate_row:nnn {\l__pgfgo_coordinate_a_int} {\l__pgfgo_coordinate_b_int} {#3}
}
%C 1:3
\cs_new_protected:Npn \__pgfgo_coordinate_LNN:nnn #1#2#3 {
	\__pgfgo_coordinate_LLNN:nnnn {#1} {#1} {#2} {#3}
}
%A:B 1:2 Y A1 R B2
\cs_new_protected:Npn \__pgfgo_coordinate_LLNN:nnnn #1#2#3#4 {
	\__pgfgo_coordinate_columns:nn {#1} {#2}
	\__pgfgo_coordinate_rectangle:nnnn {\l__pgfgo_coordinate_a_int} {\l__pgfgo_coordinate_b_int} {#3} {#4}
}
\cs_new_protected:Npn \__pgfgo_coordinate_filled:nnnn #1#2#3#4 {
	\__pgfgo_coordinate_LLNN:nnnn {#1} {#3} {#2} {#4}
}
%A1 -| C3
\cs_new_protected:Npn \__pgfgo_coordinate_jota:nnnn #1#2#3#4 {
	\__pgfgo_coordinate_columns:nn {#1} {#3}
	\__pgfgo_coordinate_row:nnn {\l__pgfgo_coordinate_a_int} {\l__pgfgo_coordinate_b_int} {#2}
	\__pgfgo_coordinate_rectangle:nnnn {\l__pgfgo_coordinate_b_int} {\l__pgfgo_coordinate_b_int} {#2} {#4}
}
%A1 |- C3
\cs_new_protected:Npn \__pgfgo_coordinate_gamma:nnnn #1#2#3#4 {
	\__pgfgo_coordinate_columns:nn {#1} {#3}
	\__pgfgo_coordinate_rectangle:nnnn {\l__pgfgo_coordinate_a_int} {\l__pgfgo_coordinate_a_int} {#2} {#4}
	\__pgfgo_coordinate_row:nnn {\l__pgfgo_coordinate_a_int} {\l__pgfgo_coordinate_b_int} {#4}
}
%A2 -- E2: HORIZONTAL SI LAS FILAS SON IGUALES; SI NO, VERTICAL SI LAS COLUMNAS SON IGUALES.
\cs_new_protected:Npn \__pgfgo_coordinate_line:nnnn #1#2#3#4 {
	\__pgfgo_coordinate_columns:nn {#1} {#3}
	\int_compare:nNnTF {#2} = {#4}
		{\__pgfgo_coordinate_row:nnn {\l__pgfgo_coordinate_a_int} {\l__pgfgo_coordinate_b_int} {#2}}
		{
			\int_compare:nNnTF {\l__pgfgo_coordinate_a_int} = {\l__pgfgo_coordinate_b_int}
				{\__pgfgo_coordinate_rectangle:nnnn {\l__pgfgo_coordinate_a_int} {\l__pgfgo_coordinate_a_int} {#2} {#4}}
				{\msg_warning:nnn {pgfgo} {diagonal-line} {#1#2~--~#3#4}}
		}
}
%A1 :--: E6, A1 :-|: E6 Y A1 :|-: E6 (#1: --, -| O |-). LAS PIEDRAS VAN EN EL ORDEN DEL CAMINO, DE LA
%PRIMERA A LA SEGUNDA. EL EJE LARGO AVANZA DE A UNA; EN EL CORTO, LA POSICION MAS CERCANA A LA RECTA. SI LA
%RECTA PASA JUSTO ENTRE DOS, GANA LA DEL LADO DEL EXTREMO MAS CERCANO, Y EN EL MEDIO EXACTO, LA MENOR: ASI LA
%LINEA NO DEPENDE DEL ORDEN DE LOS EXTREMOS Y ES SIMETRICA. LA MISMA CUENTA ESTA EN pgf-go.lua.
\int_new:N \l__pgfgo_coordinate_x_int
\int_new:N \l__pgfgo_coordinate_y_int
\int_new:N \l__pgfgo_coordinate_px_int
\int_new:N \l__pgfgo_coordinate_py_int
\int_new:N \l__pgfgo_coordinate_dx_int
\int_new:N \l__pgfgo_coordinate_dy_int
\int_new:N \l__pgfgo_coordinate_steps_int
\int_new:N \l__pgfgo_coordinate_base_int
\int_new:N \l__pgfgo_coordinate_rest_int
\cs_new_protected:Npn \__pgfgo_coordinate_stairs:nnnnn #1#2#3#4#5 {
	\__pgfgo_coordinate_columns:nn {#2} {#4}
	\int_set:Nn \l__pgfgo_coordinate_dx_int {\l__pgfgo_coordinate_b_int - \l__pgfgo_coordinate_a_int}
	\int_set:Nn \l__pgfgo_coordinate_dy_int {#5 - #3}
	\int_set:Nn \l__pgfgo_coordinate_steps_int
		{\int_max:nn {\int_abs:n {\l__pgfgo_coordinate_dx_int}} {\int_abs:n {\l__pgfgo_coordinate_dy_int}}}
	\int_compare:nNnTF {\l__pgfgo_coordinate_steps_int} = {0}
		{\__pgfgo_coordinate_put:nn {\int_use:N \l__pgfgo_coordinate_a_int} {\int_eval:n {#3}}}
		{
			\int_step_inline:nnn {0} {\l__pgfgo_coordinate_steps_int} {
				\int_compare:nNnTF {\int_abs:n {\l__pgfgo_coordinate_dy_int}} < {\int_abs:n {\l__pgfgo_coordinate_dx_int}}
					{
						\int_set:Nn \l__pgfgo_coordinate_x_int
							{\l__pgfgo_coordinate_a_int + \int_sign:n {\l__pgfgo_coordinate_dx_int} * ##1}
						\__pgfgo_coordinate_offset:nn {\l__pgfgo_coordinate_dy_int} {##1}
						\int_set:Nn \l__pgfgo_coordinate_y_int
							{#3 + \int_sign:n {\l__pgfgo_coordinate_dy_int} * \l__pgfgo_coordinate_base_int}
					}
					{
						\int_set:Nn \l__pgfgo_coordinate_y_int {#3 + \int_sign:n {\l__pgfgo_coordinate_dy_int} * ##1}
						\__pgfgo_coordinate_offset:nn {\l__pgfgo_coordinate_dx_int} {##1}
						\int_set:Nn \l__pgfgo_coordinate_x_int
							{\l__pgfgo_coordinate_a_int + \int_sign:n {\l__pgfgo_coordinate_dx_int} * \l__pgfgo_coordinate_base_int}
					}
				%EN UN ESCALON (CAMBIAN LAS DOS), LA ESQUINA DE -| O DE |- VA ANTES.
				\bool_lazy_all:nT
					{
						{\int_compare_p:nNn {##1} > {0}}
						{\int_compare_p:n {\l__pgfgo_coordinate_x_int != \l__pgfgo_coordinate_px_int}}
						{\int_compare_p:n {\l__pgfgo_coordinate_y_int != \l__pgfgo_coordinate_py_int}}
					}
					{
						\str_case:nn {#1} {
							{-|} {\__pgfgo_coordinate_put:nn
								{\int_use:N \l__pgfgo_coordinate_x_int} {\int_use:N \l__pgfgo_coordinate_py_int}}
							{|-} {\__pgfgo_coordinate_put:nn
								{\int_use:N \l__pgfgo_coordinate_px_int} {\int_use:N \l__pgfgo_coordinate_y_int}}
						}
					}
				\__pgfgo_coordinate_put:nn {\int_use:N \l__pgfgo_coordinate_x_int} {\int_use:N \l__pgfgo_coordinate_y_int}
				\int_set_eq:NN \l__pgfgo_coordinate_px_int \l__pgfgo_coordinate_x_int
				\int_set_eq:NN \l__pgfgo_coordinate_py_int \l__pgfgo_coordinate_y_int
			}
		}
}
%CON LOS GRUPOS DE SU EXPRESION REGULAR: L1, N1, OPERADOR, L2, N2.
\cs_new_protected:Npn \__pgfgo_coordinate_stairs_match:nnnnn #1#2#3#4#5 {
	\__pgfgo_coordinate_stairs:nnnnn {#3} {#1} {#2} {#4} {#5}
}
%DEJA EN \l__pgfgo_coordinate_base_int CUANTO SE CORRIO EL EJE CORTO (QUE AVANZA #1 EN TOTAL) EN EL PASO #2
%DE \l__pgfgo_coordinate_steps_int: |#1| * #2 / PASOS, REDONDEADO (LOS EMPATES COMO SE DICE ARRIBA).
\cs_new_protected:Npn \__pgfgo_coordinate_offset:nn #1#2 {
	\int_set:Nn \l__pgfgo_coordinate_base_int
		{\int_div_truncate:nn {\int_abs:n {#1} * (#2)} {\l__pgfgo_coordinate_steps_int}}
	\int_set:Nn \l__pgfgo_coordinate_rest_int
		{2 * (\int_abs:n {#1} * (#2) - \l__pgfgo_coordinate_base_int * \l__pgfgo_coordinate_steps_int)}
	\int_compare:nNnTF {\l__pgfgo_coordinate_rest_int} = {\l__pgfgo_coordinate_steps_int}
		{
			\int_compare:nNnTF {2 * (#2)} = {\l__pgfgo_coordinate_steps_int}
				{\int_compare:nNnT {#1} < {0} {\int_incr:N \l__pgfgo_coordinate_base_int}}
				{
					\int_compare:nNnT {2 * (#2)} > {\l__pgfgo_coordinate_steps_int}
						{\int_incr:N \l__pgfgo_coordinate_base_int}
				}
		}
		{
			\int_compare:nNnT {\l__pgfgo_coordinate_rest_int} > {\l__pgfgo_coordinate_steps_int}
				{\int_incr:N \l__pgfgo_coordinate_base_int}
		}
}

%B1 r D3: CADA COLUMNA DA SUS DOS PUNTOS (ABAJO Y ARRIBA) Y DESPUES CADA FILA LOS SUYOS (IZQUIERDA Y DERECHA).
\cs_new_protected:Npn \__pgfgo_coordinate_frame:nnnn #1#2#3#4 {
	\__pgfgo_coordinate_columns:nn {#1} {#3}
	\int_step_inline:nnn
		{\int_min:nn {\l__pgfgo_coordinate_a_int} {\l__pgfgo_coordinate_b_int}}
		{\int_max:nn {\l__pgfgo_coordinate_a_int} {\l__pgfgo_coordinate_b_int}}
		{
			\__pgfgo_coordinate_put:nn {##1} {#2}
			\__pgfgo_coordinate_put:nn {##1} {#4}
		}
	\int_step_inline:nnn {\int_min:nn {#2} {#4}} {\int_max:nn {#2} {#4}} {
		\__pgfgo_coordinate_put:nn {\int_use:N \l__pgfgo_coordinate_a_int} {##1}
		\__pgfgo_coordinate_put:nn {\int_use:N \l__pgfgo_coordinate_b_int} {##1}
	}
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%SUBCONJUNTOS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%NO HAY ESPACIOS AL PRINCIPIO Y AL FINAL PORQUE SE ELIMINAN AL SEPARAR LA clist.
\regex_const:Nn \c__pgfgo_coordinate_all_regex 		{\A*\Z}
\regex_const:Nn \c__pgfgo_coordinate_LN_regex 		{\A([A-Z]{1})(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_L_regex 		{\A([A-Z]{1})\Z}
\regex_const:Nn \c__pgfgo_coordinate_N_regex 		{\A(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_LL_regex 		{\A([A-Z]{1}):([A-Z]{1})\Z}
\regex_const:Nn \c__pgfgo_coordinate_NN_regex 		{\A(\d{1,2}):(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_LLN_regex 		{\A([A-Z]{1}):([A-Z]{1})\s*(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_LNN_regex 		{\A([A-Z]{1})\s*(\d{1,2}):(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_LLNN_regex 	{\A([A-Z]{1}):([A-Z]{1})\s*(\d{1,2}):(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_jota_regex 	{\A([A-Z]{1})(\d{1,2})\s*-\|\s*([A-Z]{1})(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_gamma_regex 	{\A([A-Z]{1})(\d{1,2})\s*\|-\s*([A-Z]{1})(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_line_regex 	{\A([A-Z]{1})(\d{1,2})\s*--\s*([A-Z]{1})(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_stairs_regex 	{\A([A-Z]{1})(\d{1,2})\s*:(--|-\||\|-):\s*([A-Z]{1})(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_frame_regex 	{\A([A-Z]{1})(\d{1,2})\s*r\s*([A-Z]{1})(\d{1,2})\Z}
\regex_const:Nn \c__pgfgo_coordinate_filled_regex 	{\A([A-Z]{1})(\d{1,2})\s*R\s*([A-Z]{1})(\d{1,2})\Z}

\tl_new:N \l__pgfgo_coordinate_subset_tl
\seq_new:N \l__pgfgo_coordinate_match_seq
\tl_new:N \l__pgfgo_coordinate_match_tl

%LAS FORMAS SE EXCLUYEN ENTRE SI, ASI QUE SOLO SE PRUEBAN LAS QUE PUEDEN COINCIDIR: LAS QUE TIENEN : (RANGOS)
%O LAS DEMAS. SE PRUEBAN EN ORDEN Y LA PRIMERA QUE COINCIDE CORTA CON \prg_break:.
\cs_new_protected:Npn \__pgfgo_coordinate_subset:n #1 {
	\tl_set:Ne \l__pgfgo_coordinate_subset_tl {#1}
	\str_if_in:NnTF \l__pgfgo_coordinate_subset_tl {:} {
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_stairs_regex \__pgfgo_coordinate_stairs_match:nnnnn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_LLN_regex \__pgfgo_coordinate_LLN:nnn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_LNN_regex \__pgfgo_coordinate_LNN:nnn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_LLNN_regex \__pgfgo_coordinate_LLNN:nnnn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_LL_regex \__pgfgo_coordinate_LL:nn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_NN_regex \__pgfgo_coordinate_NN:nn
	}{
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_LN_regex \__pgfgo_coordinate_LN:nn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_jota_regex \__pgfgo_coordinate_jota:nnnn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_gamma_regex \__pgfgo_coordinate_gamma:nnnn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_line_regex \__pgfgo_coordinate_line:nnnn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_filled_regex \__pgfgo_coordinate_filled:nnnn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_frame_regex \__pgfgo_coordinate_frame:nnnn
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_L_regex \__pgfgo_coordinate_L:n
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_N_regex \__pgfgo_coordinate_N:n
		\__pgfgo_coordinate_try:NN \c__pgfgo_coordinate_all_regex \__pgfgo_coordinate_all:
	}
	\tl_if_blank:VF \l__pgfgo_coordinate_subset_tl
		{\msg_warning:nnV {pgfgo} {unknown-coordinate} \l__pgfgo_coordinate_subset_tl}
	\prg_break_point:
}

%SI EL SUBCONJUNTO COINCIDE CON LA EXPRESION #1, LLAMA A #2 CON SUS GRUPOS Y TERMINA.
\cs_new_protected:Npn \__pgfgo_coordinate_try:NN #1#2 {
	\regex_extract_once:NVNT #1 \l__pgfgo_coordinate_subset_tl \l__pgfgo_coordinate_match_seq {
		\seq_pop_left:NN \l__pgfgo_coordinate_match_seq \l__pgfgo_coordinate_match_tl
		\use:e {\exp_not:N #2 \seq_map_function:NN \l__pgfgo_coordinate_match_seq \__pgfgo_coordinate_brace:n}
		\prg_break:
	}
}
\cs_new:Npn \__pgfgo_coordinate_brace:n #1 {{\exp_not:n {#1}}}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%GRUPOS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%UN OPERADOR ENTRE DOS PUNTOS SE SEPARA DEL SIGUIENTE: A2 -| A3 -| A5 -- B2 ES A2 -| A3, A3 -| A5, A5 -- B2.
%LOS DE LA ESCALERA (:--:, :-|:, :|-:) VAN PRIMERO, ASI SU -- NO SE TOMA SOLO.
\regex_const:Nn \c__pgfgo_coordinate_chain_regex {
	( :--: | :\|-: | :-\|: | -- | \|- | -\| | r | R) \s* (\w+\d+) \s* ( :--: | :\|-: | :-\|: | -- | \|- | -\| | r | R)
}

%CORCHETES: [...][...], L[...] Y [...]N.
\regex_const:Nn \c__pgfgo_coordinate_brackets_both_regex {\[([^\]]*)\]\[([^\]]*)\]}
\regex_const:Nn \c__pgfgo_coordinate_brackets_numbers_regex {([A-Z]{1})\[([^\]]*)\]}
\regex_const:Nn \c__pgfgo_coordinate_brackets_letters_regex {\[([^\]]*)\](\d{1,2})}

\tl_new:N \l__pgfgo_coordinate_group_tl
\seq_new:N \l__pgfgo_coordinate_subsets_seq
\seq_new:N \l__pgfgo_coordinate_brackets_seq

\cs_new_protected:Npn \__pgfgo_coordinate_group:n #1 {
	\tl_set:Nn \l__pgfgo_coordinate_group_tl {#1}
	%TODOS LOS OPERADORES TIENEN UN - O UNA r O UNA R.
	\str_if_in:NnTF \l__pgfgo_coordinate_group_tl {-} {\__pgfgo_coordinate_chains:} {
		\str_if_in:NnTF \l__pgfgo_coordinate_group_tl {r} {\__pgfgo_coordinate_chains:} {
			\str_if_in:NnT \l__pgfgo_coordinate_group_tl {R} {\__pgfgo_coordinate_chains:}
		}
	}
	%LOS CORCHETES TIENEN COMAS: SE SACAN ANTES DE SEPARAR LA clist Y SE PROCESAN AL FINAL.
	\seq_clear:N \l__pgfgo_coordinate_brackets_seq
	\str_if_in:NnT \l__pgfgo_coordinate_group_tl {[} {
		\__pgfgo_coordinate_brackets:Nn \c__pgfgo_coordinate_brackets_both_regex {
			\clist_map_inline:nn {##1} {
				\clist_map_inline:nn {##2} {\seq_put_right:Ne \l__pgfgo_coordinate_brackets_seq {####1 ########1}}
			}
		}
		\__pgfgo_coordinate_brackets:Nn \c__pgfgo_coordinate_brackets_numbers_regex {
			\clist_map_inline:nn {##2} {\seq_put_right:Ne \l__pgfgo_coordinate_brackets_seq {##1 ####1}}
		}
		\__pgfgo_coordinate_brackets:Nn \c__pgfgo_coordinate_brackets_letters_regex {
			\clist_map_inline:nn {##1} {\seq_put_right:Ne \l__pgfgo_coordinate_brackets_seq {####1 ##2}}
		}
	}
	\seq_set_from_clist:NV \l__pgfgo_coordinate_subsets_seq \l__pgfgo_coordinate_group_tl
	\seq_concat:NNN \l__pgfgo_coordinate_subsets_seq \l__pgfgo_coordinate_subsets_seq \l__pgfgo_coordinate_brackets_seq
	\seq_map_function:NN \l__pgfgo_coordinate_subsets_seq \__pgfgo_coordinate_subset:n
}
\cs_generate_variant:Nn \seq_set_from_clist:Nn {NV}

\cs_new_protected:Npn \__pgfgo_coordinate_chains: {
	\regex_replace_all:NnNT \c__pgfgo_coordinate_chain_regex {\1\ \2,\ \2\ \3}
		\l__pgfgo_coordinate_group_tl {\__pgfgo_coordinate_chains:}
}

%SACA DEL GRUPO LAS COINCIDENCIAS DE #1 Y EJECUTA #2 CON LOS DOS GRUPOS DE CADA UNA COMO #1 Y #2.
\tl_new:N \l__pgfgo_coordinate_a_tl
\tl_new:N \l__pgfgo_coordinate_b_tl
\cs_new_protected:Npn \__pgfgo_coordinate_brackets:Nn #1#2 {
	\cs_set_protected:Npn \__pgfgo_coordinate_bracket:nn ##1##2 {#2}
	\regex_extract_all:NVN #1 \l__pgfgo_coordinate_group_tl \l__pgfgo_coordinate_match_seq
	\regex_replace_all:NnN #1 {} \l__pgfgo_coordinate_group_tl
	\bool_until_do:nn {\seq_if_empty_p:N \l__pgfgo_coordinate_match_seq} {
		%LA COINCIDENCIA COMPLETA Y SUS DOS GRUPOS.
		\seq_pop_left:NN \l__pgfgo_coordinate_match_seq \l__pgfgo_coordinate_match_tl
		\seq_pop_left:NN \l__pgfgo_coordinate_match_seq \l__pgfgo_coordinate_a_tl
		\seq_pop_left:NN \l__pgfgo_coordinate_match_seq \l__pgfgo_coordinate_b_tl
		\exp_args:NVV \__pgfgo_coordinate_bracket:nn \l__pgfgo_coordinate_a_tl \l__pgfgo_coordinate_b_tl
	}
}
\cs_new_protected:Npn \__pgfgo_coordinate_bracket:nn #1#2 {}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%COORDENADAS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%DEJA EN #2 LAS INTERSECCIONES {x}{y} DE LAS COORDENADAS #1, SIN REPETIR.
\seq_new:N \l__pgfgo_coordinate_groups_seq
\cs_new_protected:Npn \__pgfgo_coordinate_points:nN #1#2 {
	\group_begin:
		\int_zero:N \l__pgfgo_coordinate_count_int
		\bool_set_false:N \l__pgfgo_coordinate_subtract_bool
		\seq_set_split:Nnn \l__pgfgo_coordinate_groups_seq {;} {#1}
		\seq_map_inline:Nn \l__pgfgo_coordinate_groups_seq {
			\__pgfgo_coordinate_group:n {##1}
			\bool_set_inverse:N \l__pgfgo_coordinate_subtract_bool
		}
		\tl_set:Ne \l__pgfgo_coordinate_items_tl
			{\int_step_function:nN {\l__pgfgo_coordinate_count_int} \__pgfgo_coordinate_slot:n}
	\exp_args:NNNV \group_end:
	\seq_set_from_clist:Nn #2 \l__pgfgo_coordinate_items_tl
}

